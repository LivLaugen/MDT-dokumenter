definition
	ITEM_TREE[at0000] occurrences matches {0..*} matches {    -- Vedtak ikke tph
		items cardinality matches {0..*; unordered} matches {
			allow_archetype CLUSTER[at0011] occurrences matches {0..*} matches {    -- Vedtakstype
				include
					archetype_id/value matches {/openEHR-EHR-CLUSTER\.vedtakstype(-[a-zA-Z0-9_]+)*\.v1/}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- Pasientens ankomst til institusjonen
				value matches {
					DV_DATE matches {*}
				}
			}
			CLUSTER[at0003] occurrences matches {0..1} matches {    -- Registrer oppstartstidspunkt av tvungen observasjon
				items cardinality matches {1..*; unordered} matches {
					ELEMENT[at0004] occurrences matches {0..1} matches {    -- Oppstart av tvungen observasjon
						value matches {
							DV_DATE matches {*}
						}
					}
				}
			}
			CLUSTER[at0013] occurrences matches {0..1} matches {    -- Uttalerett og klageadgang
				items cardinality matches {1..*; unordered} matches {
					allow_archetype CLUSTER[at0010] occurrences matches {0..1} matches {    -- Uttalerett og klageadgang
						include
							archetype_id/value matches {/openEHR-EHR-CLUSTER\.uttalerett_og_klageadgang(-[a-zA-Z0-9_]+)*\.v1/}
					}
				}
			}
			CLUSTER[at0012] occurrences matches {0..1} matches {    -- Faglig ansvarlig
				items cardinality matches {1..*; unordered} matches {
					allow_archetype CLUSTER[at0005] occurrences matches {0..1} matches {    -- Faglig ansvarlig
						include
							archetype_id/value matches {/openEHR-EHR-CLUSTER\.faglig_ansvarlig(-[a-zA-Z0-9_]+)*\.v1/}
					}
				}
			}
		}
	}

