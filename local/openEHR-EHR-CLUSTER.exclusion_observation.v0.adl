description
	original_author = <
		["date"] = <"2016-04-12">
		["name"] = <"John Tore Valand">
		["organisation"] = <"Helse Bergen HF">
		["email"] = <"john.tore.valand@helse-bergen.no">
	>
	lifecycle_state = <"in_development">
	other_contributors = <"Vebjørn Arntzen, Oslo Universitetssykehus, Norway (Nasjonal IKT redaktør)","Silje Ljosland Bakke, Nasjonal IKT HF, Norway (Nasjonal IKT redaktør)","John Tore Valand, Haukeland Universitetssjukehus, Norway (Nasjonal IKT redaktør)">
	details = <
		["nb"] = <
			language = <[ISO_639-1::nb]>
			purpose = <"For å registrere et eksplisitt utsagn om at en klinisk observasjon ikke ble gjennomført.">
			keywords = <"eksklusjon","ikke utført","ikke gjennomført">
			copyright = <"© Nasjonal IKT HF">
			use = <"Brukes for å registrere et eksplisitt utsagn om at en klinisk observasjon ikke ble gjennomført. Det er i tillegg ett valgfritt felt for å registrere årsak til at observasjonen ikke ble utført.

Denne arketypen er laget for å tillate registrering av at \"ingen observasjon ble utført\". Arketypen skal alltid brukes i en arketype som gir kontekst til hvilken observasjon det er snakk om. For eksempel om man bruker denne arketypen i arketypen OBSERVATION.cgas (Children's Global Assessment Scale) i SLOTet \"Skåring ikke utført\" tillater arketypen en registrering av at ingen skåring ble utført.

Arketypen er utviklet for å unngå bruk av flagg eller terminologi for å uttrykke negasjon ved registrering av en fysisk i undersøkelse i pasientjournalen.">
			misuse = <"Brukes ikke for å registrere et eksplisitt utsagn om at en fysisk undersøkelse eller en spesifisert del av en fysisk undersøkelse ikke ble gjennomført. Bruk CLUSTER.exclusion_exam for dette formålet.

Brukes ikke for å registrere eksklusjon eller fravær av overfølsomhetsreaksjoner, familieanamnese, legemiddelbruk, prosedyrer, problemer eller diagnoser etc. Bruk spesifikke EVALUATION-arketyper for dette formålet.
">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record a positive statement that a clinical observation was not performed.">
			keywords = <"exclusion","not done","not performed">
			copyright = <"© Nasjonal IKT HF">
			use = <"Use to record a positive statement that a clinical observation was not performed, with an optional statement about the reason for the non-performance.

This archetype has been designed to be used to allow recording of 'Observation not done'. It will never be used as a stand-alone archetype but always inside an archetype that provides the context for observation being performed. For example, insertion of this archetype into the 'Scoring not performed' SLOT within OBSERVATION.cgas allows for recording that no scoring was performed. 

In particular, this archetype has specifically been designed to avoid the need to use flags or terminology to express negation about a record of an observation within the health record.">
			misuse = <"Not to be used to record a positive statement that the physical examination, or a specified part of the physical examination, was not performed. Use cluster.exclusion_exam for this purpose.

Not to be used to record the exclusion or absence of adverse reactions, family history, medication use, procedures, problems or diagnoses in the subject etc - use specific specialisations of this archetype for this purpose.">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"Nasjonal IKT">
		["original_namespace"] = <"no.nasjonalikt">
		["original_publisher"] = <"Nasjonal IKT">
		["custodian_namespace"] = <"no.nasjonalikt">
		["MD5-CAM-1.0.1"] = <"69592EFA9C4D6C7F3E3C8F9E5BAEC57A">
		["build_uid"] = <"d95d24b9-88c4-42dc-976e-1ffa56cd3ece">
		["revision"] = <"0.0.1-alpha">
	>

definition
	CLUSTER[at0000] matches {    -- Exclusion of an observation
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Observation not done
				value matches {
					DV_BOOLEAN matches {
						value matches {true}
					}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- Reason
				value matches {
					DV_TEXT matches {*}
				}
			}
		}
	}

ontology
	term_definitions = <
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"Eksklusjon av en observasjon">
					description = <"Eksplisitt utsagn for å registrere at en observasjon ikke ble gjennomført.">
				>
				["at0001"] = <
					text = <"Observasjon ikke utført">
					description = <"Utsagn for å eksplisitt registrere at en undersøkelse ikke ble utført.">
					comment = <"Registrer som Sann om undersøkelsen ikke ble utført.">
				>
				["at0002"] = <
					text = <"Årsak">
					description = <"Årsak for utsagnet \"ikke utført\".">
					comment = <"For eksempel: faktorer knyttet til pasient, utstyr eller tidsbegrensninger.">
				>
			>
		>
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Exclusion of an observation">
					description = <"Positive statement to record that an observation was not performed.">
				>
				["at0001"] = <
					text = <"Observation not done">
					description = <"Statement to explicity record that the observation was not performed.">
					comment = <"Record as True if the observation was not performed.">
				>
				["at0002"] = <
					text = <"Reason">
					description = <"Reason for the 'not done' statement.">
					comment = <"For example: patient factors, equipment factors, time constraints.">
				>
			>
		>
	>
