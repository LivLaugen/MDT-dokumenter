definition
	OBSERVATION[at0000] matches {    -- Interpretation
		data matches {
			HISTORY[at0001] matches {    -- Event Series
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..1} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0004] occurrences matches {0..1} matches {    -- Interpreter present
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0005,    -- Yes
													at0006]    -- No
												}
											}
										}
									}
									CLUSTER[at0007] occurrences matches {0..1} matches {    -- Professional interpreter
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at0008] occurrences matches {0..1} matches {    -- Qualification
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0010,    -- Professional interpreter without certification
															at0011]    -- Professional interpreter with certification
														}
													}
												}
											}
											ELEMENT[at0009] occurrences matches {0..1} matches {    -- Grading of the qualification
												value matches {
													DV_TEXT matches {*}
												}
											}
										}
									}
									ELEMENT[at0012] occurrences matches {0..1} matches {    -- Non professional interpretor
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0013,    -- Family
													at0014,    -- Employee
													at0015,    -- Volunteer
													at0016]    -- Friend
												}
											}
										}
									}
									ELEMENT[at0017] occurrences matches {0..1} matches {    -- Conflict of interest
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0018,    -- Party of interest
													at0019,    -- Related to any of the parties
													at0020,    -- Married or engaged to any of the parties
													at0021]    -- Social officer or guardian for any of the parties
												}
											}
										}
									}
									allow_archetype CLUSTER[at0022] occurrences matches {0..*} matches {    -- Details
										include
											archetype_id/value matches {/openEHR-EHR-CLUSTER\.interpreter_details(-[a-zA-Z0-9_]+)*\.v0/}
									}
									ELEMENT[at0023] occurrences matches {0..1} matches {    -- Comment
										value matches {
											DV_TEXT matches {*}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Interpretation">
					description = <"Details about the interpreter that was involved in a clinical activity.">
				>
				["at0001"] = <
					text = <"Event Series">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Any event">
					description = <"Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"Interpreter present">
					description = <"Was an interpreter present during a clinical activity?">
				>
				["at0005"] = <
					text = <"Yes">
					description = <"An interpretator was present during the clinical activity.">
				>
				["at0006"] = <
					text = <"No">
					description = <"An interpretator was not present during the clinical activity.">
				>
				["at0007"] = <
					text = <"Professional interpreter">
					description = <"*">
				>
				["at0008"] = <
					text = <"Qualification">
					description = <"*">
				>
				["at0009"] = <
					text = <"Grading of the qualification">
					description = <"A Norwegian national grading in a national registry for interpreters. Grade 1 - 5">
				>
				["at0010"] = <
					text = <"Professional interpreter without certification">
					description = <"*">
				>
				["at0011"] = <
					text = <"Professional interpreter with certification">
					description = <"*">
				>
				["at0012"] = <
					text = <"Non professional interpretor">
					description = <"*">
				>
				["at0013"] = <
					text = <"Family">
					description = <"*">
				>
				["at0014"] = <
					text = <"Employee">
					description = <"Employee in the organization where the interpretation takes place, for example a nurse at the hospital.">
				>
				["at0015"] = <
					text = <"Volunteer">
					description = <"*">
				>
				["at0016"] = <
					text = <"Friend">
					description = <"A friend of the individual">
				>
				["at0017"] = <
					text = <"Conflict of interest">
					description = <"*(en)">
				>
				["at0018"] = <
					text = <"Party of interest">
					description = <"*">
				>
				["at0019"] = <
					text = <"Related to any of the parties">
					description = <"*">
				>
				["at0020"] = <
					text = <"Married or engaged to any of the parties">
					description = <"*">
				>
				["at0021"] = <
					text = <"Social officer or guardian for any of the parties">
					description = <"*">
				>
				["at0022"] = <
					text = <"Details">
					description = <"Additional structured details about the interpreter.">
				>
				["at0023"] = <
					text = <"Comment">
					description = <"Additional narrative description about the interpreter.">
				>
			>
		>
	>
