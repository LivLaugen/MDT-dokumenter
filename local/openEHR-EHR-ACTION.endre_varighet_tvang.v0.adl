definition
	ACTION[at0000] matches {    -- Endre varighet tvang
		ism_transition matches {
			ISM_TRANSITION[at0001] matches {    -- Varighet registrert
				current_state matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[openehr::532]
						}
					}
				}
				careflow_step matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::at0001]    -- Varighet registrert
						}
					}
				}
			}
		}
		description matches {
			allow_archetype ITEM_TREE matches {
				include
					archetype_id/value matches {/openEHR-EHR-ITEM_TREE\.varighet_tvang(-[a-zA-Z0-9_]+)*\.v1/}
			}
		}
	}

