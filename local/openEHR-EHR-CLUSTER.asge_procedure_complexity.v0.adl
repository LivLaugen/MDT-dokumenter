	details = <
		["nb"] = <
			language = <[ISO_639-1::nb]>
			purpose = <"Beskriver prosedyrekompleksitet ved endoskopisk retrograd choleangio-pancreaticografi (ERCP) som definert av American Society for Gastrointestinal Endoscopy i 2011.">
			keywords = <"ERCP","kompleksitet">
			copyright = <"© Nasjonal IKT HF">
			use = <"Brukes med arketypen ACTION.procedure for å beskrive prosedyren nærmere">
			misuse = <"All annen">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"Describes the procedural complexity of endoscopic retrograde choleangio pancreaticography (ERCP) as defined by the American Society for Gastrointenstinal Endoscopy in 2011">
			keywords = <"ERCP","complexity">
			copyright = <"© Nasjonal IKT HF">
			use = <"Use with ACTION.procedure to describe the details of the ERCP procedure">
			misuse = <"All other">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"Nasjonal IKT">
		["references"] = <"Cotton PB, Eisen G, Romagnuolo J, et al. Grading the complexity of endoscopic procedures: results of an ASGE working party. Gastrointest ENdosc 2011;73:868-74">
		["current_contact"] = <"Tomas Nordheim Alme, DIPS ASA, tna@dips.no">
