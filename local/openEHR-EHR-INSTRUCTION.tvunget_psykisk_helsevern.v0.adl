definition
	INSTRUCTION[at0000] matches {    -- Tvunget psykisk helsevern
		activities cardinality matches {0..*; unordered} matches {
			ACTIVITY[at0001] matches {    -- Varighet
				action_archetype_id matches {/openEHR-EHR-ACTION\.endre_varighet_tvang\.v1/}
				description matches {
					allow_archetype ITEM_TREE matches {
						include
							archetype_id/value matches {/openEHR-EHR-ITEM_TREE\.varighet_tvang(-[a-zA-Z0-9_]+)*\.v1/}
					}
				}
			}
			ACTIVITY[at0003] matches {    -- Ansvarlig
				action_archetype_id matches {/openEHR-EHR-ACTION\.endre_ansvarlig_tvang\.v1/}
				description matches {
					allow_archetype ITEM_TREE matches {
						include
							archetype_id/value matches {/openEHR-EHR-ITEM_TREE\.ansvarlig_tvang(-[a-zA-Z0-9_]+)*\.v1/}
					}
				}
			}
			ACTIVITY[at0005] matches {    -- Tvangsform og institusjon
				action_archetype_id matches {/openEHR-EHR-ACTION\.tvangsform_institusjon\.v1/}
				description matches {
					allow_archetype ITEM_TREE matches {
						include
							archetype_id/value matches {/openEHR-EHR-ITEM_TREE\.tvangsform_institusjon(-[a-zA-Z0-9_]+)*\.v1/}
					}
				}
			}
		}
	}

