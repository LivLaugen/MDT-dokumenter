archetype (adl_version=1.4; uid=36b9eb48-cb01-4b1f-921a-a2975b226734)
	openEHR-EHR-CLUSTER.pi_rads.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::nb]>
	translations = <
		["en"] = <
			language = <[ISO_639-1::en]>
			author = <
				["name"] = <"Bjørn Næss">
				["organisation"] = <"DIPS AS">
