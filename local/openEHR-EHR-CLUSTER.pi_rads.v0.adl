description
	original_author = <
		["date"] = <"2022-03-01">
		["name"] = <"Bjørn Næss">
		["organisation"] = <"DIPS AS">
		["email"] = <"bna@dips.no">
	>
	lifecycle_state = <"in_development">
	other_contributors = <"Martine Louise Nalum <mana@dips.no>", ...>
	details = <
		["nb"] = <
			language = <[ISO_639-1::nb]>
			purpose = <"For å forbedre tidlig diagnose og behandling av prostatakreft, dannet ACR, AdMeTech Foundation og ESUR en felles innsats for å utvikle standarder for Prostata Imaging Reporting and Data System (PI-RADS®).

Målet er å fremskynde overføringen av høykvalitets MR fra laboratorier til pasienter for å bidra til å forbedre tidlig diagnose av klinisk signifikant prostatakreft og redusere unødvendige biopsier og behandling for benigne og subkliniske sykdommer.">
			copyright = <"© Nasjonal IKT HF">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"*For å forbedre tidlig diagnose og behandling av prostatakreft, dannet ACR, AdMeTech Foundation og ESUR en felles innsats for å utvikle standarder for Prostata Imaging Reporting and Data System (PI-RADS®).

Målet er å fremskynde overføringen av høykvalitets MR fra laboratorier til pasienter for å bidra til å forbedre tidlig diagnose av klinisk signifikant prostatakreft og redusere unødvendige biopsier og behandling for benigne og subkliniske sykdommer. (nb)">
			copyright = <"© Nasjonal IKT HF">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"Nasjonal IKT">
		["references"] = <"American College of Radiology ,
https://www.acr.org/Clinical-Resources/Reporting-and-Data-Systems/PI-RADS">
		["original_namespace"] = <"no.nasjonalikt">
		["original_publisher"] = <"Nasjonal IKT">
		["custodian_namespace"] = <"no.nasjonalikt">
		["MD5-CAM-1.0.1"] = <"CC506C96D17BAC131F58382ADBCEE8B8">
		["build_uid"] = <"b155ae32-8f6b-4238-a202-ea5d55d30e0f">
		["revision"] = <"0.0.1-alpha">
	>

definition
	CLUSTER[at0000] matches {    -- PI-RADS
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- PI-RADS
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0003,    -- 1
							at0004,    -- 2
							at0005,    -- 3
							at0006,    -- 4
							at0007,    -- 5
							at0009]    -- Ukjent
						}
					}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- Kommentar
				value matches {
					DV_TEXT matches {*}
				}
			}
		}
	}

ontology
	term_definitions = <
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"PI-RADS">
					description = <"PI-RADS (Prostate Imaging-Reporting and Data System) brukes av radiologer for å evaluere hvor sannsynlig det er at et mistenkelig område er klinisk signifikant kreft. PI-RADS rangeres fra 1 (mest sannsynlig ikke kreft) til 5 (svært mistenkelig). ">
				>
				["at0001"] = <
					text = <"PI-RADS">
					description = <"*">
				>
				["at0002"] = <
					text = <"Kommentar">
					description = <"*">
				>
				["at0003"] = <
					text = <"1">
					description = <"Svært lav (klinisk signifikant kreft er svært usannsynlig å være tilstede)">
				>
				["at0004"] = <
					text = <"2">
					description = <"Lav (klinisk signifikant kreft er usannsynlig å være tilstede)">
				>
				["at0005"] = <
					text = <"3">
					description = <"Middels (tilstedeværelsen av klinisk signifikant kreft er tvetydig)">
				>
				["at0006"] = <
					text = <"4">
					description = <"Høy (klinisk signifikant kreft er sannsynligvis tilstede)">
				>
				["at0007"] = <
					text = <"5">
					description = <"Svært høy (klinisk signifikant kreft er høyst sannsynlig tilstede)">
				>
				["at0009"] = <
					text = <"Ukjent">
					description = <"*">
				>
			>
		>
		["en"] = <
			items = <
				["at0000"] = <
					text = <"PI-RADS">
					description = <"PI-RADS (Prostate Imaging-Reporting and Data System) is used by radiologists to evaluate how likely it is that a suspicious area is clinically significant cancer. PI-RADS is rated from 1 (most likely not cancer) to 5 (very suspicious).">
				>
				["at0001"] = <
					text = <"PI-RADS">
					description = <"*">
				>
				["at0002"] = <
					text = <"Comment">
					description = <"*">
				>
				["at0003"] = <
					text = <"1">
					description = <"Very low (clinically significant cancer is very unlikely to be present)">
				>
				["at0004"] = <
					text = <"2">
					description = <"Low (clinically significant cancer is unlikely to be present)">
				>
				["at0005"] = <
					text = <"3">
					description = <"Moderate (the presence of clinically significant cancer is ambiguous)">
				>
				["at0006"] = <
					text = <"4">
					description = <"High (clinically significant cancer is likely to be present)">
				>
				["at0007"] = <
					text = <"5">
					description = <"Very high (clinically significant cancer is most likely present)">
				>
				["at0009"] = <
					text = <"Unknown">
					description = <"*">
				>
			>
		>
	>
