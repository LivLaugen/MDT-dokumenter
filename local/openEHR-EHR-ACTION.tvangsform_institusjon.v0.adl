definition
	ACTION[at0000] matches {    -- Tvangsform og institusjon
		ism_transition matches {
			ISM_TRANSITION[at0002] matches {    -- Tvungen observasjon
				current_state matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[openehr::245]
						}
					}
				}
				careflow_step matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::at0002]    -- Tvungen observasjon
						}
					}
				}
			}
			ISM_TRANSITION[at0004] matches {    -- Tvungent psykisk helsevern
				current_state matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[openehr::245]
						}
					}
				}
				careflow_step matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::at0004]    -- Tvungent psykisk helsevern
						}
					}
				}
			}
			ISM_TRANSITION[at0003] matches {    -- Opphørt
				current_state matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[openehr::532]
						}
					}
				}
				careflow_step matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::at0003]    -- Opphørt
						}
					}
				}
			}
		}
		description matches {
			allow_archetype ITEM_TREE matches {
				include
					archetype_id/value matches {/openEHR-EHR-ITEM_TREE\.tvangsform_institusjon(-[a-zA-Z0-9_]+)*\.v1/}
			}
		}
	}

