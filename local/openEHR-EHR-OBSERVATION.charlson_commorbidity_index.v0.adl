archetype (adl_version=1.4; uid=313e1b24-dc41-48d1-8e99-0dcf136a9aa1)
	openEHR-EHR-OBSERVATION.charlson_commorbidity_index.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::nb]>
	translations = <
		["en"] = <
			language = <[ISO_639-1::en]>
			author = <
				["name"] = <"Liv Laugen">
