					description = <"">
				>
				["at0071"] = <
					text = <"Ja">
					description = <"">
				>
				["at0072"] = <
					text = <"CCI totalscore">
					description = <"Summen av poeng på hver enkelt parameter i Charlson Comorbidity Index.

">
				>
				["at0073"] = <
					text = <"Estimert10 års overlevelse">
					description = <"">
				>
				["at0074"] = <
					text = <"CLUSTER_SLOT">
					description = <"">
				>
			>
		>
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Charlson Commorbidity Index (CCI)">
					description = <"A tool to predict the 10-years survival of a patient who may have a range of concurrent sonditions (comorbidities).


">
				>
				["at0001"] = <
					text = <"Event Series">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Any point in time event">
					description = <"Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0006"] = <
					text = <"Peripheral vascular disease">
					description = <"Intermittent claudication or past bypass for chronic arterial insufficiency, history of gangrene or acute arterial insufficiency, or untreated thoracic or abdominal aneurysm (≥6 cm).">
				>
				["at0007"] = <
					text = <"No">
					description = <"">
				>
				["at0008"] = <
					text = <"Yes">
					description = <"">
				>
				["at0009"] = <
					text = <"Congestive heart failure">
					description = <"Exertional or paroxysmal nocturnal dyspnea and has responded to symptomatically (or on physical examination) to digitalis, diuretics, or afterload reducing agents.">
				>
				["at0010"] = <
					text = <"No">
					description = <"">
				>
				["at0011"] = <
					text = <"Yes">
					description = <"">
				>
				["at0012"] = <
					text = <"Myocardial infarction">
					description = <"History of definite or probable Myocardial infarction (EKG changes and/or enzyme changes)">
				>
				["at0013"] = <
					text = <"No">
					description = <"">
				>
				["at0014"] = <
					text = <"Yes">
					description = <"">
				>
				["at0015"] = <
					text = <"Cerebrovascular disease">
					description = <"History of a cerebrovascular accident (CVA) with minor or no residua and transient ischemic attacks (TIA).">
					comment = <"* should we call this Cerebrovascular Accident (CVA) or transient ischemic attack (TIA), name frome mdcalc. ">
				>
				["at0016"] = <
					text = <"No">
					description = <"">
				>
				["at0017"] = <
					text = <"Yes">
					description = <"">
				>
				["at0018"] = <
					text = <"Dementia">
					description = <"Chronic cognitive deficit.">
				>
				["at0019"] = <
					text = <"No">
					description = <"">
				>
				["at0020"] = <
					text = <"Yes">
					description = <"">
				>
				["at0021"] = <
					text = <"Chronic pulmonary disease">
					description = <"Chronic obstructive pulmonary disease (COPD)">
					comment = <"**
Mild: Dyspneic with moderate activity without treatment or  dyspneic only with attacks (e.g. asthma), 
Moderate: dyspneic with slight activity, with or without
treatment and dyspneic with moderate activity despite treatment. 
Severe: dyspneic at rest, despite treatment, require constant oxygen, CO, retention and  a baseline PO, below 50 torr. ">
				>
				["at0022"] = <
					text = <"No">
					description = <"">
				>
				["at0023"] = <
					text = <"Yes">
					description = <"">
				>
				["at0024"] = <
					text = <"Peptic ulcer disease">
					description = <"Any history of treatment for ulcer disease or history of ulcer bleeding.">
				>
				["at0025"] = <
					text = <"No">
					description = <"">
				>
				["at0026"] = <
					text = <"Yes">
					description = <"">
				>
				["at0027"] = <
					text = <"Liver disease">
					description = <"">
				>
				["at0028"] = <
					text = <"None">
					description = <"">
				>
				["at0029"] = <
					text = <"Mild">
					description = <"Cirrhosis without portal hypertension or chronic hepatitis.">
				>
				["at0030"] = <
					text = <"Connective tissue disease">
					description = <"">
					comment = <"*
Rheumatologic disease that includes systemic lupus erythematous, polvmvositis, mixed connective tissue disease, polymyalgia rheumatica, and moderate to severe rheumatoid arthritis.">
				>
				["at0031"] = <
					text = <"No">
					description = <"">
				>
				["at0032"] = <
					text = <"Yes">
					description = <"">
				>
				["at0033"] = <
					text = <"Diabetes mellitus">
					description = <"">
				>
				["at0034"] = <
					text = <"None or diet-controlled">
					description = <"">
				>
				["at0035"] = <
					text = <"Uncomplicated">
					description = <"Diabetes treated with insulin or oral hypoglycemics, but not diet alone">
				>
				["at0036"] = <
					text = <"Hemiplegia">
					description = <"">
					comment = <"*
Includes dense hemiplegia or paraplegia, whether it occurred as a result of a cerebrovascular accident or other condition.">
				>
				["at0037"] = <
					text = <"No">
					description = <"">
				>
				["at0038"] = <
					text = <"Yes">
					description = <"">
				>
				["at0039"] = <
					text = <"Moderate or severe renal diseas">
					description = <"Severe = on dialysis, status post kidney transplant, uremia.
Moderate = creatinine >3 mg/dL (0.27 mmol/L)">
					comment = <"* should we call it the same as MDcalk - Moderate to severe Chronic Kidney Disease (CKD)">
				>
				["at0040"] = <
					text = <"No">
					description = <"">
				>
				["at0041"] = <
					text = <"Yes">
					description = <"">
				>
				["at0045"] = <
					text = <"Solid tumor">
					description = <"">
				>
				["at0046"] = <
					text = <"None">
					description = <"">
				>
				["at0047"] = <
					text = <"Leukemia">
					description = <"">
					comment = <"*
Leukemia includes patients with acute and
chronic myelbgenous leukemia, acute and chronic lymphocytic leukemia, and polycythemia vera.">
				>
				["at0048"] = <
					text = <"Localized">
					description = <"Solid tumors without documented metastases">
				>
				["at0049"] = <
					text = <"No">
					description = <"">
				>
				["at0050"] = <
					text = <"Lymphoma">
					description = <"">
					comment = <"*
Lymphoma includes patients with Hodgkins,
lymphosarcoma, Waldenstrom’s macroglobulinemia, myeloma and other lymphomas.">
				>
				["at0051"] = <
					text = <"Yes">
					description = <"">
				>
				["at0052"] = <
					text = <"No">
					description = <"">
				>
				["at0053"] = <
					text = <"Yes">
					description = <"">
				>
				["at0060"] = <
					text = <"AIDS">
					description = <"">
					comment = <"*
Acquired immune deficiency syndrome includes patients with define or probable AIDS, i.e. AIDS related complex.">
				>
				["at0061"] = <
					text = <"Age">
					description = <"Age of the patient.">
				>
				["at0062"] = <
					text = <"<50 years">
					description = <"">
				>
				["at0063"] = <
					text = <"50–59 years">
					description = <"">
				>
				["at0064"] = <
					text = <"60-69 years">
					description = <"">
				>
				["at0065"] = <
					text = <"70–79 years">
					description = <"">
				>
				["at0066"] = <
					text = <"≥80 years">
					description = <"">
				>
				["at0067"] = <
					text = <"Moderate to severe">
					description = <"Severe: cirrhosis, portal hypertension and a histori of variceal bleeding. Moderate: cirrhosis with portal hipertension, but without bleeding">
				>
				["at0068"] = <
					text = <"End-organ damage">
					description = <"Diabetes with end organ damage">
				>
				["at0069"] = <
					text = <"Metastatic">
					description = <"Metastatic solid tumor">
				>
				["at0070"] = <
					text = <"No">
					description = <"">
				>
				["at0071"] = <
					text = <"Yes">
					description = <"">
				>
				["at0072"] = <
					text = <"CCI total score">
					description = <"The total sum of each component variable for the Charlson Comorbidity Index.">
				>
				["at0073"] = <
					text = <"Estimated 10-year survival">
					description = <"The predicted 10-yars survival.">
				>
				["at0074"] = <
					text = <"Extension SLOT">
					description = <"Additional information required to extend the model with local content or to align with other reference models or formalisms.">
					comment = <"For example: local information requirements; or additional metadata to align with FHIR. ">
