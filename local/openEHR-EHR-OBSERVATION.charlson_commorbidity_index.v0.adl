description
	original_author = <
		["name"] = <"Liv Laugen">
		["organisation"] = <"Oslo universitetssykehus">
		["email"] = <"liv.laugen@ous-hf.no">
	>
	lifecycle_state = <"in_development">
	details = <
		["nb"] = <
			language = <[ISO_639-1::nb]>
			purpose = <"Forutsier 10 års overlevelse hos pasienter med flere komorbiditeter.">
			copyright = <"© Nasjonal IKT HF">
			use = <"Arketypen har suffix dips fordi den tas i bruk før den sendes til høring. ">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the result for each component parameter and their total sum for Charlson Comorbidity Index (CCI) and calculator estimates survival in patients with multiple comorbidities based on CCI.">
			keywords = <"CCI","comorbidity","concurrent conditions","estimated survival","mortality">
			copyright = <"© Nasjonal IKT HF">
			use = <"To record the result for each component parameter and their total sum for Charlson Comorbidity Index (CCI) and calculator estimates survival in patients with multiple comorbidities based on CCI.

">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"Nasjonal IKT">
		["references"] = <"Avgrenet fra:">
		["original_namespace"] = <"no.nasjonalikt">
		["original_publisher"] = <"Nasjonal IKT">
		["custodian_namespace"] = <"no.nasjonalikt">
		["MD5-CAM-1.0.1"] = <"CBDB049D39F860C3591E5F8047A5CD8B">
		["build_uid"] = <"f830bcac-4005-471b-931d-4950f2ecb0c0">
		["revision"] = <"0.0.1-alpha">
	>

definition
	OBSERVATION[at0000] matches {    -- charlson_commorbidity_index
		data matches {
			HISTORY[at0001] matches {    -- Event Series
				events cardinality matches {1..*; unordered} matches {
					POINT_EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0061] occurrences matches {0..1} matches {    -- Alder
										value matches {
											0|[local::at0062],
											1|[local::at0063],
											2|[local::at0064],
											3|[local::at0065],
											4|[local::at0066]
										}
									}
									ELEMENT[at0012] occurrences matches {0..1} matches {    -- Myokardinfarkt
										value matches {
											0|[local::at0013],
											1|[local::at0014]
										}
									}
									ELEMENT[at0009] occurrences matches {0..1} matches {    -- Kronisk hjertesvikt
										value matches {
											0|[local::at0010],
											1|[local::at0011]
										}
									}
									ELEMENT[at0006] occurrences matches {0..1} matches {    -- Perifere vaskulære sykdommer
										value matches {
											0|[local::at0007],
											1|[local::at0008]
										}
									}
									ELEMENT[at0015] occurrences matches {0..1} matches {    -- Cerebrovasklær hendelse eller transitorisk iskemisk anfall
										value matches {
											0|[local::at0016],
											1|[local::at0017]
										}
									}
									ELEMENT[at0018] occurrences matches {0..1} matches {    -- Demens
										value matches {
											0|[local::at0019],
											1|[local::at0020]
										}
									}
									ELEMENT[at0021] occurrences matches {0..1} matches {    -- Kronisk obstruktiv lungesykdom
										value matches {
											0|[local::at0022],
											1|[local::at0023]
										}
									}
									ELEMENT[at0024] occurrences matches {0..1} matches {    -- Magesårsykdom
										value matches {
											0|[local::at0025],
											1|[local::at0026]
										}
									}
									ELEMENT[at0027] occurrences matches {0..1} matches {    -- Leversykdom
										value matches {
											0|[local::at0028],
											1|[local::at0029],
											3|[local::at0067]
										}
									}
									ELEMENT[at0030] occurrences matches {0..1} matches {    -- Bindevevssykdom
										value matches {
											0|[local::at0031],
											1|[local::at0032]
										}
									}
									ELEMENT[at0033] occurrences matches {0..1} matches {    -- Diabetes
										value matches {
											0|[local::at0034],
											1|[local::at0035],
											2|[local::at0068]
										}
									}
									ELEMENT[at0036] occurrences matches {0..1} matches {    -- Hemiplegi
										value matches {
											0|[local::at0037],
											2|[local::at0038]
										}
									}
									ELEMENT[at0039] occurrences matches {0..1} matches {    -- Moderat til alvorlig nyresykdom
										value matches {
											0|[local::at0040],
											2|[local::at0041]
										}
									}
									ELEMENT[at0045] occurrences matches {0..1} matches {    -- Lokalisert solid svulst
										value matches {
											0|[local::at0046],
											2|[local::at0048],
											6|[local::at0069]
										}
									}
									ELEMENT[at0047] occurrences matches {0..1} matches {    -- Leukemi
										value matches {
											0|[local::at0049],
											2|[local::at0051]
										}
									}
									ELEMENT[at0050] occurrences matches {0..1} matches {    -- Lymfom
										value matches {
											0|[local::at0052],
											2|[local::at0053]
										}
									}
									ELEMENT[at0060] occurrences matches {0..1} matches {    -- Aids
										value matches {
											0|[local::at0070],
											6|[local::at0071]
										}
									}
									ELEMENT[at0072] occurrences matches {0..1} matches {    -- CCI totalscore
										value matches {
											DV_COUNT matches {*}
										}
									}
									ELEMENT[at0073] occurrences matches {0..1} matches {    -- Estimert10 års overlevelse
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::380]>
												list = <
													["1"] = <
														units = <"%">
													>
												>
											>
										}
									}
								}
							}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE matches {
				items cardinality matches {0..*; unordered} matches {
					allow_archetype CLUSTER[at0074] occurrences matches {0..*} matches {    -- CLUSTER_SLOT
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
	}

