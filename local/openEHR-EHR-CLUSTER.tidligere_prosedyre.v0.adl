	term_definitions = <
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"Tidligere prosedyre">
					description = <"Beskriver om aktuelle prosedyre har vært gjennomført tidligere for denne pasienten, og evt resultat/erfaring med dette.">
