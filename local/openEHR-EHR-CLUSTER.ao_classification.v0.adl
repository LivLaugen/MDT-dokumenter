archetype (adl_version=1.4; uid=57a0f8ca-7081-4457-ae6b-7dc13ee6252f)
	openEHR-EHR-CLUSTER.ao_classification.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::nb]>

description
	original_author = <
		["date"] = <"2015-10-01">
		["name"] = <"Knut Harboe og Terje Meling">
		["organisation"] = <"Helse Stavanger">
		["email"] = <"knut@harboe.org;terje_meling@yahoo.no">
	>
	lifecycle_state = <"in_development">
	details = <
		["nb"] = <
			language = <[ISO_639-1::nb]>
			purpose = <"For registrering av lokalisasjon og alvorlighetsgrad av brudd i lange rørknokler hos utvokste personer">
			keywords = <"Klassifisering","Brudd">
			copyright = <"© Nasjonal IKT HF">
			use = <"Bruker for dokumentasjon av brudd i databaser, og til bruk for statistisk analyse av forekomst av brudd.
Brukes også for bedre kommunikasjon mellom kolleger for å beskrive brudd.

Forlanger et avbrudd i kontinuitet av knokkel.

Denne arketypen er blitt designet for å brukes innen Cluster-arketypen brudd.">
			misuse = <"Skal ikke primært brukes på barn.">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"Nasjonal IKT">
		["references"] = <"1. https://en.wikipedia.org/wiki/M%C3%BCller_AO_Classification_of_fractures
2. Müller ME, Nazarian S, Koch P (1987). Classification AO des fractures. Tome I. Les os longs. Berlin: Springer-Verlag.">
		["original_namespace"] = <"no.nasjonalikt">
		["original_publisher"] = <"Nasjonal IKT">
		["custodian_namespace"] = <"no.nasjonalikt">
		["MD5-CAM-1.0.1"] = <"E0FC856F00FAAB0D80016A7978FC1390">
		["build_uid"] = <"cf224400-91dd-4f4c-a7f5-9cf911df1d56">
		["revision"] = <"0.0.1-alpha">
	>

definition
	CLUSTER[at0000] matches {    -- AO classification
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- AO Bone
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0007,    -- 1 - Overarm
							at0008,    -- 2 - Underarm
							at0009,    -- 3 - Lår
							at0010]    -- 4 - Legg
						}
					}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- AO Segment
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0011,    -- 1 - Proksimalt
							at0012,    -- 2 - Skaft
							at0013]    -- 3 - Distalt
						}
					}
				}
			}
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- AO Type
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0014,    -- A - Ekstraartikulær i ved leddnære, eller 1 bruddlinje på skaft
							at0015,    -- B - Delvis intraartikulær ved leddnære, eller intermediærfragment på skaft
							at0016]    -- C - Komplett intraartikulær, elle ikke kontakt mellom proksimal og distalfragment på skaftet
						}
					}
				}
			}
			ELEMENT[at0004] occurrences matches {0..1} matches {    -- AO Group
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0017,    -- 1 - Lite alvorlig
							at0018,    -- 2 - Mer alvorlig
							at0019]    -- 3 - Mest alvorlig
						}
					}
				}
			}
			ELEMENT[at0005] occurrences matches {0..1} matches {    -- AO Subgroup
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0006] occurrences matches {0..1} matches {    -- Kommentar
				value matches {
					DV_TEXT matches {*}
				}
			}
		}
	}

ontology
	term_definitions = <
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"AO classification">
					description = <"AO (Arbeidsgemeinschaft für osteosyntesefragen) klassifiseringen beskriver lokalisasjon og alvorlighetsgrad av brudd i lange rørknokler">
				>
				["at0001"] = <
					text = <"AO Bone">
					description = <"Knokkel">
				>
				["at0002"] = <
					text = <"AO Segment">
					description = <"Plassering på knokkel">
				>
				["at0003"] = <
					text = <"AO Type">
					description = <"Grad av alvorlighet. I ledd regnes andel av leddlinje løst fra skaft. På skaftet regnes graden av kontakt mellom proksimal og distalfragment.">
				>
				["at0004"] = <
					text = <"AO Group">
					description = <"Grad av kommunisjon eller ytterligere alvorlighet.">
				>
				["at0005"] = <
					text = <"AO Subgroup">
					description = <"Alle brudd har subgruppe inndeling, men brukes sjeldnere. ">
				>
				["at0006"] = <
					text = <"Kommentar">
					description = <"Fritekst beskrivelse av bruddet">
				>
				["at0007"] = <
					text = <"1 - Overarm">
					description = <"Overarm">
				>
				["at0008"] = <
					text = <"2 - Underarm">
					description = <"Underarm">
				>
				["at0009"] = <
					text = <"3 - Lår">
					description = <"Lår">
				>
				["at0010"] = <
					text = <"4 - Legg">
					description = <"Legg">
				>
				["at0011"] = <
					text = <"1 - Proksimalt">
					description = <"Metafyse proksimalt på knokkel">
				>
				["at0012"] = <
					text = <"2 - Skaft">
					description = <"Midten av knokkel, altså ikke proksimale eller distale metafyse">
				>
				["at0013"] = <
					text = <"3 - Distalt">
					description = <"Distale metafyse">
				>
				["at0014"] = <
					text = <"A - Ekstraartikulær i ved leddnære, eller 1 bruddlinje på skaft">
					description = <"Ingen bruddlinjer inn i leddet, og kun en linje på skaftet">
				>
				["at0015"] = <
					text = <"B - Delvis intraartikulær ved leddnære, eller intermediærfragment på skaft">
					description = <"Deler av leddet har kontakt med skaftet. Intermediærbrudd hvor det etter reposisjon er kontakt mellom hovedfragmenter">
				>
				["at0016"] = <
					text = <"C - Komplett intraartikulær, elle ikke kontakt mellom proksimal og distalfragment på skaftet">
					description = <"Intraartikulært brudd hvor hele leddflaten er løst fra skaft. Komplekse frakturer i skaftet, hvor det ikke er kontakt mellom hovedfragmenter etter reposisjon">
				>
				["at0017"] = <
					text = <"1 - Lite alvorlig">
					description = <"Se bilde og definisjon for hvert enkelt segment">
				>
				["at0018"] = <
					text = <"2 - Mer alvorlig">
					description = <"Se bilde og definisjon for hvert enkelt segment">
				>
				["at0019"] = <
					text = <"3 - Mest alvorlig">
					description = <"Se bilde og definisjon for hvert enkelt segment">
				>
			>
		>
	>
