description
	original_author = <
		["date"] = <"2015-10-30">
		["name"] = <"Arne Løberg Sæter">
		["organisation"] = <"DIPS ASA">
		["email"] = <"asa@dips.no">
	>
	lifecycle_state = <"in_development">
	details = <
		["nb"] = <
			language = <[ISO_639-1::nb]>
			purpose = <"For å markere om en undersøkelse er gjort eller ikke.">
			copyright = <"© Nasjonal IKT HF">
			use = <"Midlertidig arketype som tas i bruk ved Olafiaklinikken november 2015. Det er kommet et annet mønsker for undersøkelsesfunn, der informasjon om at en undersøkelse ikke er gjort ligger i et eget CLUSTER med tilhørende informasjonselementer. Denne arketypen er derfor sannsynlig feil, og skal bare brukes midlertidig.">
			misuse = <"Skal ikke brukes annet sted enn ved Olafiaklinikken, Oslo universitetssykehus inntil en bedre arketype finnes.">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			copyright = <"© Nasjonal IKT HF">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"Nasjonal IKT">
		["original_namespace"] = <"no.nasjonalikt">
		["original_publisher"] = <"Nasjonal IKT">
		["custodian_namespace"] = <"no.nasjonalikt">
		["MD5-CAM-1.0.1"] = <"C07AA747A22B3FB9F40B2947AB37EEAB">
		["build_uid"] = <"810d83c1-2579-4db3-b3eb-ecc6fe2ecb52">
		["revision"] = <"0.0.1-alpha">
	>

definition
	CLUSTER[at0000] matches {    -- Undersøkelsesstatus
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Status
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- Comment
				value matches {
					DV_TEXT matches {*}
				}
			}
		}
	}

ontology
	term_definitions = <
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"Undersøkelsesstatus">
					description = <"Om en undersøkelse er utført eller ikke.">
					comment = <"Helst kodet, f.eks Utført, Ikke utført">
				>
				["at0001"] = <
					text = <"Status">
					description = <"Fortrinnsvis kodet verdi, som Utført, Ikke utført.">
				>
				["at0002"] = <
					text = <"Kommentar">
					description = <"Fritekstlig beskrivelse, tenkt brukt for å begrunne hvorfor en undersøkelse ikke er utført.">
				>
			>
		>
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Undersøkelsesstatus">
					description = <"unknown">
				>
				["at0001"] = <
					text = <"Status">
					description = <"*">
				>
				["at0002"] = <
					text = <"Comment">
					description = <"*">
				>
			>
		>
	>
