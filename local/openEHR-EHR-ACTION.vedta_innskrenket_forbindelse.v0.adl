definition
	ACTION[at0000] matches {    -- Vedta innskrenket forbindelse
		ism_transition matches {
			ISM_TRANSITION[at0002] matches {    -- Pågående
				current_state matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[openehr::245]
						}
					}
				}
				careflow_step matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::at0002]    -- Pågående
						}
					}
				}
			}
			ISM_TRANSITION[at0001] matches {    -- Vedtatt
				current_state matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[openehr::532]
						}
					}
				}
				careflow_step matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::at0001]    -- Vedtatt
						}
					}
				}
			}
		}
		description matches {
			allow_archetype ITEM_TREE matches {
				include
					archetype_id/value matches {/openEHR-EHR-ITEM_TREE\.om_vedtak_innskrenket_forbindelse(-[a-zA-Z0-9_]+)*\.v1/}
			}
		}
	}

