		data matches {
			ITEM_TREE[at0001] matches {    -- Tree
				items cardinality matches {1..1; unordered} matches {
					ELEMENT[at0002] matches {    -- Hovedårsak til utredning
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0003,    -- Symptomer
									at0004,    -- Screening
									at0005,    -- Høyrisikogruppe med kontroll instituert av genetisk avdeling
									at0006]    -- Funn ved utredning av annen sykdom
								}
							}
						}
					}
				}
			}
		}
	}

