														}
													}
													ELEMENT[at0116] occurrences matches {0..1} matches {    -- *New element(nb)
														value matches {
															DV_CODED_TEXT matches {
																defining_code matches {
																	[local::
																	at0117,    -- *Stable(nb)
																	at0118]    -- *Migrating(nb)
																}
															}
														}
													}
												}
											}
											CLUSTER[at0032] occurrences matches {0..1} matches {    -- Headache before exhaustion symptoms started
												items cardinality matches {1..*; unordered} matches {
													ELEMENT[at0119] occurrences matches {0..1} matches {    -- *New element(nb)
														value matches {
															DV_PROPORTION matches {
																numerator matches {|1.0..10.0|}
																is_integral matches {false}
																type matches {0}
															}
														}
													}
													ELEMENT[at0033] occurrences matches {0..1} matches {    -- Regularity
														value matches {
															DV_COUNT matches {
																magnitude matches {|0..30|}
															}
														}
													}
													ELEMENT[at0035] occurrences matches {0..1} matches {    -- Location
														value matches {
															DV_CODED_TEXT matches {
																defining_code matches {
																	[local::
																	at0120,    -- *Forehead(nb)
																	at0121,    -- *Side of forehead(nb)
																	at0122,    -- *Top of head(nb)
																	at0123,    -- *Back of head(nb)
																	at0124,    -- *sinuses(nb)
																	at0125]    -- *Ear region(nb)
																}
															}
														}
													}
													ELEMENT[at0126] occurrences matches {0..1} matches {    -- *New element(nb)
														value matches {
															C_DV_QUANTITY <
																property = <[openehr::128]>
																list = <
																	["1"] = <
																		units = <"h">
																		precision = <|0|>
																	>
																>
															>
														}
													}
												}
											}
											CLUSTER[at0036] occurrences matches {0..1} matches {    -- Headache after exhaustion symptoms started
												items cardinality matches {1..*; unordered} matches {
													ELEMENT[at0133] occurrences matches {0..1} matches {    -- *New element(nb)
														value matches {
															DV_PROPORTION matches {
																numerator matches {|1.0..10.0|}
																is_integral matches {false}
																type matches {0}
															}
														}
													}
													ELEMENT[at0045] occurrences matches {0..1} matches {    -- Regularity
														value matches {
															DV_COUNT matches {
																magnitude matches {|0..30|}
															}
														}
													}
													ELEMENT[at0047] occurrences matches {0..1} matches {    -- Location
														value matches {
															DV_CODED_TEXT matches {
																defining_code matches {
																	[local::
																	at0127,    -- *Forehead(nb)
																	at0128,    -- *Side of forehead(nb)
																	at0129,    -- *Top of head(nb)
																	at0130,    -- *Back of head(nb)
