														}
													}
													ELEMENT[at0113] occurrences matches {0..1} matches {    -- *New element(nb)
														value matches {
															DV_CODED_TEXT matches {
																defining_code matches {
																	[local::
																	at0114,    -- *Stable(nb)
																	at0115]    -- *Migrating(nb)
																}
															}
														}
													}
												}
											}
											CLUSTER[at0111] occurrences matches {0..1} matches {    -- *New cluster(nb)
												items cardinality matches {1..*; unordered} matches {
													ELEMENT[at0112] occurrences matches {0..1} matches {    -- *New element(nb)
														value matches {
															DV_PROPORTION matches {
																numerator matches {|1.0..10.0|}
																is_integral matches {false}
																type matches {0}
															}
														}
													}
													ELEMENT[at0030] occurrences matches {0..1} matches {    -- Location of joint pains
