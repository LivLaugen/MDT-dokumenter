																	>
																>
															>
														}
													}
												}
											}
											CLUSTER[at0048] occurrences matches {0..1} matches {    -- Migrene
												items cardinality matches {1..*; unordered} matches {
													ELEMENT[at0049] occurrences matches {0..1} matches {    -- Aura
														value matches {
