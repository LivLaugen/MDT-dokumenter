definition
	OBSERVATION[at0000] matches {    -- Exhaustion
		data matches {
			HISTORY[at0001] matches {    -- Event Series
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..1} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									CLUSTER[at0005] occurrences matches {0..1} matches {    -- 1. General exhaustion
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at0004] occurrences matches {0..1} matches {    -- Degree
												value matches {
													DV_PROPORTION matches {
														numerator matches {|1.0..10.0|}
														is_integral matches {false}
														type matches {0}
													}
												}
											}
											ELEMENT[at0006] occurrences matches {0..1} matches {    -- Description
												value matches {
													DV_TEXT matches {*}
												}
											}
										}
									}
									CLUSTER[at0007] occurrences matches {0..1} matches {    -- 2. Strained exhaustion
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at0008] occurrences matches {0..1} matches {    -- Degree
												value matches {
													DV_PROPORTION matches {
														numerator matches {|1.0..10.0|}
														type matches {0}
													}
												}
											}
											ELEMENT[at0011] occurrences matches {0..1} matches {    -- Duration
												value matches {
													DV_TEXT matches {*}
												}
											}
											ELEMENT[at0037] occurrences matches {0..1} matches {    -- Delay
												value matches {
													DV_TEXT matches {*}
												}
											}
											ELEMENT[at0012] occurrences matches {0..*} matches {    -- Precipitating factors
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0038,    -- School/university
															at0039,    -- Work
															at0040,    -- social gatherings
															at0041,    -- Restaurants, coffee shops etc
															at0042,    -- Physical activities
															at0043]    -- Phsycological strain
														}
													}
												}
											}
											ELEMENT[at0109] occurrences matches {0..*} matches {    -- *New element(nb)
												value matches {
													DV_TEXT matches {*}
												}
											}
											ELEMENT[at0013] occurrences matches {0..1} matches {    -- Description
												value matches {
													DV_TEXT matches {*}
												}
											}
										}
									}
									CLUSTER[at0014] occurrences matches {0..1} matches {    -- 3. Deprived sleep
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at0015] occurrences matches {0..1} matches {    -- Usual bedtime
												value matches {
													DV_TIME matches {
														value matches {HH:MM:??}
													}
												}
											}
											ELEMENT[at0016] occurrences matches {0..1} matches {    -- Usual wake up time
												value matches {
													DV_TIME matches {
														value matches {HH:MM:??}
													}
												}
											}
											ELEMENT[at0017] occurrences matches {0..1} matches {    -- Variation in sleep length
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0098,    -- *Little(nb)
															at0099,    -- *Some(nb)
															at0100]    -- *Considerable(nb)
														}
													}
												}
											}
											ELEMENT[at0018] occurrences matches {0..1} matches {    -- Tension
												value matches {
													DV_TEXT matches {*}
												}
											}
											ELEMENT[at0019] occurrences matches {0..1} matches {    -- Use of relaxation techniques
												value matches {
													DV_TEXT matches {*}
												}
											}
											ELEMENT[at0020] occurrences matches {0..1} matches {    -- Typical time to gain sleep
												value matches {
													DV_TIME matches {
														value matches {HH:MM:??}
													}
												}
											}
											ELEMENT[at0021] occurrences matches {0..1} matches {    -- Number of wake ups during one nights sleep
												value matches {
													DV_COUNT matches {*}
												}
											}
											ELEMENT[at0022] occurrences matches {0..1} matches {    -- Snoring
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0105,    -- *None(nb)
															at0106,    -- *Some(nb)
															at0107,    -- *Regularly(nb)
															at0108]    -- *Always(nb)
														}
													}
												}
											}
											ELEMENT[at0023] occurrences matches {0..1} matches {    -- Not being able to breathe
												value matches {
													DV_TEXT matches {*}
												}
											}
											ELEMENT[at0024] occurrences matches {0..1} matches {    -- Feeling rested after sleep
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0101,    -- *Always(nb)
															at0102,    -- *usually(nb)
															at0103,    -- *seldom(nb)
															at0104]    -- *never(nb)
														}
													}
												}
											}
											ELEMENT[at0025] occurrences matches {0..1} matches {    -- Description
												value matches {
													DV_TEXT matches {*}
												}
											}
										}
									}
									CLUSTER[at0026] occurrences matches {0..1} matches {    -- 4. Pain
										items cardinality matches {1..*; unordered} matches {
											CLUSTER[at0110] occurrences matches {0..1} matches {    -- *New cluster(nb)
												items cardinality matches {1..*; unordered} matches {
													ELEMENT[at0027] occurrences matches {0..1} matches {    -- Muscle pains
														value matches {
															DV_PROPORTION matches {
																numerator matches {|1.0..10.0|}
																is_integral matches {false}
																type matches {0}
															}
														}
													}
													ELEMENT[at0028] occurrences matches {0..1} matches {    -- Location of muscle pains
														value matches {
