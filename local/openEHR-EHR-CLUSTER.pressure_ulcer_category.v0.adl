definition
	CLUSTER[at0000] matches {    -- Klassifisering av trykksår
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Kategori
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0002,    -- Kategori I
							at0003,    -- Kategori II
							at0004,    -- Kategori III
							at0005]    -- Kategori IV
						}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"Klassifisering av trykksår">
					description = <"Brukes til å registrere klassifisering av trykksår ved hjelp av den internasjonale NPUAP/EPUAP-definisjonen av trykksår.">
				>
				["at0001"] = <
					text = <"Kategori">
					description = <"Klassifisering av trykksår.">
				>
				["at0002"] = <
					text = <"Kategori I">
					description = <"Rødhet (erythem) som ikke blekner ved trykk.">
				>
				["at0003"] = <
					text = <"Kategori II">
					description = <"Delvis tap av dermis.">
				>
				["at0004"] = <
					text = <"Kategori III">
					description = <"Tap av hele hudlaget.">
				>
				["at0005"] = <
					text = <"Kategori IV">
					description = <"Tap av alle vevslag.">
				>
			>
		>
	>
