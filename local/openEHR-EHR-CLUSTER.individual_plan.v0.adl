definition
	CLUSTER[at0000] matches {    -- Individuell plan
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Har pasienten individuell plan?
				value matches {
					DV_BOOLEAN matches {
						value matches {true}
					}
				}
			}
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- Ansvarlig for individuell plan
				value matches {
					DV_TEXT matches {*}
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Individuell plan">
					description = <"Use to document if the patient has an individual plan">
				>
				["at0001"] = <
					text = <"Does the patient have an individuall plan?">
					description = <"">
				>
				["at0003"] = <
					text = <"*Ansvarlig for individuell plan(nb)">
					description = <"*Tilsvarer koordinator(nb)">
				>
			>
		>
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"Individuell plan">
					description = <"Brukes for å dokumentere om pasienten har individuell plan iht forskrift">
				>
				["at0001"] = <
					text = <"Har pasienten individuell plan?">
					description = <"*">
				>
				["at0003"] = <
					text = <"Ansvarlig for individuell plan">
