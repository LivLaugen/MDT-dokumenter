definition
	ACTION[at0000] matches {    -- Informasjon om vedtak
		ism_transition matches {
			ISM_TRANSITION[at0008] matches {    -- Informert
				current_state matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[openehr::532]
						}
					}
				}
				careflow_step matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::at0008]    -- Informert
						}
					}
				}
			}
		}
		description matches {
			ITEM_TREE[at0001] matches {    -- Tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..1} matches {    -- Pasienten er informert om sin klageadgang
						value matches {
							DV_BOOLEAN matches {*}
						}
					}
					ELEMENT[at0003] occurrences matches {0..1} matches {    -- Om informasjon til nærmeste pårørende
						value matches {
							0|[local::at0004],
							1|[local::at0005],
							2|[local::at0006],
							3|[local::at0007]
						}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"Informasjon om vedtak">
					description = <"Dokumentasjon av informering av pasient og pårørende.">
				>
				["at0001"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Pasienten er informert om sin klageadgang">
					description = <"Dokumentasjon av pasientinformasjon om klageadgang.">
				>
				["at0003"] = <
					text = <"Om informasjon til nærmeste pårørende">
					description = <"Dokumentasjon om informasjon til pårørende.">
				>
				["at0004"] = <
					text = <"Nærmeste pårørende informeres om Nærmeste pårørende informeres om vedtaket og sin klageadgang.">
					description = <"">
				>
				["at0005"] = <
					text = <"Nærmeste pårørende informeres ikke da pasienten motsetter seg dette.">
					description = <"">
				>
				["at0006"] = <
					text = <"Nærmeste pårørende informeres ikke da denne ikke har kjent adresse og ettersporing vil kreve urimelig mye tid eller arbeid.">
					description = <"">
				>
				["at0007"] = <
					text = <"Nærmeste pårørende informeres ikke da denne ved tidligere anledning har gitt uttrykk for ikke å ønske informasjon om hvert enkelt vedtak av den aktuelle typen.">
					description = <"">
				>
				["at0008"] = <
					text = <"Informert">
					description = <"">
				>
			>
		>
	>
