definition
	ACTION[at0000] matches {    -- Skjermingsvedtak
		ism_transition matches {
			ISM_TRANSITION[at0004] matches {    -- Skjerming uten vedtak
				current_state matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[openehr::245]
						}
					}
				}
				careflow_step matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::at0004]    -- Skjerming uten vedtak
						}
					}
				}
			}
			ISM_TRANSITION[at0005] matches {    -- Skjerming med vedtak
				current_state matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[openehr::245]
						}
					}
				}
				careflow_step matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::at0005]    -- Skjerming med vedtak
						}
					}
				}
			}
			ISM_TRANSITION[at0006] matches {    -- Skjerming avsluttet
				current_state matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[openehr::532]
						}
					}
				}
				careflow_step matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::at0006]    -- Skjerming avsluttet
						}
					}
				}
			}
		}
		description matches {
			allow_archetype ITEM_TREE matches {
				include
					archetype_id/value matches {/openEHR-EHR-ITEM_TREE\.om_skjermingsvedtak(-[a-zA-Z0-9_]+)*\.v1/}
			}
		}
	}

