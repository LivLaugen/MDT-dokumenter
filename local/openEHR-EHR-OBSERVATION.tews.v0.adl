archetype (adl_version=1.4; uid=824f85b1-cfcf-4dc0-a426-0925b7168c16)
	openEHR-EHR-OBSERVATION.tews.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::nb]>
	translations = <
