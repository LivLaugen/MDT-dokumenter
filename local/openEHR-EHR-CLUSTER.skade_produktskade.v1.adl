definition
	CLUSTER[at0000] matches {    -- Skade produktskade
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Type lekeplass
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0002,    -- 1 - Lekeplass tilknyttet barnehage
							at0003,    -- 2 - Privat lekeplass
							at0004,    -- 3 - Kommunal lekeplass (utenom barnehage)
							at0005,    -- 4 - Legeplass i tilknytning til skole eller skolefritidsordning
							at0006]    -- 9 - Ukjent
						}
					}
				}
			}
			CLUSTER[at0007] occurrences matches {0..1} matches {    -- Produktgruppe/produkt
				items cardinality matches {1..*; unordered} matches {
					ELEMENT[at0008] occurrences matches {0..1} matches {    -- Produkt navn, alder, kjøpested
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0009] occurrences matches {0..1} matches {    -- Produktfeil
						value matches {
							DV_BOOLEAN matches {*}
						}
					}
					ELEMENT[at0010] occurrences matches {0..1} matches {    -- Kodeverdier
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0011,    -- - 1- Sped- og småbarnsutstyr
									at0012,    -- 101 Stellebord
									at0013,    -- 102 Barnestol
									at0014,    -- 103 Barneseng, lekegrind og lignende
									at0015,    -- 104 Barnevogn
									at0016,    -- 105 Gåstol
									at0017,    -- 106 Smokk
									at0018,    -- 107 Bæremeis, bærebag o.l
									at0019,    -- 198 Annet sped- og småbarnsutstyr
									at0020,    -- - 2 - Leketøy
									at0021,    -- 201 Vannleketøy
									at0022,    -- 202 Prosjekttilleketøy
									at0023,    -- 203 Dukker og leketøy med mykt fyll
									at0024,    -- 204 Utkledningsutstyr
									at0025,    -- 298 Annet leketøy
									at0026,    -- 3 - Lekeplassutstyr
									at0027,    -- 301 Huskestativ
									at0028,    -- 302 Sklie
									at0029,    -- 303 Klatrestativ, klatrevegg, o.l
									at0030,    -- 304 Vippe og lignende
									at0031,    -- 398 Annet lekeplassutstyr
									at0032,    -- 4- Tennkilder
									at0033,    -- 401 Levende lys
									at0034,    -- 402 Lighter
									at0035,    -- 403 Fyrstikker
									at0036,    -- 498 Andre tennkilder
									at0037,    -- - 5 - Stiger (bærbare)
									at0038,    -- 501 Gardintrapp
									at0039,    -- 502 Stige
									at0040,    -- 598 Annen stige
									at0041,    -- - 6 - Lek- og sportutstyr
									at0042,    -- 601 Trampoline
									at0043,    -- 602 Sykkel
									at0044,    -- 603 Sparkesykkel
									at0045,    -- 604 Rulleskøyter
									at0046,    -- 605 Baller/ballspill
									at0047,    -- 606 Akebrett
									at0048,    -- 607 Snowboard
									at0049,    -- 608 Alpinski
									at0050,    -- 609 Langrennsski
									at0051,    -- 610 Skøyter
									at0052,    -- 698 Annet lek- og sportsutstyr
									at0053,    -- - 7 - Klær og møbler
									at0054,    -- 701 Klesplagg
									at0055,    -- 702 Møbel (sofa, ,seng, bord o.l)
									at0056,    -- 798 Andre tekstiler og møbler
									at0057,    -- - 8 - Verktøy/maskiner
									at0058,    -- 801 Motorgressklipper
									at0059,    -- 802 Motorsag eller sag
									at0060,    -- 803 Vinkelsliper
									at0061,    -- 804 Øks
									at0062,    -- 805 Kniv
									at0063,    -- 806  Manuelt husholdningsutstyr
									at0064]    -- 898 Annet verktøy/maskiner
								}
							}
						}
					}
				}
			}
			ELEMENT[at0065] occurrences matches {0..1} matches {    -- Skadested på kropp
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0066,    -- 1  Hode, nakke, hals
							at0067,    -- 2 Rygg, skulder
							at0068,    -- 3 Mage, bryst
							at0069,    -- 4 Arm, hånd
							at0070,    -- 5 Legg, lår, fot
							at0071]    -- 9 Ukjent
						}
					}
				}
			}
			ELEMENT[at0072] occurrences matches {0..1} matches {    -- Verne og sikkerhetsutstyr
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0073,    -- 1 Hjelm
							at0074,    -- 2 Briller, hansker, vernesko
							at0075,    -- 3 Albue-, håndledd-, kne-, leggbeskytter
							at0076,    -- 4 Sikkerhetsnett (trampoline)
							at0077,    -- 5 Støtsand/puter
							at0078,    -- 6 Annet verneutstyr
							at0079]    -- 7 Ikke benyttet verneutstyr
						}
					}
				}
			}
			ELEMENT[at0080] occurrences matches {0..1} matches {    -- Fritekst
				value matches {
					DV_TEXT matches {*}
				}
			}
		}
	}

