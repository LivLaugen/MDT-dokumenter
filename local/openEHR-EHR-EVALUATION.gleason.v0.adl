definition
	EVALUATION[at0000] matches {    -- Gleason
		data matches {
			ITEM_TREE[at0001] matches {    -- Tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0003] occurrences matches {0..1} matches {    -- VevsproveIkkeTatt
						value matches {
							DV_BOOLEAN matches {*}
						}
					}
					ELEMENT[at0004] occurrences matches {0..1} matches {    -- Geason1
						value matches {
							DV_COUNT matches {
								magnitude matches {|1..5|}
							}
						}
					}
					ELEMENT[at0005] occurrences matches {0..1} matches {    -- Gleason2
						value matches {
							DV_COUNT matches {
								magnitude matches {|1..5|}
							}
						}
					}
					ELEMENT[at0006] occurrences matches {0..1} matches {    -- Gleason2IkkeSatt
						value matches {
							DV_BOOLEAN matches {*}
						}
					}
					ELEMENT[at0007] occurrences matches {0..1} matches {    -- GleasonScore
						value matches {
							DV_COUNT matches {
								magnitude matches {|2..10|}
							}
						}
					}
					ELEMENT[at0008] occurrences matches {0..1} matches {    -- GleasonKanIkkeVurderes
						value matches {
							DV_BOOLEAN matches {*}
						}
					}
					ELEMENT[at0009] occurrences matches {0..1} matches {    -- MorfologiskBasisGleason
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0010,    -- Biopsi
									at0011,    -- TUR-P
									at0012,    -- Cytologi
									at0013,    -- Metastase
									at0014]    -- Annet
								}
							}
						}
					}
					ELEMENT[at0015] occurrences matches {0..1} matches {    -- MorfolgisikBasisGleasonSpesifiser
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0016] occurrences matches {0..1} matches {    -- DatoGleasonScore
						value matches {
							DV_DATE matches {
								value matches {yyyy-mm-dd}
							}
						}
					}
				}
			}
		}
	}

