definition
	EVALUATION[at0000] matches {    -- LAR Siste år
		data matches {
			ITEM_TREE[at0001] matches {    -- Tree
				items cardinality matches {0..*; unordered} matches {
					CLUSTER[at0002] occurrences matches {0..1} matches {    -- C1 Lovbrudd siste år
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0003] occurrences matches {0..1} matches {    -- a) Arrestert/satt i varetekt, tiltalt, dømt
								value matches {
									DV_BOOLEAN matches {*}
								}
							}
						}
					}
					ELEMENT[at0004] occurrences matches {0..1} matches {    -- C2 Overdose siste år
						value matches {
							DV_BOOLEAN matches {*}
						}
					}
					ELEMENT[at0005] occurrences matches {0..1} matches {    -- C3 Suicidalforsøk siste år
						value matches {
							DV_BOOLEAN matches {*}
						}
					}
					ELEMENT[at0006] occurrences matches {0..1} matches {    -- C4 Bruk av illegale rusmidler siste år
						value matches {
							0|[local::at0007],
							1|[local::at0008],
							2|[local::at0009],
							9|[local::at0010]
						}
					}
					CLUSTER[at0011] occurrences matches {0..1} matches {    -- C5 Fornøydhet
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0012] occurrences matches {0..1} matches {    -- a) Pasientens vurdering
								value matches {
									0|[local::at0013],
									1|[local::at0014],
									2|[local::at0015],
									9|[local::at0016]
								}
							}
							ELEMENT[at0017] occurrences matches {0..1} matches {    -- b) Behandlers vurdering
								value matches {
									0|[local::at0018],
									1|[local::at0019],
									2|[local::at0020],
									9|[local::at0021]
								}
							}
						}
					}
					CLUSTER[at0022] occurrences matches {0..1} matches {    -- C6 Anbefales behandlingsendringer?
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0023] occurrences matches {0..1} matches {    -- Utfyllers vurdering
								value matches {
									0|[local::at0024],
									1|[local::at0025],
									9|[local::at0026]
								}
							}
						}
					}
					CLUSTER[at0027] occurrences matches {0..1} matches {    -- C7 Hvem har deltatt i utfyllingen
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0028] occurrences matches {0..1} matches {    -- Pasient
								value matches {
									DV_BOOLEAN matches {*}
								}
							}
							ELEMENT[at0030] occurrences matches {0..1} matches {    -- Samarbeidspartner
								value matches {
									DV_BOOLEAN matches {*}
								}
							}
							ELEMENT[at0031] occurrences matches {0..1} matches {    -- Ansvarsgrupper
								value matches {
									DV_BOOLEAN matches {*}
								}
							}
						}
					}
				}
			}
		}
	}

