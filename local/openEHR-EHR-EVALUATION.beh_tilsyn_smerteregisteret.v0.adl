definition
	EVALUATION[at0000] matches {    -- Behandling og tilsyn Smerteregisteret
		data matches {
			ITEM_TREE[at0001] matches {    -- ItemTree
				items cardinality matches {0..*; unordered} matches {
					CLUSTER[at0027] occurrences matches {0..1} matches {    -- 1. Smertebehandling initiert og/eller endret av smerteteamet
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0002] occurrences matches {0..1} matches {    -- 1a. Medikamentell behandling
								value matches {
									0|[local::at0007],
									1|[local::at0008],
									9|[local::at0009]
								}
							}
							CLUSTER[at0029] occurrences matches {0..1} matches {    -- Type medikamentell behandling
								items cardinality matches {1..*; unordered} matches {
									ELEMENT[at0036] occurrences matches {0..*} matches {    -- Type medikamentell behandling
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0037,    -- Opioider
													at0038,    -- Non-opioider
													at0039,    -- Ko-analgetika
													at0040]    -- Benzodiazepiner
												}
											}
										}
									}
									ELEMENT[at0034] occurrences matches {0..1} matches {    -- Har det oppstått alvorlig respirasjonsdepresjon pga denne behandlingen?
										value matches {
											0|[local::at0007],
											1|[local::at0008],
											9|[local::at0009]
										}
									}
									ELEMENT[at0053] occurrences matches {0..*} matches {    -- Hvilke tiltak er iverksatt?
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0054,    -- Ingen
													at0055,    -- Oksygenbehandling
													at0056,    -- Motgift
													at0057,    -- Forsterket overvåkning
													at0058,    -- Intensivbehandling
													at0059,    -- Resusitering
													at0060]    -- Respiratorbehandling
												}
											}
										}
									}
								}
							}
							ELEMENT[at0011] occurrences matches {0..1} matches {    -- 1b. Psykososial behandling
								value matches {
									0|[local::at0007],
									1|[local::at0008],
									9|[local::at0009]
								}
							}
							ELEMENT[at0015] occurrences matches {0..1} matches {    -- 1c. Fysioterapibehandling
								value matches {
									0|[local::at0007],
									1|[local::at0008],
									9|[local::at0009]
								}
							}
							ELEMENT[at0019] occurrences matches {0..1} matches {    -- 1d. Sentrale blokader
								value matches {
									0|[local::at0007],
									1|[local::at0008],
									9|[local::at0009]
								}
							}
							CLUSTER[at0035] occurrences matches {0..1} matches {    -- Type sentrale blokader
								items cardinality matches {1..*; unordered} matches {
									ELEMENT[at0041] occurrences matches {0..*} matches {    -- Type sentral blokade
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0042,    -- Epidural
													at0043]    -- Spinal
												}
											}
										}
									}
									ELEMENT[at0044] occurrences matches {0..*} matches {    -- Medikamenter
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0045,    -- Opioider
													at0046,    -- Lokal anestesi
													at0047,    -- Ko-analgetika
													at0048]    -- Annet
												}
											}
										}
									}
									ELEMENT[at0049] occurrences matches {0..1} matches {    -- Har det oppstått alvorlige komplikasjoner pga denne behandlingen?
										value matches {
											0|[local::at0007],
											1|[local::at0008],
											9|[local::at0009]
										}
									}
									ELEMENT[at0061] occurrences matches {0..*} matches {    -- Hvilke komplikasjoner?
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0062,    -- Intraspinalt/epiduralt hematom
													at0063,    -- Meningitt
													at0064,    -- Epidural abscess
													at0065,    -- Nerveskader
													at0066,    -- Migrering av kateter fra epiduralt til spinalt
													at0067,    -- Intravasal injeksjon av lokalanestesi
													at0068,    -- Postspinal hodepine
													at0069,    -- Falltendens pga lokalanestesi
													at0070]    -- Lekkasje av CNF
												}
											}
										}
									}
									ELEMENT[at0071] occurrences matches {0..*} matches {    -- Hvilke tiltak er iverksatt?
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0072,    -- Ingen
													at0073,    -- Operasjon
													at0074,    -- Antibiotikabehandling
													at0075,    -- Fjerning av kateter
													at0076,    -- Bloodpatch
													at0077,    -- Sengeleie
													at0078,    -- Fenazon/koffein
													at0079]    -- Endring av medikament
												}
											}
										}
									}
								}
							}
							ELEMENT[at0023] occurrences matches {0..1} matches {    -- 1e. Perifere blokader
								value matches {
									0|[local::at0007],
									1|[local::at0008],
									9|[local::at0009]
								}
							}
							CLUSTER[at0080] occurrences matches {0..1} matches {    -- Type perifere blokader
								items cardinality matches {1..*; unordered} matches {
									ELEMENT[at0081] occurrences matches {0..*} matches {    -- Type perifer blokade
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0082,    -- Plexus brachialis blokade
													at0083,    -- Paravertebral blokade
													at0084,    -- Intercostal blokade
													at0085,    -- PECS blokade(Pectoral nerve)
													at0086,    -- TAP blokade (Transversus abdominis plan)
													at0087,    -- Femoral blokade
													at0088,    -- Adduktor kanal blokade
													at0089,    -- Ischiadicus blokade
													at0090,    -- Plexus Lumbalis blokade
													at0091,    -- Fascia iliaca compartment blokade
													at0092,    -- Serratus plane Block
													at0093]    -- Annen blokade
												}
											}
										}
									}
									ELEMENT[at0094] occurrences matches {0..*} matches {    -- Type plexus brachialis-blokade
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0095,    -- Interscalen
													at0096,    -- Supraklavikulær
													at0097,    -- Infraklavikulær
													at0098]    -- Axillær
												}
											}
										}
									}
									ELEMENT[at0099] occurrences matches {0..*} matches {    -- Type PECS-blokade
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0100,    -- Underkategori 1
													at0101]    -- Underkategori 2
												}
											}
										}
									}
									ELEMENT[at0102] occurrences matches {0..*} matches {    -- Type ischiadicus-blokade
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0103,    -- Subgluteal
													at0104]    -- Poplitea
												}
											}
										}
									}
									ELEMENT[at0105] occurrences matches {0..*} matches {    -- Administrasjonsmåte
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0106,    -- Singelshot
													at0107]    -- Infusjon
												}
											}
										}
									}
									ELEMENT[at0108] occurrences matches {0..1} matches {    -- Har det oppstått alvorlige komplikasjoner pga denne behandlingen?
										value matches {
											0|[local::at0007],
											1|[local::at0008],
											9|[local::at0009]
										}
									}
									ELEMENT[at0112] occurrences matches {0..*} matches {    -- Hvilke komplikasjoner?
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0113,    -- Nerveskade
													at0114,    -- Infeksjon
													at0115,    -- Intravasal injeksjon av lokalanestesi
													at0116]    -- Intoksikasjon
												}
											}
										}
									}
									ELEMENT[at0117] occurrences matches {0..1} matches {    -- Hvilke tiltak er iverksatt?
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0118,    -- Ingen
													at0119,    -- Operasjon
													at0120,    -- Antibiotikabehandling
													at0121,    -- Fjerning av kateter
													at0122]    -- Endret medisinering og intensivmedisinske tiltak
												}
											}
										}
									}
								}
							}
						}
					}
					CLUSTER[at0028] occurrences matches {0..1} matches {    -- 2. Behandler av smertetilstand
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0123] occurrences matches {0..*} matches {    -- Behandler av smertetilstand
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0124,    -- Lege
											at0125,    -- Sykepleier
											at0126,    -- Fysioterapeut
											at0127,    -- Psykolog
											at0128,    -- Sosionom
											at0129,    -- Ambulerende lege
											at0130]    -- Ambulerende sykepleier
										}
									}
								}
							}
							ELEMENT[at0131] occurrences matches {0..*} matches {    -- Antall tilsyn
								value matches {
									DV_COUNT matches {
										magnitude matches {|1..100|}
									}
								}
								name matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0142,    -- Antall tilsyn lege
											at0143,    -- Antall tilsyn sykepleier
											at0144,    -- Antall tilsyn fysioterapeut
											at0145,    -- Antall tilsyn psykolog
											at0146,    -- Antall tilsyn sosionom
											at0147,    -- Antall tilsyn ambulerende lege
											at0148]    -- Antall tilsyn ambulerende sykepleier
										}
									}
								}
							}
							ELEMENT[at0139] occurrences matches {0..1} matches {    -- Antall pasienttilsyn
								value matches {
									DV_COUNT matches {
										magnitude matches {|>=0|}
									}
								}
							}
							ELEMENT[at0141] occurrences matches {0..1} matches {    -- Total tidsbruk
								value matches {
									DV_DURATION matches {
										value matches {PTM/|PT0M..PT500M|}
									}
								}
							}
						}
					}
					ELEMENT[at0149] occurrences matches {0..1} matches {    -- 5. Bør pasient følges videre opp for sin smertetilstand etter utskrivelse?
						value matches {
							0|[local::at0007],
							1|[local::at0008],
							9|[local::at0009]
						}
					}
					ELEMENT[at0151] occurrences matches {0..1} matches {    -- 5a. Er det anbefalt videre oppfølging hos fastlege?
						value matches {
							0|[local::at0153],
							1|[local::at0154],
							2|[local::at0155],
							3|[local::at0156]
						}
					}
					ELEMENT[at0152] occurrences matches {0..1} matches {    -- 5b. Er det anbefalt videre oppfølging hos annen institusjon
						value matches {
							0|[local::at0153],
							1|[local::at0154],
							2|[local::at0155],
							3|[local::at0156]
						}
					}
					ELEMENT[at0150] occurrences matches {0..1} matches {    -- 6. Anbefalt videre oppfølging ved smerteklinikk?
						value matches {
							0|[local::at0007],
							1|[local::at0008],
							9|[local::at0009]
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0010] matches {*}    -- ItemTree
		}
	}

ontology
	term_definitions = <
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"Behandling og tilsyn Smerteregisteret">
					description = <"Beh_tilsyn_smerteregisteret">
				>
				["at0001"] = <
					text = <"ItemTree">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"1a. Medikamentell behandling">
					description = <"Gjelder for all form for medikamentell smertebehandling (iv, sc, po, plaster, PCA, etc). Ved \"Ja\":
Kryss av én eller flere valgmuligheter
Ved avkrysning av opioid: 
Har det oppstått alvorlig respirasjonsdepresjon? 
Hva er alvorlig respirasjonsdepresjon? Respirasjon < 8/min">
					comment = <"OBS! Skal kun krysses av dersom respirasjonsdepresjon har oppstått etter behandling initiert av Smerteteam. Respirasjonsdepresjon i forkant av behandling initiert av Smerteteam skal ikke registreres her.">
				>
				["at0007"] = <
					text = <"Nei">
					description = <"*">
				>
				["at0008"] = <
					text = <"Ja">
					description = <"*">
				>
				["at0009"] = <
					text = <"Vet ikke">
					description = <"*">
				>
				["at0010"] = <
					text = <"ItemTree">
					description = <"@ internal @">
				>
				["at0011"] = <
					text = <"1b. Psykososial behandling">
					description = <"Samtaler mellom pasient og helsepersonell f.eks lege/sykepleier/psykolog/sosionom fra smerteklinikken eller andre, med hovedvekt på smertemestring. (avspenning, tankereise), endringsfokusert samtale, krisehåndtering, angstreduserende samtale.">
				>
				["at0015"] = <
					text = <"1c. Fysioterapibehandling">
					description = <"F.eks TENS, massasje, avspenning, aktivering og mobilisering etc initiert eller utført av smerteteamet">
				>
				["at0019"] = <
					text = <"1d. Sentrale blokader">
					description = <"F.eks EDA og spinalkateter som brukes kun med formål om smertelindring.">
				>
				["at0023"] = <
					text = <"1e. Perifere blokader">
					description = <"I hovedsak via kateter, men kan også være \"single shot\" perifere blokader som utføres for smertelindring.">
				>
				["at0027"] = <
					text = <"1. Smertebehandling initiert og/eller endret av smerteteamet">
					description = <"*">
				>
				["at0028"] = <
					text = <"2. Behandler av smertetilstand">
					description = <"En kan krysse av for flere behandlere.

Her oppføres hvem som faktisk har vært involvert i pasientbehandlingen og hvor mye ressurser som ble brukt. Antall tilsyn i denne kategorien kan avvike fra antall tilsyn i spørsmål 3 om antall pasienttilsyn.

Presisering: Dersom både lege/LIS og sykepleier har vært hos pasient på tilsyn, registreres det som et legetilsyn og et sykepleietilsyn i spørsmål 1, dersom en anser det som nødvendig for pasientbehandlingen at begge to er med. En LIS-lege som følger en overlege pga opplæring registrers ikke som ekstra legetilsyn. I spørsmål 3 telles det derimot kun som 1 tilsyn.

Ved vaktromtilsyn skal det ikke registreres tilsyn i spørsmål 3.">
				>
				["at0029"] = <
					text = <"Type medikamentell behandling">
					description = <"*">
				>
				["at0034"] = <
					text = <"Har det oppstått alvorlig respirasjonsdepresjon pga denne behandlingen?">
					description = <"Hva er alvorlig respirasjonsdepresjon? Respirasjon < 8/min">
				>
				["at0035"] = <
					text = <"Type sentrale blokader">
					description = <"*">
				>
				["at0036"] = <
					text = <"Type medikamentell behandling">
					description = <"*">
				>
				["at0037"] = <
					text = <"Opioider">
					description = <"F.eks Morfin, Oxynorm, Fentanyl, Metadon, Subutex, Tramadol, Paralgin forte.">
				>
				["at0038"] = <
					text = <"Non-opioider">
					description = <"F.eks Paracet, Nsaids, Cox-2 hemmere.">
				>
				["at0039"] = <
					text = <"Ko-analgetika">
					description = <"F.eks: Lyrica, Neurontin, Sarotex, Noritren, Cymbalta, Efexor, Klonidin, Ketalar, Ketamin og Steroider (brukt i forbindelse med smertebehandling).">
				>
				["at0040"] = <
					text = <"Benzodiazepiner">
					description = <"F.eks: Sobril, Stesolid, Xanor, Vival, Diazepam, Oxazepam.">
				>
				["at0041"] = <
					text = <"Type sentral blokade">
					description = <"*">
				>
				["at0042"] = <
					text = <"Epidural">
					description = <"*">
				>
				["at0043"] = <
					text = <"Spinal">
					description = <"*">
				>
				["at0044"] = <
					text = <"Medikamenter">
					description = <"*">
				>
				["at0045"] = <
					text = <"Opioider">
					description = <"*">
				>
				["at0046"] = <
					text = <"Lokal anestesi">
					description = <"*">
				>
				["at0047"] = <
					text = <"Ko-analgetika">
					description = <"*">
				>
				["at0048"] = <
					text = <"Annet">
					description = <"*">
				>
				["at0049"] = <
					text = <"Har det oppstått alvorlige komplikasjoner pga denne behandlingen?">
					description = <"Gjelder for all form for medikamentell smertebehandling (iv, sc, po, plaster, PCA, etc). Ved \"Ja\":
Kryss av én eller flere valgmuligheter
Ved avkrysning av opioid: 
Har det oppstått alvorlig respirasjonsdepresjon? 
Hva er alvorlig respirasjonsdepresjon? Respirasjon < 8/min">
					comment = <"OBS! Skal kun krysses av dersom respirasjonsdepresjon har oppstått etter behandling initiert av Smerteteam. Respirasjonsdepresjon i forkant av behandling initiert av Smerteteam skal ikke registreres her.">
				>
				["at0053"] = <
					text = <"Hvilke tiltak er iverksatt?">
