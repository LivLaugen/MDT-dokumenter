		["nb"] = <
			items = <
				["at0.46"] = <
					text = <"TX">
					description = <"Primærtumor kan ikke vurderes">
				>
				["at0.47"] = <
					text = <"T0">
					description = <"Primærtumor ikke påvist">
				>
				["at0.48"] = <
					text = <"T1">
					description = <"Klinisk ingen tumor som er palpabel eller synlig på bilde">
				>
				["at0.49"] = <
					text = <"T1a">
					description = <"Tumor tilfeldig histologisk funnet i 5% eller mindre av fjernet vev">
				>
				["at0.50"] = <
					text = <"T1b">
					description = <"Tumor tilfeldig histologisk funnet i mer enn 5% av fjernet vev">
				>
				["at0.51"] = <
					text = <"T1c">
					description = <"Tumor identifisert ved nålebiopsi (f.eks. på grunn av forhøyet PSA)">
				>
				["at0.52"] = <
					text = <"NX">
					description = <"NX - Regionale lymfeknuter kan ikke vurderes
pNX - Regionale lymfeknuter ikke funnet">
				>
				["at0.53"] = <
					text = <"N0">
					description = <"N0 - Ingen metastase til regionale lymfeknuter
pN0 - Ingen positive lymfeknuter">
				>
				["at0.54"] = <
					text = <"N1">
					description = <"N1 - Metastase til regional(e) lymfeknute(r)
pN1 - Metastase til regional(e) knute(r)">
				>
				["at0.55"] = <
					text = <"M0">
					description = <"Ingen fjernmetastase">
				>
				["at0.56"] = <
					text = <"M1a">
					description = <"Ikke-regional(e) lymfeknute(r)">
				>
				["at0.57"] = <
					text = <"M1b">
					description = <"Skjelett">
				>
				["at0.58"] = <
					text = <"M1c">
					description = <"Andre steder med eller uten sykdom i skjelettet">
				>
				["at0.59"] = <
					text = <"T2">
					description = <"T2 - Tumor begrenset innen prostata. (Tumor funnet i en eller begge lapper ved nålebiopsi, men ikke palpabel eller synlig på bilde, klassifiseres som T1c)
pT2 - Begrenset til organ">
				>
				["at0.60"] = <
					text = <"T2a">
					description = <"T2a - Tumor involverer halvdelen av en lapp eller mindre
pT2a - Unilateral, halvdelen av en side eller mindre">
				>
				["at0.61"] = <
					text = <"T2b">
					description = <"T2b - Tumor involverer mer enn halvdelen av en lapp men ikke begge lapper
pT2b - Unilateral, involverer mer enn halvdelen av siden, men ikke begge sider">
				>
				["at0.62"] = <
					text = <"T2c">
					description = <"T2c - Tumor involverer begge lapper
pT2c - Bilateral sykdom">
				>
				["at0.63"] = <
					text = <"T3">
					description = <"T3 - Tumor strekker seg gjennom prostata-kapselen (Infiltrasjon til prostatisk apex eller inn i (men ikke utover) den prostatiske kapsel klassifiseres som T2, ikke som T3)
pT3 - Ekstraprostatisk ekstensjon">
				>
				["at0.64"] = <
					text = <"T3a">
					description = <"T3a - Ekstrakapsulær ekstensjon (unilateral eller bilateral)
pT3a - Ekstraprostatisk ekstensjon eller mikroskopisk infiltrasjon av blærehals (Tumorinfiltrasjon i reseksjonsrand bør beskrives som R1 (mikroskopisk resttumor)">
				>
				["at0.65"] = <
					text = <"T3b">
					description = <"T3b - Tumor invaderer sædblæren(e)
pT3b - Infiltrasjon av sædblære">
				>
				["at0.66"] = <
					text = <"T4">
					description = <"T4 - Tumor er fast og invaderer nærliggende strukturer, andre enn sædblærene, som ekstern sfinkter, rektum, blære, levator muskel, og/eller bekkenvegg
pT4 - Infiltrasjon av rektum, levator muskel og/eller bekkenvegg">
				>
				["at0.67"] = <
					text = <"MX">
					description = <"Fjernmetastase kan ikke vurderes.">
				>
				["at0.68"] = <
					text = <"Stadium I">
					description = <"T1a–c N0 M0
T2a N0 M0
T1–2a N0 M0">
				>
				["at0.69"] = <
					text = <"Stadium II">
					description = <"Stadium IIA 
T1a–c N0 M0
T1a–c N0 M0
T2a N0 M0
T2b N0 M0
T2b N0 M0

Stadium IIB 
T2c N0 M0
T1–2 N0 M0
T1–2 N0 M0
">
				>
