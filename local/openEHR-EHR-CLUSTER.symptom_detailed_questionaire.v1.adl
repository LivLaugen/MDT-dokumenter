	>

definition
	CLUSTER[at0000] matches {    -- Symptom_detailed_questionaire
		items cardinality matches {1..*; unordered} matches {
			CLUSTER[at0156] occurrences matches {0..1} matches {    -- Detailed characteristics
				items cardinality matches {1..*; unordered} matches {
					ELEMENT[at0032] occurrences matches {0..1} matches {    -- Character
						value matches {
							DV_TEXT matches {*}
						}
					}
				}
			}
			ELEMENT[at0008] occurrences matches {0..1} matches {    -- Onset Type
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0009,    -- Gradual
							at0036,    -- Rapid
							at0010]    -- Sudden
						}
					}
				}
			}
			ELEMENT[at0155] occurrences matches {0..1} matches {    -- Site
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0163] occurrences matches {0..1} matches {    -- Duration
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0164,    -- Minutes
							at0165,    -- Hours
							at0166,    -- Days
							at0167,    -- Weeks
							at0168]    -- Months
						}
					}
				}
			}
			ELEMENT[at0169] occurrences matches {0..1} matches {    -- Duration Fits/Seizures/Attacks
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0176,    -- None
							at0175,    -- Seconds
							at0170,    -- Minutes
							at0171,    -- Hours
							at0172,    -- Days
							at0173]    -- Weeks
						}
					}
				}
			}
			CLUSTER[at0014] occurrences matches {0..1} matches {    -- Precipitating factors
				items cardinality matches {1..*; unordered} matches {
					ELEMENT[at0015] occurrences matches {1..*} matches {    -- Precipitating Factor
						value matches {
							DV_TEXT matches {*}
						}
					}
				}
			}
			CLUSTER[at0018] occurrences matches {0..1} matches {    -- Modifying factors
				items cardinality matches {1..*; unordered} matches {
					ELEMENT[at0019] occurrences matches {0..*} matches {    -- Factor
						value matches {
							DV_TEXT matches {*}
						}
					}
				}
			}
			CLUSTER[at0161] occurrences matches {0..1} matches {    -- Other symptoms
				items cardinality matches {1..*; unordered} matches {
					ELEMENT[at0162] occurrences matches {0..1} matches {    -- Other symptom
						value matches {
							DV_TEXT matches {*}
						}
					}
				}
			}
			CLUSTER[at0159] occurrences matches {0..1} matches {    -- Other questions
				items cardinality matches {1..*; unordered} matches {
					ELEMENT[at0160] occurrences matches {0..1} matches {    -- Question
						value matches {
							DV_TEXT matches {*}
						}
					}
				}
			}
		}
	}

