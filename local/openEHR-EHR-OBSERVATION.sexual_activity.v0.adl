description
	original_author = <
		["date"] = <"2015-11-13">
		["name"] = <"Arne Løberg Sæter">
		["organisation"] = <"DIPS ASA">
		["email"] = <"asa@dips.no">
	>
	lifecycle_state = <"in_development">
	other_contributors = <"Vebjørn Arntzen, Oslo universitetssykehus","Heather Leslie, Ocean Informatics, Australia">
	details = <
		["nb"] = <
			language = <[ISO_639-1::nb]>
			purpose = <"Foreløpig arketype for Olafiaklinikken, Oslo universitetssykehus. Knyttet til et individs seksuelle aktivitet sett i relasjon til SOI.">
			copyright = <"© Nasjonal IKT HF">
			use = <"Hensikten med arketypen er å kunne registrere data knyttet til et individs seksuelle aktivitet i en gitt periode. Dette kan brukes i en anamnese for individer som oppsøker helsetjenesten enten med en mistanke om en seksuelt overførbar infeksjon (SOI), eller brukes i en rådgivning. Informasjonselementene gir god anledning til å gjøre en evaluering av et individs risikoprofil knyttet til SOI.">
			misuse = <"Her må det utarbeides noe tekst, når vi får erfaring med arketypen.">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"Preliminary archetype for use in Olafia Clinic, Oslo University Hospital. Deals with sexual actiivt for an individual in a given time.">
			copyright = <"© Nasjonal IKT HF">
			use = <"To be used to register data related to sexual activity for an individ in a given time. Information registred can be used in a history/story taking in a health clinic for individuals that suspects a Sexual Transmitted Infection (STI) or as a background for advisory consultation.

Information elements are well suitable for a risk assessment for STI related to the individuals behavoiour.
">
			misuse = <"Text will be provided later.">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"Nasjonal IKT">
		["original_namespace"] = <"no.nasjonalikt">
		["original_publisher"] = <"Nasjonal IKT">
		["custodian_namespace"] = <"no.nasjonalikt">
		["MD5-CAM-1.0.1"] = <"11DE56F15B832B456288A8E8CE6955F9">
		["build_uid"] = <"bd755c7c-2b5d-43f7-bfac-b71185d398ab">
		["revision"] = <"0.0.1-alpha">
	>

definition
	OBSERVATION[at0000] matches {    -- Sexual activity
		data matches {
			HISTORY[at0001] matches {    -- Event Series
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..1} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0009] occurrences matches {0..1} matches {    -- Sexually active
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0022,    -- Yes
													at0023,    -- No
													at0024]    -- Unsure
												}
											}
										}
									}
									ELEMENT[at0029] occurrences matches {0..1} matches {    -- If unsure, specify
										value matches {
											DV_TEXT matches {*}
										}
									}
									ELEMENT[at0025] occurrences matches {0..*} matches {    -- Types of sex
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0027,    -- Vaginal
													at0028,    -- Oral
													at0026]    -- Anal
												}
											}
										}
									}
									ELEMENT[at0011] occurrences matches {0..1} matches {    -- Number of partners
										value matches {
											DV_COUNT matches {*}
										}
									}
									ELEMENT[at0012] occurrences matches {0..*} matches {    -- Genders of sex partners
										value matches {
											DV_TEXT matches {*}
										}
									}
									ELEMENT[at0046] occurrences matches {0..1} matches {    -- Description to partner gender
										value matches {
											DV_TEXT matches {*}
										}
									}
									ELEMENT[at0017] occurrences matches {0..1} matches {    -- Number of transmale partners
										value matches {
											DV_COUNT matches {
												magnitude matches {|>=0|}
											}
										}
									}
									ELEMENT[at0018] occurrences matches {0..1} matches {    -- Number of transfemale partners
										value matches {
											DV_COUNT matches {
												magnitude matches {|>=0|}
											}
										}
									}
									ELEMENT[at0019] occurrences matches {0..1} matches {    -- Number of male partners
										value matches {
											DV_COUNT matches {
												magnitude matches {|>=0|}
											}
										}
									}
									ELEMENT[at0020] occurrences matches {0..1} matches {    -- Number of female partners
										value matches {
											DV_COUNT matches {
												magnitude matches {|>=0|}
											}
										}
									}
									ELEMENT[at0035] occurrences matches {0..1} matches {    -- Number of transgender partners
										value matches {
											DV_COUNT matches {
												magnitude matches {|>=0|}
											}
										}
									}
									ELEMENT[at0036] occurrences matches {0..1} matches {    -- Had sex with sexworker
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0037,    -- Yes
													at0038,    -- No
													at0039]    -- Not sure
												}
											}
										}
									}
									ELEMENT[at0044] occurrences matches {0..*} matches {    -- Risk factors
										value matches {
											DV_TEXT matches {*}
										}
									}
									ELEMENT[at0041] occurrences matches {0..1} matches {    -- Have you received money for sex?
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0042,    -- Yes
													at0043]    -- No
												}
											}
										}
									}
									allow_archetype CLUSTER[at0021] occurrences matches {0..*} matches {    -- Sexual partners
										include
											archetype_id/value matches {/.*/}
									}
									ELEMENT[at0040] occurrences matches {0..*} matches {    -- Sex partner(s) have been from
										value matches {
											DV_TEXT matches {*}
										}
									}
									ELEMENT[at0045] occurrences matches {0..*} matches {    -- Sex partner(s) have been from (nationality)
										value matches {
											DV_TEXT matches {*}
										}
									}
								}
							}
						}
					}
					POINT_EVENT[at0004] occurrences matches {0..1} matches {    -- Last unprotected sex
						data matches {
							use_node ITEM_TREE /data[at0001]/events[at0002]/data[at0003]
						}
					}
					INTERVAL_EVENT[at0005] occurrences matches {0..1} matches {    -- 1 month
						width matches {
							DV_DURATION matches {
								value matches {P1M}
							}
						}
						data matches {
							use_node ITEM_TREE /data[at0001]/events[at0002]/data[at0003]
						}
					}
					INTERVAL_EVENT[at0006] occurrences matches {0..1} matches {    -- 3 months
						width matches {
							DV_DURATION matches {
								value matches {P3M}
							}
						}
						data matches {
							use_node ITEM_TREE /data[at0001]/events[at0002]/data[at0003]
						}
					}
					INTERVAL_EVENT[at0007] occurrences matches {0..1} matches {    -- 6 months
						width matches {
							DV_DURATION matches {
								value matches {P6M}
							}
						}
						data matches {
							use_node ITEM_TREE /data[at0001]/events[at0002]/data[at0003]
						}
					}
					INTERVAL_EVENT[at0008] occurrences matches {0..1} matches {    -- 12 months
						width matches {
							DV_DURATION matches {
								value matches {P12M}
							}
						}
						data matches {
							use_node ITEM_TREE /data[at0001]/events[at0002]/data[at0003]
						}
					}
				}
			}
		}
	}

