definition
	ACTION[at0000] matches {    -- Klage på tvangsvedtak
		ism_transition matches {
			ISM_TRANSITION[at0002] matches {    -- Pågående klagesak
				current_state matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[openehr::245]
						}
					}
				}
				careflow_step matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::at0002]    -- Pågående klagesak
						}
					}
				}
			}
			ISM_TRANSITION[at0007] matches {    -- Ferdigbehandlet klagesak
				current_state matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[openehr::532]
						}
					}
				}
				careflow_step matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::at0007]    -- Ferdigbehandlet klagesak
						}
					}
				}
			}
		}
		description matches {
			allow_archetype ITEM_TREE matches {
				include
					archetype_id/value matches {/openEHR-EHR-ITEM_TREE\.om_klage_paa_vedtak_om_tvang(-[a-zA-Z0-9_]+)*\.v1/}
			}
		}
	}

