definition
	CLUSTER[at0000] matches {    -- Examination eye anterior chamber
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Beskrivelse
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- Øye undersøkt
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0003,    -- Høyre
							at0004]    -- Venstre
						}
					}
				}
			}
			allow_archetype CLUSTER[at0005] occurrences matches {0..*} matches {    -- Gradering av inflammasjon i forkammeret
				include
					archetype_id/value matches {/openEHR-EHR-CLUSTER\.schlaegel_ac_cells(-[a-zA-Z0-9_]+)*\.v1/}
			}
		}
	}

