definition
	OBSERVATION[at0000] matches {    -- Cotton classification of complications
		data matches {
			HISTORY[at0001] matches {    -- Event Series
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..1} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0004] occurrences matches {0..1} matches {    -- Cotton classification
										value matches {
											1|[local::at0005]
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Cotton classification of complications">
					description = <"Cottons score for classification of complications during and after ERCP">
				>
				["at0001"] = <
					text = <"Event Series">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Any event">
					description = <"*">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"Cotton classification">
					description = <"Classification of complications during or after an ERCP-procedure ">
				>
				["at0005"] = <
					text = <"Grade 1(mild)">
					description = <"Bleeding: Clinical (not just endoscopic) evidence of bleeding, hemoglobin drop <3 g, and no need for transfusion. Perforation: Possible, or only very slight leak of fluid or contrast, treatable by fluids and suction for three days or less. Pancreatitis: Amylase at least three times normal at more than 24 hours after the procedure, requiring admission or prolongation of planned admission to two to three days. Choleangitis: Clinical (not just endoscopic) evidence of bleeding, hemoglobin drop <3 g, and no need for transfusion">
				>
			>
		>
	>
