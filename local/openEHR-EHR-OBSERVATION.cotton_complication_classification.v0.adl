	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To classify complications during or after an ERCP-procedure (Endoscopic retrograde choleangiopancreaticiography).">
			keywords = <"ERCP","Endoscopic","Cotton","Complications">
			copyright = <"© Nasjonal IKT HF">
			use = <"Use to classify complications during or after an ERCP-procedure (Endoscopic retrograde choleangiopancreaticiography).
The scale was proposed by Peter Cotton in 1997 ">
