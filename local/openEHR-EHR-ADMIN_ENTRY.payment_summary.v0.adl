description
	original_author = <
		["name"] = <"">
	>
	lifecycle_state = <"in_development">
	details = <
		["nb"] = <
			language = <[ISO_639-1::nb]>
			purpose = <"Håndtere betalingskrav til pasient og refusjonskrav til tredjeparts betaler som følge av en eller flere pasientkontakter.">
			copyright = <"© Nasjonal IKT HF">
			use = <"Håndtere betalingskrav til pasient og refusjonskrav til tredjeparts betaler som følge av en eller flere pasientkontakter.">
			misuse = <"All annen bruk.">
		>
		["en-gb"] = <
			language = <[ISO_639-1::en-gb]>
			purpose = <"Manage payment demands to patient and reimbursement request to third party related to a patient encounter.">
			copyright = <"© Nasjonal IKT HF">
			use = <"Manage payment demands to patient and reimbursement request to third party related to a patient encounter.">
			misuse = <"Any other use.">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"Nasjonal IKT">
