				>
				["at0013"] = <
					text = <"Kommunalt frikort.">
					description = <"Pasienten faller inn under kriteriene for kommunalt frikort. Utlegg dekkes av tredjeparts betaler.">
				>
				["at0015"] = <
					text = <"Regningstidspunkt">
					description = <"Dato og klokkeslett regningskortet gjelder for.">
				>
				["at0016"] = <
					text = <"Diagnose">
					description = <"Diagnose tilknyttet regningskortet.">
				>
				["at0017"] = <
					text = <"Diagnoser">
					description = <"Diagnoser tilknyttet regningskortet.">
				>
				["at0018"] = <
					text = <"Takster">
					description = <"Takster definert av tredjeparts betaler brukt i dette regningskortet.">
				>
				["at0019"] = <
					text = <"Takst">
					description = <"Takst definert av tredjeparts betaler brukt i dette regningskortet.">
				>
				["at0020"] = <
					text = <"Takstkode">
					description = <"Tredjeparts betaler sin identifikator for taksten.">
				>
				["at0021"] = <
					text = <"Egenandel">
					description = <"Delbeløpet av taksten som pasienten skal betale.">
				>
				["at0022"] = <
					text = <"Refusjon">
					description = <"Delbeløpet av taksten som refunderes av tredjepart.">
				>
				["at0023"] = <
					text = <"Betalingsstatus pasient">
					description = <"Betalingsstatus for pasientens delbeløp av regningskortet.">
				>
				["at0024"] = <
					text = <"Utkast">
					description = <"Regningskortutkast. Ikke utstedt til pasient ennå.">
				>
				["at0025"] = <
					text = <"Til betaling">
					description = <"Regning utstedt til pasient for betaling.">
				>
				["at0026"] = <
					text = <"Betalt">
					description = <"Pasienten har betalt sin andel av regningskortet.">
				>
				["at0027"] = <
					text = <"Betalingsstatus tredjeparts betaler">
					description = <"Betalingsstatus for tredjeparts betaler sitt delbeløp av regningskortet.">
				>
				["at0028"] = <
					text = <"Utkast">
					description = <"Regningskortutkast. Ikke oversendt tredjeparts betaler ennå.">
