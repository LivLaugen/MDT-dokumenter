description
	original_author = <
		["date"] = <"2016-04-28">
		["name"] = <"Daniel Habashi">
		["organisation"] = <"PatientSky AS">
		["email"] = <"dh@patientsky.com">
	>
	lifecycle_state = <"in_development">
	other_contributors = <"Vebjørn Arntzen, Oslo universitetssykehus HF, Norway (Nasjonal IKT redaktør)","Silje Ljosland Bakke, Nasjonal IKT HF, Norway (Nasjonal IKT redaktør)","Daniel Habashi, PasientSky AS, Norway (Nasjonal IKT redaktør)","John Tore Valand, Haukeland Universitetssjukehus, Norway (Nasjonal IKT redaktør)">
	details = <
		["nb"] = <
			language = <[ISO_639-1::nb]>
			purpose = <"Cage Questionnaire et kartleggingsverktøy som brukes for å identifisere alkoholbruk og potensielle alkoholproblemer (alkoholisme).">
			keywords = <"alkohol", ...>
			use = <"Bruk for å identifisere alkoholbruk og potensielle alkoholproblemer (alkoholisme).

CAGE består av 4 spørsmål med svaralternativ ja og nei, og brukes for å identifisere alkoholbruk. 

CAGE fylles ut av personen selv eller i samtale med en fagperson. Basert på svarene beregnes en skåre.
">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"The CAGE Questionnaire is a widely used screening test for problem drinking and potential alcohol problems (alcoholism).">
			keywords = <"alcohol", ...>
			copyright = <"© Nasjonal IKT HF">
			use = <"Use to identify drinking and potential alcohol problems (alcoholism).

The CAGE questinnaire consists of 4 questions with the respons alternatives yes and no.

The CAGE questionnaire is recorded by the patient or during av patient - clinician conversation. A score is calculated based on the answers.">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"Nasjonal IKT">
		["references"] = <"Nasjonalt kunnskapssenter for helsetjenesten, 2007 Larun, L. (2007). Dobbeldiagnose: alvorlig psykisk lidelse og ruslidelse, Del 1, Screening og diagnoseinstrumenter (Vol. nr. 21-2007). Oslo: Nasjonalt kunnskapssenter for helsetjenesten.

Helsedirektoratet. (2011). Nasjonal faglig retningslinje for utredning, behandling og oppfølging av personer med samtidig ruslidelse og psykisk lidelse - ROP-lidelser (IS-1948). Oslo: Helsedirektoratet.

Ewing, J. A. (1984). Detecting alcoholism. The CAGE questionnaire. JAMA, 252(14), 1905-1907.

Mayfield, D., McLeod, G., & Hall, P. (1974). The CAGE questionnaire: validation of a new alcoholism screening instrument. American Journal of Psychiatry, 131(10), 1121-1123.">
		["current_contact"] = <"Daniel Habashi, PatientSky AS<dh@patientsky.com>">
		["original_namespace"] = <"no.nasjonalikt">
		["original_publisher"] = <"Nasjonal IKT">
		["custodian_namespace"] = <"no.nasjonalikt">
		["MD5-CAM-1.0.1"] = <"08327F08E5D4F69F3CE5DE74ADA0E263">
		["build_uid"] = <"e597f849-93eb-4a74-bec1-63fd53572cda">
		["revision"] = <"0.0.1-alpha">
	>

definition
	OBSERVATION[at0000] matches {    -- CAGE questionnaire
		data matches {
			HISTORY[at0001] matches {    -- Event Series
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..1} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0004] occurrences matches {0..1} matches {    -- Cut down
										value matches {
											0|[local::at0009],
											1|[local::at0008]
										}
									}
									ELEMENT[at0005] occurrences matches {0..1} matches {    -- Annoyed
										value matches {
											0|[local::at0011],
											1|[local::at0010]
										}
									}
									ELEMENT[at0006] occurrences matches {0..1} matches {    -- Guilt
										value matches {
											0|[local::at0013],
											1|[local::at0012]
										}
									}
									ELEMENT[at0007] occurrences matches {0..1} matches {    -- Eye-opener
										value matches {
											0|[local::at0015],
											1|[local::at0014]
										}
									}
									ELEMENT[at0016] occurrences matches {0..1} matches {    -- Total Score
										value matches {
											DV_COUNT matches {
												magnitude matches {|0..4|}
											}
										}
									}
									ELEMENT[at0019] occurrences matches {0..1} matches {    -- Comment
										value matches {
											DV_TEXT matches {*}
										}
									}
								}
							}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0017] matches {    -- Tree
				items cardinality matches {0..*; unordered} matches {
					allow_archetype CLUSTER[at0018] occurrences matches {0..*} matches {    -- Extension
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"CAGE questionnaire">
					description = <"A screening instrument used to identify problem drinking.">
				>
				["at0001"] = <
					text = <"Event Series">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Any event">
					description = <"Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"Cut down">
					description = <"Have you ever felt you needed to Cut down on your drinking?">
				>
				["at0005"] = <
					text = <"Annoyed">
					description = <"Have people Annoyed you by criticizing your drinking?">
				>
				["at0006"] = <
					text = <"Guilt">
					description = <"Have you ever felt Guilty about drinking?">
				>
				["at0007"] = <
					text = <"Eye-opener">
					description = <"Have you ever had a drink first thing in the morning to steady your nerves or to get rid of a hangover (Eye opener)?">
				>
				["at0008"] = <
					text = <"Yes">
					description = <"">
				>
				["at0009"] = <
					text = <"No">
					description = <"">
				>
				["at0010"] = <
					text = <"Yes">
					description = <"">
				>
				["at0011"] = <
					text = <"No">
					description = <"">
				>
				["at0012"] = <
					text = <"Yes">
					description = <"">
				>
				["at0013"] = <
					text = <"No">
					description = <"">
				>
				["at0014"] = <
					text = <"Yes">
					description = <"">
				>
				["at0015"] = <
					text = <"No">
					description = <"">
				>
				["at0016"] = <
					text = <"Total Score">
					description = <"The total sum of all the Cage questionnaire parameter ordinals.">
				>
				["at0017"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0018"] = <
					text = <"Extension">
					description = <"Additional information required to capture local context or to align with other reference models/formalisms.">
					comment = <"For example: Local hospital departmental infomation or additional metadata to align with FHIR or CIMI equivalents.">
				>
				["at0019"] = <
					text = <"Comment">
					description = <"Additional narrative about the overall Cage score not captured in other fields.">
				>
			>
		>
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"CAGE kartleggingsverktøy">
					description = <"Et kartleggingsverktøy brukt for å identifisere alkoholproblemer.">
				>
				["at0001"] = <
					text = <"Event Series">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Uspesifisert hendelse">
					description = <"Standard, uspesifisert tidspunkt eller tidsintervall som kan defineres mer eksplisitt i en template eller i en applikasjon.">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"Cut down">
					description = <"Har du noen gang tenkt at du burde drikke mindre?">
				>
				["at0005"] = <
					text = <"Annoyed">
					description = <"Har du blitt irritert over at andre har kritisert drikkevanene dine?">
				>
				["at0006"] = <
					text = <"Guilt">
					description = <"Har du noen gang hatt skyldfølelse på grunn av alkoholbruken din?">
				>
				["at0007"] = <
					text = <"Eye-opener">
					description = <"Har det noen gang hent at du har startet dagen med å drikke alkohol for å roe nervene eller bli kvitt bakrusen?">
				>
				["at0008"] = <
					text = <"Ja">
					description = <"">
				>
				["at0009"] = <
					text = <"Nei">
					description = <"">
				>
				["at0010"] = <
					text = <"Ja">
					description = <"">
				>
				["at0011"] = <
					text = <"Nei">
					description = <"">
				>
				["at0012"] = <
					text = <"Ja">
					description = <"">
				>
				["at0013"] = <
					text = <"Nei">
					description = <"">
				>
				["at0014"] = <
					text = <"Ja">
					description = <"">
				>
				["at0015"] = <
					text = <"Nei">
					description = <"">
				>
				["at0016"] = <
					text = <"Totalskår">
					description = <"Summen av skår til hvert enkelt CAGE-parameter.">
				>
				["at0017"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0018"] = <
					text = <"Tilleggsinformasjon">
					description = <"Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller/formalismer.">
					comment = <"For eksempel lokale informasjonsbehov eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR eller CIMI.">
				>
				["at0019"] = <
					text = <"Kommentar">
					description = <"Ytterligere kommentar til Cage kartleggingsverktøyet som ikke er fanget opp i andre felt.">
				>
			>
		>
	>
