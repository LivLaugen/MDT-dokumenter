archetype (adl_version=1.4; uid=aadbfa88-839e-4082-8296-0fc19ed527d5)
	openEHR-EHR-OBSERVATION.nems_score.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::en]>
	translations = <
		["nb"] = <
			language = <[ISO_639-1::nb]>
			author = <
				["name"] = <"Annette Hole Sjøborg">
				["organisation"] = <"DIPS AS">
				["email"] = <"ahs@dips.no">
			>
		>
