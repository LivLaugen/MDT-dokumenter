description
	original_author = <
		["date"] = <"2017-02-22">
		["name"] = <"Annette Hole Sjøborg">
		["organisation"] = <"DIPS AS">
		["email"] = <"ahs@dips.no">
	>
	lifecycle_state = <"in_development">
	other_contributors = <"Nasrin Amele Jamedari","Siv Fauchald","Hilde Holås">
	details = <
		["nb"] = <
			language = <[ISO_639-1::nb]>
			purpose = <"For å registrere en skåring av ressursbruk ved intensiv- og postoperativavdelinger.">
			keywords = <"intensiv", ...>
			copyright = <"© Nasjonal IKT HF">
			use = <"Brukes for å registrere en skåring av ressursbruk ved intensiv- og postoperativavdelinger.

NEMS skåres vanligvis av sykepleier og skåringen skal gjøres en gang per døgn. Skåringen gjennomføres per pasient ved å besvare syv spørsmål. Svarene gir ulik poengverdi og oppsummeres i en samlet NEMS-score, hvor høy skår indikerer høy ressursbruk.">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record a score to measure the nursing workload at the ICU level.">
			keywords = <"nems", ...>
			copyright = <"© Nasjonal IKT HF">
			use = <"Use to record a score to measure the nursing workload at the ICU level.

The NEMS score is usually perfomed by nurses and is recorded once pr. 24 hours. The score is performed by answering seven questions. The total sum of all the NEMS ordinals are recorded in the total score. A high score indicates a high level nursing workload.">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"Nasjonal IKT">
		["references"] = <"Miranda, D. R, R. Moreno, G Iapichino: Nine equivalents og nursing manpower use score (NEMS), Intensive Care Med (1997) 23:760-765, copywright Springer_verlag 1997, http://link.springer.com/article/10.1007/s001340050406?no-access=true

Haagensen, R., Jamtli. B, Moen H., Stokland O.: Erfaringer med bruk av skåringssystemene SAPS II og NEMS i virksomhetsregistrering i en intensivavdeling, Tidsskr Nor Legeforen 2001; 121:687-90, Nr. 06, 28. februar 2001 
http://tidsskriftet.no/2001/02/klinikk-og-forskning/erfaringer-med-bruk-av-skaringssystemene-saps-ii-og-nems-i

Haagensen, R., Jamtli. B, Moen H., Stokland O.: Virksomhetsregistrering ved intensivavdelinger, Tidsskr Nor Legeforen 2001;121: 682-685
http://tidsskriftet.no/2001/02/klinikk-og-forskning/virksomhetsregistrering-ved-intensivavdelinger

Norsk Intensivregister (NIR) (2016). \"Spesifikasjon av NEMS-skåring i Norsk Intensivregister (revidert desember 2016)\". Hentet fra https://helse-bergen.no/seksjon/intensivregister/Documents/Mal%20for%20data/NEMS%20NIR%20des.%202016.pdf.">
		["original_namespace"] = <"no.nasjonalikt">
		["original_publisher"] = <"Nasjonal IKT">
		["custodian_namespace"] = <"no.nasjonalikt">
		["MD5-CAM-1.0.1"] = <"4F833A5D77909B289056913DD2CB6935">
		["build_uid"] = <"90da88c5-1bc2-4578-93ae-56371fea1972">
		["revision"] = <"0.0.1-alpha">
	>

definition
	OBSERVATION[at0000] matches {    -- Nems score
		data matches {
			HISTORY[at0001] matches {    -- Event Series
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..1} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0004] occurrences matches {0..1} matches {    -- Basic monitoring
										value matches {
											0|[local::at0017],
											9|[local::at0018]
										}
									}
									ELEMENT[at0005] occurrences matches {0..1} matches {    -- Intravenous medication
										value matches {
											0|[local::at0019],
											6|[local::at0020]
										}
									}
									ELEMENT[at0021] occurrences matches {0..1} matches {    -- Mechanical ventilation
										value matches {
											0|[local::at0022],
											3|[local::at0024],
											12|[local::at0023]
										}
									}
									ELEMENT[at0025] occurrences matches {0..1} matches {    -- Vasoactive medication
										value matches {
											0|[local::at0026],
											7|[local::at0027],
											12|[local::at0028]
										}
									}
									ELEMENT[at0012] occurrences matches {0..1} matches {    -- Dialysis techniques
										value matches {
											0|[local::at0030],
											6|[local::at0029]
										}
									}
									ELEMENT[at0013] occurrences matches {0..1} matches {    -- Spesific interventions in the ICU
										value matches {
											0|[local::at0031],
											5|[local::at0032]
										}
									}
									ELEMENT[at0014] occurrences matches {0..1} matches {    -- Spesific interventions outside the ICU
										value matches {
											0|[local::at0033],
											6|[local::at0034]
										}
									}
									ELEMENT[at0015] occurrences matches {0..1} matches {    -- NEMS Score
										value matches {
											DV_COUNT matches {
												magnitude matches {|0..56|}
											}
										}
									}
									ELEMENT[at0035] occurrences matches {0..1} matches {    -- Comment
										value matches {
											DV_TEXT matches {*}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"NEMS Score">
					description = <"Nine Equivalents of Nursing Manpower Use Score (NEMS) benyttes for måling av ressursbruk ved intensiv- og postoperativavdelinger.">
				>
				["at0001"] = <
					text = <"Event Series">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Uspesifisert hendelse">
					description = <"Standard, uspesifisert tidspunkt eller tidsintervall som kan defineres mer eksplisitt i en template eller i en applikasjon.">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"Basismonitorering">
					description = <"Regelmessig monitorering av vitale funksjoner.">
				>
				["at0005"] = <
					text = <"Intravenøs medikasjon">
					description = <"Bolus eller kontinuerlig.">
				>
				["at0012"] = <
					text = <"Dialyse">
					description = <"Nyreerstattende behandling. Alle metoder.">
				>
				["at0013"] = <
					text = <"Spesifikke intervensjoner på intensiv">
					description = <"Spesifikke intervensjoner utført på intensiv.">
					comment = <"Eksempler: intubering, pleuratapping, bronkoskopi, gastroskopi, elektrokonvertering, endoskopier, vending i bukleie, forberedelse til organdonasjon, dilatasjonstracheostomi, rescusitering, operative inngrep utført på intensiv, terapeutisk hypotermi/TTM, isolasjon av pasient, mobilisering som krever mer enn en sykepleier, omfattende sårskift og omfattende pårørendeoppfølging.">
				>
				["at0014"] = <
					text = <"Spesifikke intervensjoner utenfor intensiv">
					description = <"Alle prosedyrer som medfører flytting av pasienten utenfor
intensivavsnittet.
">
				>
				["at0015"] = <
					text = <"Nems Score">
					description = <"Samlet NEMS-score.">
				>
				["at0017"] = <
					text = <"Nei">
					description = <"Ingen basismonitorering.">
				>
				["at0018"] = <
					text = <"Ja">
					description = <"Basismonitorerering.">
				>
				["at0019"] = <
					text = <"Nei">
					description = <"Ingen intravenøs medikasjon.">
				>
				["at0020"] = <
					text = <"Ja">
					description = <"Intravenøs medikasjon.">
				>
				["at0021"] = <
					text = <"Mekanisk ventilasjonsstøtte">
					description = <"Behov for mekanisk ventilasjonsstøtte.">
				>
				["at0022"] = <
					text = <"Ingen ventilasjonsstøtte">
					description = <"Ingen ventilasjonsstøtte">
				>
				["at0023"] = <
					text = <"Mekanisk ventilasjonsstøtte">
					description = <"Alle metoder som gir positivt luftveistrykk, invasivt eller noninvasivt.
Ikke Optiflow.">
				>
				["at0024"] = <
					text = <"Annen ventilasjonshjelp">
					description = <"Oksygentilskudd uansett metode (brillekateter, maske)
Optiflow. Spontanventilasjon via oral, nasal eller
tracheostomitube, med eller uten oksygen.">
				>
				["at0025"] = <
					text = <"Vasoaktiv medikamentinfusjon">
					description = <"Vasoaktiv medikamentinfusjon.">
				>
				["at0026"] = <
					text = <"Ingen vasoaktiv medikamentinfusjon">
					description = <"Ingen vasoaktiv medikamentinfusjon.">
				>
				["at0027"] = <
					text = <"Enkel vasoaktiv medikamentinfusjon">
					description = <"Kontinuerlig infusjon av hvilket som helst vasoaktivt
medikament. Det skal ikke skåres for clonidin som
vasoaktivt medikament hvis indikasjonen er abstinens.">
				>
				["at0028"] = <
					text = <"Flere vasoaktive medikamentinfusjoner">
					description = <"To eller flere vasoaktive medikamentinfusjoner. Det skal ikke skåres for clonidin som vasoaktivt medikament hvis indikasjonen er abstinens.">
				>
				["at0029"] = <
					text = <"Ja">
					description = <"Pasienten får nyreerstattende behandling. Alle metoder.">
				>
				["at0030"] = <
					text = <"Nei">
					description = <"Pasienten får ikke nyreerstattende behandling.">
				>
				["at0031"] = <
					text = <"Nei">
					description = <"Røntgen thorax, ECCO, EKG, fysioterapi, ordinære sårskift,
suging, innleggelse av arteriekateter og sentralt
venekateter inkluderes ikke.">
				>
				["at0032"] = <
					text = <"Ja">
					description = <"Eksempler: intubering, pleuratapping, bronkoskopi,
gastroskopi, elektrokonvertering, endoskopier, vending i
bukleie, forberedelse til organdonasjon,
dilatasjonstracheostomi, rescusitering, operative inngrep
utført på intensiv, terapeutisk hypotermi/TTM, isolasjon av
pasient, mobilisering som krever mer enn en sykepleier,
omfattende sårskift og omfattende pårørendeoppfølging.">
				>
				["at0033"] = <
					text = <"Nei">
					description = <"Ingen prosedyrer som medfører flytting av pasienten utenfor intesivavsnittet.">
				>
				["at0034"] = <
					text = <"Ja">
					description = <"Alle prosedyrer som medfører flytting av pasienten utenfor intensivavsnittet.">
				>
				["at0035"] = <
					text = <"Kommentar">
					description = <"Ytterligere kommentar til NEMS-score som ikke er fanget opp i andre felt.">
				>
			>
		>
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Nems score">
					description = <"Nine Equivalents of Nursing Manpower Use Score (NEMS) is used for measuring nursing workload at the ICU level.">
				>
				["at0001"] = <
					text = <"Event Series">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Any event">
					description = <"Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"Basic monitoring">
					description = <"Hourly vital signs, regular record and calculation of fluid balance.">
				>
				["at0005"] = <
					text = <"Intravenous medication">
					description = <"Bolus or continuously, not including vasoactive drugs.">
				>
				["at0012"] = <
					text = <"Dialysis techniques">
					description = <"Dialysis techniques: all.">
				>
				["at0013"] = <
					text = <"Spesific interventions in the ICU">
					description = <"For example: Endotracheal intubation, introduction of pacemaker, cardioversion, endoscopy, emergencyoperation in the past 24 h, gastric lavage.">
				>
				["at0014"] = <
					text = <"Spesific interventions outside the ICU">
					description = <"Such as surgical intervention or diagnostic procedure; the interventions/procedure is related to the severity of illness of the patient and makes an extra demand upon manpower efforts in the ICU.">
				>
				["at0015"] = <
					text = <"NEMS Score">
					description = <"The total sum of all the NEMS score parameter ordinals.">
				>
				["at0017"] = <
					text = <"No">
					description = <"No basic monitoring.">
				>
				["at0018"] = <
					text = <"Yes">
					description = <"Basic monitoring.">
				>
				["at0019"] = <
					text = <"No">
					description = <"No intravenous medication.">
				>
				["at0020"] = <
					text = <"Yes">
					description = <"Intravenous medication.">
				>
				["at0021"] = <
					text = <"Mechanical ventilation">
					description = <"Mechanical ventilation.">
				>
				["at0022"] = <
					text = <"No mechanical ventilatory support">
					description = <"No mechanical ventilatory support.">
				>
				["at0023"] = <
					text = <"Mechanical ventilatory support">
					description = <"Any form of mechanical/assisted ventilation, with or withouth PEEP (e.g., continuous positive airway pressure), with or without muscle relaxants.">
				>
				["at0024"] = <
					text = <"Supplementary ventilatory care">
					description = <"Breathing spontaneously through endotracheal tube; supplementary oxygen any method.">
				>
				["at0025"] = <
					text = <"Vasoactive medication">
					description = <"Vasoactive medication.">
				>
				["at0026"] = <
					text = <"No vasoactive medication">
					description = <"No vasoactive medication.">
				>
				["at0027"] = <
					text = <"Single vasoactive medication">
					description = <"Any vasoactive drug.">
				>
				["at0028"] = <
					text = <"Multiple vasoactive medication">
					description = <"More than one vasoactive drug, regardless of type and dose.">
				>
				["at0029"] = <
					text = <"No">
					description = <"No dialysis techniques.">
				>
				["at0030"] = <
					text = <"Yes">
					description = <"Dialysis techniques.">
				>
				["at0031"] = <
					text = <"No">
					description = <"No routine interventions such as X-rays, echocardiography, electrocardiography, dressings, introduction of venous or arterial lines, are included.">
				>
				["at0032"] = <
					text = <"Yes">
					description = <"Such as endotracheal intubation, introduction of pacemaker, cardioversion, endoscopy, emergency operation in the past 24 h, gastric lavage.">
				>
				["at0033"] = <
					text = <"No">
					description = <"No specific interventions outside the ICU.">
				>
				["at0034"] = <
					text = <"Yes">
					description = <"For example surgical intervention or diagnostic procedure; the interventions/procedure is related to the severity of illness of the patient and makes an extra demand upon manpower efforts in the ICU.">
				>
				["at0035"] = <
					text = <"Comment">
					description = <"Additional narrative about the overall NEMS score not captured in other fields.">
				>
			>
		>
	>
