				["at0077"] = <
					text = <"9.1 Andre innspill til arbeidsgiver">
					description = <"Andre innspill til arbeidsgiver. ">
				>
				["at0078"] = <
					text = <"11.1 Hvis denne sykmeldingen er tilbakedatert, oppgi dato for dokumenterbar kontakt med pasienten.">
					description = <"Angir dato for dokumenterbar kontakt med pasienten dersom sykmelding er tilbakedatert. Kan leses av abeidsgiver.">
				>
				["at0079"] = <
					text = <"12.1 Pasienten er kjent eller har vist legitimasjon">
					description = <"Angir at pasienten er kjent eller har vist legitimasjon">
				>
				["at0086"] = <
					text = <"a) når vedkommende er innlagt i en godkjent helseinstitusjon">
					description = <"*">
				>
				["at0087"] = <
					text = <"b) når vedkommende er under behandling og legen erklærer at behandlingen gjør det nødvendig at vedkommende ikke arbeider">
					description = <"*">
				>
				["at0088"] = <
					text = <"c) når vedkommende deltar på et arbeidsrettet tiltak">
					description = <"*">
				>
				["at0089"] = <
					text = <"d) når vedkommende på grunn av sykdom, skade eller lyte får tilskott til opplæringstiltak etter § 10-7 tredje ledd">
					description = <"*">
				>
				["at0090"] = <
					text = <"e) når vedkommende er til nødvendig kontrollundersøkelse som krever minst 24 timers fravær, reisetid medregnet">
					description = <"*">
				>
				["at0091"] = <
					text = <"f) når vedkommende myndighet har nedlagt forbud mot at han eller hun arbeider på grunn av smittefare">
					description = <"*">
				>
				["at0092"] = <
					text = <"g) når vedkommende er arbeidsufør som følge av svangerskapsavbrudd">
					description = <"*">
				>
				["at0093"] = <
					text = <"h) når vedkommende er arbeidsufør som følge av behandling for barnløshet">
					description = <"*">
				>
				["at0094"] = <
					text = <"i) når vedkommende er donor eller er under vurdering som donor">
					description = <"*">
				>
				["at0095"] = <
					text = <"j) når vedkommende er arbeidsufør som følge av behandling i forbindelse med sterilisering">
					description = <"*">
				>
				["at0096"] = <
					text = <"Helsetilstanden hindrer pasienten i å være i aktivitet">
					description = <"*">
				>
				["at0097"] = <
					text = <"Aktivitet vil forverre helsetilstanden">
					description = <"*">
				>
				["at0098"] = <
					text = <"Aktivitet vil hindre/forsinke bedring av helsetilstanden">
					description = <"*">
				>
				["at0099"] = <
					text = <"Annet">
					description = <"*">
				>
				["at0100"] = <
					text = <"Manglende tilrettelegging på arbeidsplassen">
					description = <"*">
				>
				["at0101"] = <
					text = <"Annet">
					description = <"*">
				>
				["at0104"] = <
					text = <"0 Når startet det legemeldte fraværet?">
					description = <"Angi første legemeldte fraværsdag i dette sykefraværsløpet.">
				>
				["at0105"] = <
					text = <"4.1 Pasienten kan benytte avventende sykmelding">
					description = <"Angir om pasienten kan benytte avventende sykmelding.">
				>
				["at0106"] = <
					text = <"4.2 Pasienten kan være delvis i arbeid (gradert sykmelding)">
					description = <"Angir om pasienten kan være delvis i arbeid.">
				>
				["at0107"] = <
					text = <"4.3 Pasienten kan ikke være i arbeid (100 % sykmelding)">
					description = <"Angir om pasinten må være 100% sykmeldt.">
				>
				["at0108"] = <
					text = <"4.4 Pasienten kan ikke være i arbeid på behandlingsdager">
					description = <"Angir om pasienten ikke kan være i arbeid på behandlingsdager.">
				>
				["at0109"] = <
					text = <"4.5 Pasienten kan være i fullt arbeid ved bruk av reisetilskudd">
					description = <"Angir om pasienten kan være i fullt arbeid ved bruk av reisetilskudd.">
				>
				["at0110"] = <
					text = <"6.3.2 Beskriv pågående og planlagt henvisning, utredning og/eller behandling">
					description = <"Beskrivelse av pågående og planlagt henvisning, utredning og/eller behandling. Lar dette seg kombinere med delvis arbeid?">
					comment = <"Lar dette seg kombinere med delvis arbeid? Feltet vises uavhengig av diagnose på gitte tidspunkter i sykefraværsløpet. Regler for dette er definert i konfigurasjonsfilen for dynamiske regler. Dersom feltet vises, er utfylling obligatorisk">
				>
				["at0111"] = <
					text = <"5.1 Pasienten er 100% arbeidsfør etter denne perioden">
					description = <"Angir om pasienten er 100% arbeidsfør etter denne perioden.">
				>
				["at0112"] = <
					text = <"5.3.2 Når antar du å kunne gi tilbakemelding på dette?">
					description = <"Angir når sykmelder kan gi tilbakemelding på hvorvidt pasienten kan komme i arbeid. ">
				>
				["at0113"] = <
					text = <"7.3 Andre innspill til NAV">
					description = <"Beskrivelse av evt. andre innspill til NAV.">
				>
				["at0114"] = <
					text = <"11.2 Pasienten har ikke kunnet ivaret egne interesser. Begrunn">
					description = <"Begrunnelse for hvorfor pasienten ikke har kunnet ivareta egne interesser. ">
				>
				["at0115"] = <
					text = <"2 Arbeidsgiver">
					description = <"Arbeidsgiver relatert til denne sykmeldingen.">
				>
				["at0116"] = <
					text = <"2.1 Pasienten har:">
					description = <"Angir hvorvidt pasienten har en arbeidsgiver, eller om pasienten har en eller flere.">
				>
				["at0117"] = <
					text = <"2.2 Arbeidsgiver">
					description = <"Arbeidsgiver relatert til denne sykmeldingen.">
				>
				["at0118"] = <
					text = <"2.2 Arbeidsgiver for denne sykmeldingen">
					description = <"Angivelse av pasientens arbeidsgiver som sykmeldingen skal sendes til.">
				>
				["at0119"] = <
					text = <"2.3 Yrke/stilling for dette arbeidsforholdet">
					description = <"Angivelse av pasientens yrke eller stilling.">
				>
				["at0121"] = <
					text = <"Én arbeidsgiver">
					description = <"*">
				>
				["at0122"] = <
					text = <"Flere arbeidsgivere">
					description = <"*">
				>
				["at0123"] = <
					text = <"Ingen arbeidsgiver">
					description = <"*">
				>
				["at0124"] = <
					text = <"2.4 Stillingsprosent">
					description = <"Pasienten stillingsprosent ved den aktuelle arbeidsgiver.">
				>
				["at0125"] = <
					text = <"4.3.3 Medisinske årsaker hindrer arbeidsrelatert aktivitet">
					description = <"Angir om det er medisinske årsaker som hindrer arbeidsrelatert aktivitet.">
				>
				["at0126"] = <
					text = <"4.3.4 Forhold på arbeidsplassen vanskeliggjør arbeidsrelatert aktivitet">
					description = <"Angir om pasientens arbeidsplass vanskeliggjøring av arbrbeidsrelatert aktivitet. ">
				>
				["at0127"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0129"] = <
					text = <"Telefon">
					description = <"Telefonnummer hvor sykmelder kan kontaktes.">
				>
				["at0130"] = <
					text = <"Kontaktinfo sykmelder">
					description = <"Sykmelders kontaktinformasjon.">
					comment = <"Designet som et cluster med tanke på fremtidig utvidelse av hvordan sykmelder kan kontaktes. Normalt vil telefon kunne hentes fra det pasientadministrative systemet, men er lagt inn i arketypen for å gjøre det mulig å angi spesifikk kontaktinfo for denne sykmeldingen. ">
				>
			>
		>
	>
