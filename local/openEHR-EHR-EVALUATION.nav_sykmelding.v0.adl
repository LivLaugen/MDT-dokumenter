definition
	EVALUATION[at0000] matches {    -- Sykmelding
		data matches {
			ITEM_TREE[at0001] matches {    -- Tree
				items cardinality matches {2..*; unordered} matches {
					ELEMENT[at0104] matches {    -- 0 Når startet det legemeldte fraværet?
						value matches {
							DV_DATE matches {*}
						}
					}
					CLUSTER[at0115] occurrences matches {0..1} matches {    -- 2 Arbeidsgiver
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0116] occurrences matches {0..1} matches {    -- 2.1 Pasienten har:
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0121,    -- Én arbeidsgiver
											at0122,    -- Flere arbeidsgivere
											at0123]    -- Ingen arbeidsgiver
										}
									}
								}
							}
							CLUSTER[at0117] occurrences matches {0..*} matches {    -- 2.2 Arbeidsgiver
								items cardinality matches {1..*; unordered} matches {
									ELEMENT[at0118] occurrences matches {0..1} matches {    -- 2.2 Arbeidsgiver for denne sykmeldingen
										value matches {
											DV_TEXT matches {*}
										}
									}
									ELEMENT[at0119] occurrences matches {0..1} matches {    -- 2.3 Yrke/stilling for dette arbeidsforholdet
										value matches {
											DV_TEXT matches {*}
										}
									}
									ELEMENT[at0124] occurrences matches {0..1} matches {    -- 2.4 Stillingsprosent
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::507]>
												list = <
													["1"] = <
														units = <"%">
														magnitude = <|0.0..100.0|>
														precision = <|0|>
													>
												>
											>
										}
									}
								}
							}
						}
					}
					CLUSTER[at0002] occurrences matches {0..1} matches {    -- 3 Diagnose
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0011] occurrences matches {0..1} matches {    -- 3.1 Hoveddiagnose
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[ac0001]
										}
									}
								}
							}
							ELEMENT[at0012] occurrences matches {0..*} matches {    -- 3.2 Bidiagnoser
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[ac0002]
										}
									}
								}
							}
							CLUSTER[at0013] occurrences matches {0..1} matches {    -- 3.3 Annen lovfestet fraværsgrunn § 8-4, 3. ledd - oppgis hvis relevant
								items cardinality matches {1..*; unordered} matches {
									ELEMENT[at0014] occurrences matches {0..1} matches {    -- 3.3.1 Foreligger det annen fraværsgrunn, velg én årsak
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0086,    -- a) når vedkommende er innlagt i en godkjent helseinstitusjon
													at0087,    -- b) når vedkommende er under behandling og legen erklærer at behandlingen gjør det nødvendig at vedkommende ikke arbeider
													at0088,    -- c) når vedkommende deltar på et arbeidsrettet tiltak
													at0089,    -- d) når vedkommende på grunn av sykdom, skade eller lyte får tilskott til opplæringstiltak etter § 10-7 tredje ledd
													at0090,    -- e) når vedkommende er til nødvendig kontrollundersøkelse som krever minst 24 timers fravær, reisetid medregnet
													at0091,    -- f) når vedkommende myndighet har nedlagt forbud mot at han eller hun arbeider på grunn av smittefare
													at0092,    -- g) når vedkommende er arbeidsufør som følge av svangerskapsavbrudd
													at0093,    -- h) når vedkommende er arbeidsufør som følge av behandling for barnløshet
													at0094,    -- i) når vedkommende er donor eller er under vurdering som donor
													at0095]    -- j) når vedkommende er arbeidsufør som følge av behandling i forbindelse med sterilisering
												}
											}
										}
									}
									ELEMENT[at0015] occurrences matches {0..1} matches {    -- 3.3.2 Beskriv
										value matches {
											DV_TEXT matches {*}
										}
									}
								}
							}
