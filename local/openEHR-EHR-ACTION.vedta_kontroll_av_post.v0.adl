definition
	ACTION[at0000] matches {    -- Vedta kontroll av post
		ism_transition matches {
			ISM_TRANSITION[at0004] matches {    -- Pågående
				current_state matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[openehr::245]
						}
					}
				}
				careflow_step matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::at0004]    -- Pågående
						}
					}
				}
			}
			ISM_TRANSITION[at0003] matches {    -- Avsluttet
				current_state matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[openehr::532]
						}
					}
				}
				careflow_step matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::at0003]    -- Avsluttet
						}
					}
				}
			}
		}
		description matches {
			allow_archetype ITEM_TREE matches {
				include
					archetype_id/value matches {/openEHR-EHR-ITEM_TREE\.om_vedtak_om_kontroll_av_post(-[a-zA-Z0-9_]+)*\.v1/}
			}
		}
	}

