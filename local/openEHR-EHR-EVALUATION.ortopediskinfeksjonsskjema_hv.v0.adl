definition
	EVALUATION[at0000] matches {    -- Ortopedisk infeksjonsskjema
		data matches {
			ITEM_TREE[at0001] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..1} matches {    -- Aktuell innleggelse
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0003,    -- Primærinnleggelse
									at0004]    -- Reinnleggelse
								}
							}
						}
					}
					ELEMENT[at0005] occurrences matches {0..1} matches {    -- Tid for utfylling
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0006,    -- Utskrivelse
									at0007]    -- Kontroll
								}
							}
						}
					}
					CLUSTER[at0805] occurrences matches {0..1} matches {    -- Utskrivelse
						items cardinality matches {1..*; unordered} matches {
							CLUSTER[at0009] occurrences matches {0..1} matches {    -- Infeksjon/problemstilling
								items cardinality matches {1..*; unordered} matches {
									ELEMENT[at0010] occurrences matches {0..1} matches {    -- Tidligere operert
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0038,    -- Ja < 30 dager
													at0039,    -- Ja > 30 dager
													at0040]    -- Nei
												}
											}
										}
									}
									ELEMENT[at0011] occurrences matches {0..1} matches {    -- Type infeksjon
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0041,    -- Infisert protese
													at0042,    -- Infisert osteosyntese
													at0043,    -- Infeksjon etter skopi med implantat
													at0044,    -- Infeksjon etter skopi uten implantat
													at0045,    -- Osteomyelitt
													at0046,    -- Infisert margnagle
													at0047,    -- Septisk artritt
													at0048,    -- Post-operativ rygginfeksjon med implantat
													at0049,    -- Post-operativ rygginfeksjon uten implantat
													at0050,    -- Infisert pseudoartrose
													at0051,    -- Dyp bløtvevsinfeksjon (under fascien)
													at0052,    -- Overfladisk bløtvesvinfeksjon (over fascien)
													at0053,    -- Dyb abscess (under fascien)
													at0054,    -- Overfladisk abscess (over fascien)
													at0055,    -- Bløtvevsproblem
													at0056]    -- Annen spesifisert årsak til innleggelse
												}
											}
										}
									}
									ELEMENT[at0012] occurrences matches {0..1} matches {    -- Lokalisasjon
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0014,    -- Sternoklavikular ledd
													at0015,    -- Clavicula
													at0016,    -- Akromioklavikular
													at0017,    -- Scapula
													at0018,    -- Skulderledd
													at0019,    -- Overarm
													at0020,    -- Albueledd
													at0021,    -- Underarm
													at0022,    -- Håndledd
													at0023,    -- Håndrot
													at0024,    -- Hånd
													at0025,    -- Columna
													at0026,    -- Bekken
													at0027,    -- Hofteledd
													at0028,    -- Femur
													at0029,    -- Kneledd
													at0030,    -- Legg
													at0031,    -- Ankelledd
													at0032,    -- Calcaneus
													at0033,    -- Småledd fot
													at0034,    -- Mellomfot
													at0035,    -- Forfot
