											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0057,    -- Uventet positive peroperative prøver
													at0058,    -- Tidlig postoperativ (<4 uker)
													at0059,    -- Sen postoperativ (4-12 uker)
													at0060,    -- Kronisk postoperativ (>12 uker)
