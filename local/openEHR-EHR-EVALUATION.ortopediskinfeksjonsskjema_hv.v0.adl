											}
										}
									}
									ELEMENT[at0070] occurrences matches {0..1} matches {    -- Annen spesifisert
										value matches {
											DV_TEXT matches {*}
										}
									}
								}
							}
							CLUSTER[at0071] occurrences matches {0..1} matches {    -- CRP
