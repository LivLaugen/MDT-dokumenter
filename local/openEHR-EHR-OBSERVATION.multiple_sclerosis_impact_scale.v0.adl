definition
	OBSERVATION[at0000] matches {    -- Multiple Sclerosis Impact Scale (MSIS-29)
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					INTERVAL_EVENT[at0002] occurrences matches {0..*} matches {    -- Over the past two weeks
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									CLUSTER[at0004] occurrences matches {0..1} matches {    -- In the past two weeks, how much has your MS limited your ability to...
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at0005] occurrences matches {0..1} matches {    -- 1. Do physically demanding tasks?
												value matches {
													1|[local::at0037],
													2|[local::at0038],
													3|[local::at0039],
													4|[local::at0040],
													5|[local::at0041]
												}
											}
											ELEMENT[at0006] occurrences matches {0..1} matches {    -- 2. Grip things tightly (e.g. turning on taps)?
												value matches {
													1|[local::at0042],
													2|[local::at0043],
													3|[local::at0044],
													4|[local::at0045],
													5|[local::at0046]
												}
											}
											ELEMENT[at0007] occurrences matches {0..1} matches {    -- 3. Carry things?
												value matches {
													1|[local::at0047],
													2|[local::at0048],
													3|[local::at0049],
													4|[local::at0050],
													5|[local::at0051]
												}
											}
										}
									}
									CLUSTER[at0008] occurrences matches {0..1} matches {    -- In the past two weeks, how much have you been bothered by...
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at0009] occurrences matches {0..1} matches {    -- 4. Problems with your balance?
												value matches {
													1|[local::at0052],
													2|[local::at0053],
													3|[local::at0054],
													4|[local::at0055],
													5|[local::at0056]
												}
											}
											ELEMENT[at0010] occurrences matches {0..1} matches {    -- 5. Difficulties moving about indoors?
												value matches {
													1|[local::at0057],
													2|[local::at0058],
													3|[local::at0059],
													4|[local::at0060],
													5|[local::at0061]
												}
											}
											ELEMENT[at0011] occurrences matches {0..1} matches {    -- 6. Being clumsy?
												value matches {
													1|[local::at0062],
													2|[local::at0063],
													3|[local::at0064],
													4|[local::at0065],
													5|[local::at0066]
												}
											}
											ELEMENT[at0012] occurrences matches {0..1} matches {    -- 7. Stiffness?
												value matches {
													1|[local::at0067],
													2|[local::at0068],
													3|[local::at0069],
													4|[local::at0070],
													5|[local::at0071]
												}
											}
											ELEMENT[at0013] occurrences matches {0..1} matches {    -- 8. Heavy arms and/or legs?
												value matches {
													1|[local::at0072],
													2|[local::at0073],
													3|[local::at0074],
													4|[local::at0075],
													5|[local::at0076]
												}
											}
											ELEMENT[at0014] occurrences matches {0..1} matches {    -- 9. Tremor of your arms or legs?
												value matches {
													1|[local::at0077],
													2|[local::at0078],
													3|[local::at0079],
													4|[local::at0080],
													5|[local::at0081]
												}
											}
											ELEMENT[at0015] occurrences matches {0..1} matches {    -- 10. Spasms in your limbs?
												value matches {
													1|[local::at0082],
													2|[local::at0083],
													3|[local::at0084],
													4|[local::at0085],
													5|[local::at0086]
												}
											}
											ELEMENT[at0016] occurrences matches {0..1} matches {    -- 11. Your body not doing what you want it to do?
												value matches {
													1|[local::at0087],
													2|[local::at0088],
													3|[local::at0089],
													4|[local::at0090],
													5|[local::at0091]
												}
											}
											ELEMENT[at0017] occurrences matches {0..1} matches {    -- 12. Having to depend on others to do things for you?
												value matches {
													1|[local::at0092],
													2|[local::at0093],
													3|[local::at0094],
													4|[local::at0095],
													5|[local::at0096]
												}
											}
											ELEMENT[at0019] occurrences matches {0..1} matches {    -- 13. Limitations in your social and leisure activities at home?
												value matches {
													1|[local::at0097],
													2|[local::at0098],
													3|[local::at0099],
													4|[local::at0100],
													5|[local::at0101]
												}
											}
											ELEMENT[at0020] occurrences matches {0..1} matches {    -- 14. Being stuck at home more than you would like to be?
												value matches {
													1|[local::at0102],
													2|[local::at0103],
													3|[local::at0104],
													4|[local::at0105],
													5|[local::at0106]
												}
											}
											ELEMENT[at0021] occurrences matches {0..1} matches {    -- 15. Difficulties using your hands in everyday tasks?
												value matches {
													1|[local::at0107],
													2|[local::at0108],
													3|[local::at0109],
													4|[local::at0110],
													5|[local::at0111]
												}
											}
											ELEMENT[at0022] occurrences matches {0..1} matches {    -- 16. Having to cut down the amount of time you spent on work or other daily activities?
												value matches {
													1|[local::at0112],
													2|[local::at0113],
													3|[local::at0114],
													4|[local::at0115],
													5|[local::at0116]
												}
											}
											ELEMENT[at0023] occurrences matches {0..1} matches {    -- 17. Problems using transport (e.g. car, bus, train, taxi, etc.)?
												value matches {
													1|[local::at0117],
													2|[local::at0118],
													3|[local::at0119],
													4|[local::at0120],
													5|[local::at0121]
												}
											}
											ELEMENT[at0024] occurrences matches {0..1} matches {    -- 18. Taking longer to do things?
												value matches {
													1|[local::at0122],
													2|[local::at0123],
													3|[local::at0124],
													4|[local::at0125],
													5|[local::at0126]
												}
											}
											ELEMENT[at0025] occurrences matches {0..1} matches {    -- 19. Difficulty doing things spontaneously (e.g. going out on the spur of the moment)?
												value matches {
													1|[local::at0127],
													2|[local::at0128],
													3|[local::at0129],
													4|[local::at0130],
													5|[local::at0131]
												}
											}
											ELEMENT[at0026] occurrences matches {0..1} matches {    -- 20. Needing to go to the toilet urgently?
												value matches {
													1|[local::at0132],
													2|[local::at0133],
													3|[local::at0134],
													4|[local::at0135],
													5|[local::at0136]
												}
											}
											ELEMENT[at0027] occurrences matches {0..1} matches {    -- 21. Feeling unwell?
												value matches {
													1|[local::at0137],
													2|[local::at0138],
													3|[local::at0139],
													4|[local::at0140],
													5|[local::at0141]
												}
											}
											ELEMENT[at0028] occurrences matches {0..1} matches {    -- 22. Problems sleeping?
												value matches {
													1|[local::at0142],
													2|[local::at0143],
													3|[local::at0144],
													4|[local::at0145],
													5|[local::at0146]
												}
											}
											ELEMENT[at0029] occurrences matches {0..1} matches {    -- 23. Feeling mentally fatigued?
												value matches {
													1|[local::at0147],
													2|[local::at0148],
													3|[local::at0149],
													4|[local::at0150],
													5|[local::at0151]
												}
											}
											ELEMENT[at0030] occurrences matches {0..1} matches {    -- 24. Worries related to your MS?
												value matches {
													1|[local::at0152],
													2|[local::at0153],
													3|[local::at0154],
													4|[local::at0155],
													5|[local::at0156]
												}
											}
											ELEMENT[at0031] occurrences matches {0..1} matches {    -- 25. Feeling anxious or tense?
												value matches {
													1|[local::at0157],
													2|[local::at0158],
													3|[local::at0159],
													4|[local::at0160],
													5|[local::at0161]
												}
											}
											ELEMENT[at0032] occurrences matches {0..1} matches {    -- 26. Feeling irritable, impatient, or short tempered?
												value matches {
													1|[local::at0162],
													2|[local::at0163],
													3|[local::at0164],
													4|[local::at0165],
													5|[local::at0166]
												}
											}
											ELEMENT[at0033] occurrences matches {0..1} matches {    -- 27. Problems concentrating?
												value matches {
													1|[local::at0167],
													2|[local::at0168],
													3|[local::at0169],
													4|[local::at0170],
													5|[local::at0171]
												}
											}
											ELEMENT[at0034] occurrences matches {0..1} matches {    -- 28. Lack of confidence?
												value matches {
													1|[local::at0172],
													2|[local::at0173],
													3|[local::at0174],
													4|[local::at0175],
													5|[local::at0176]
												}
											}
											ELEMENT[at0035] occurrences matches {0..1} matches {    -- 29. Feeling depressed?
												value matches {
													1|[local::at0177],
													2|[local::at0178],
													3|[local::at0179],
													4|[local::at0180],
													5|[local::at0181]
												}
											}
											ELEMENT[at0184] occurrences matches {0..1} matches {    -- Physical sum score
												value matches {
													DV_COUNT matches {*}
												}
											}
											ELEMENT[at0185] occurrences matches {0..1} matches {    -- Psychological score
												value matches {
													DV_COUNT matches {*}
												}
											}
										}
									}
								}
							}
						}
						width matches {
							DV_DURATION matches {
								value matches {P2W}
							}
						}
					}
					EVENT[at0183] occurrences matches {0..*} matches {    -- Any event
						data matches {
							use_node ITEM_TREE /data[at0001]/events[at0002]/data[at0003]
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0036] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					allow_archetype CLUSTER[at0182] occurrences matches {0..*} matches {    -- Extension
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"Multiple Sclerosis Impact Scale (MSIS-29)">
					description = <"For å registrere pasientrapporterte svar på spørsmål som omhandler individets oppfatning av hvordan MS har virket inn på
dagliglivet i løpet av de siste to ukene">
				>
				["at0001"] = <
					text = <"History">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"I løpet av de siste to ukene">
					description = <"">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"I løpet av de siste to ukene, hvor mye har din MS begrenset din evne til å..">
					description = <"">
				>
				["at0005"] = <
					text = <"1. Gjøre fysisk krevende oppgaver?">
					description = <"">
				>
				["at0006"] = <
					text = <"2. Gripe fast rundt noe (f.eks. skru på en vannkran)?">
					description = <"">
				>
				["at0007"] = <
					text = <"3. Bære noe?">
					description = <"">
				>
				["at0008"] = <
					text = <"I løpet av de siste to ukene, hvor mye har du vært plaget av...">
					description = <"">
				>
				["at0009"] = <
					text = <"4. Problemer med balansen?">
					description = <"">
				>
				["at0010"] = <
					text = <"5. Vanskeligheter med å bevege deg rundt innendørs?">
					description = <"">
				>
				["at0011"] = <
					text = <"6. Å være klossete?">
					description = <"">
				>
				["at0012"] = <
					text = <"7. Stivhet?">
					description = <"">
				>
				["at0013"] = <
					text = <"8. Tunge armer og/eller bein?">
					description = <"">
				>
				["at0014"] = <
					text = <"9. Skjelving i armer og/eller bein?">
					description = <"">
				>
				["at0015"] = <
					text = <"10. Kramper (spasmer) i armer og/eller bein?">
					description = <"">
				>
				["at0016"] = <
					text = <"11. At kroppen ikke lystrer?">
					description = <"">
				>
				["at0017"] = <
					text = <"12. Å måtte være avhengig av at andre må gjøre ting for deg?">
					description = <"">
				>
				["at0019"] = <
					text = <"13. Begrensninger i sosiale aktiviteter og fritidsaktiviteter?">
					description = <"">
				>
				["at0020"] = <
					text = <"14. Å måtte oppholde deg hjemme mer enn du ønsker?">
					description = <"">
				>
				["at0021"] = <
					text = <"15. Vanskeligheter med å bruke hendene i daglige oppgaver?">
					description = <"">
				>
				["at0022"] = <
					text = <"16. Å måtte kutte ned på tiden som du ville ha brukt på arbeid eller andre daglige aktiviteter?">
					description = <"">
				>
				["at0023"] = <
					text = <"17. Problemer med å bruke offentlige transportmidler?">
					description = <"">
				>
				["at0024"] = <
					text = <"18. Å bruke lengre tid på å gjøre ting?">
					description = <"">
				>
				["at0025"] = <
					text = <"19. Vanskeligheter med å gjøre ting spontant (f.eks. gå ut helt impulsivt)?">
					description = <"">
				>
				["at0026"] = <
					text = <"20. Plutselig trang til å gå på toalettet?">
					description = <"">
				>
				["at0027"] = <
					text = <"21. Å føle deg uvel?">
					description = <"">
				>
				["at0028"] = <
					text = <"22. Problemer med å sove?">
					description = <"">
				>
				["at0029"] = <
					text = <"23. Å føle deg mentalt utmattet (fatigue)?">
					description = <"">
				>
				["at0030"] = <
					text = <"24. Bekymringer knyttet til din MS?">
					description = <"">
				>
				["at0031"] = <
					text = <"25. Å føle deg engstelig eller anspent?">
					description = <"">
				>
				["at0032"] = <
					text = <"26. Å føle deg irritabel, utålmodig eller hissig?">
					description = <"">
				>
				["at0033"] = <
					text = <"27. Konsentrasjonsproblemer?">
					description = <"">
				>
				["at0034"] = <
					text = <"28. Manglende selvtillit?">
					description = <"">
				>
				["at0035"] = <
					text = <"29. Å føle deg deprimert?">
					description = <"">
				>
				["at0036"] = <
					text = <"Item tree">
					description = <"@ internal @">
				>
				["at0037"] = <
					text = <"Ikke i det hele tatt">
					description = <"">
				>
				["at0038"] = <
					text = <"Litt">
					description = <"">
				>
				["at0039"] = <
					text = <"Moderat">
					description = <"">
				>
				["at0040"] = <
					text = <"Mye">
