				>
				["at0182"] = <
					text = <"Tilleggsinformasjon">
					description = <"Ytterligere informasjon som trengs for å kunne registrere lokalt definert innhold eller for å tilpasse til andre referansemodeller/formalismer.">
					comment = <"For eksempel lokale informasjonsbehov eller ytterligere metadata for å kunne tilpasse til tilsvarende konsepter i FHIR.">
				>
				["at0183"] = <
					text = <"Uspesifisert hendelse">
					description = <"Uspesifisert tidspunkt som kan defineres mer eksplisitt i en templat eller i en applikasjon.">
				>
				["at0184"] = <
					text = <"Fysisk sumskår">
					description = <"Summen av elementene fra 1-20.">
					comment = <"(Summen av elementene fra 1-20. -20) * 100/80.">
				>
				["at0185"] = <
					text = <"Psykisk sumskår">
					description = <"Summen av elmentene fra 21-29">
					comment = <"(Summen av elmentene fra 21-29. -9) * 100/36.">
				>
			>
		>
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Multiple Sclerosis Impact Scale (MSIS-29)">
					description = <"To record patient reported answers to questions  about the impact of MS on the individuals day-to-day life during the past two weeks.">
				>
				["at0001"] = <
					text = <"History">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Over the past two weeks">
					description = <"">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"In the past two weeks, how much has your MS limited your ability to...">
					description = <"">
				>
				["at0005"] = <
					text = <"1. Do physically demanding tasks?">
					description = <"">
				>
				["at0006"] = <
					text = <"2. Grip things tightly (e.g. turning on taps)?">
					description = <"">
				>
				["at0007"] = <
					text = <"3. Carry things?">
					description = <"">
				>
				["at0008"] = <
					text = <"In the past two weeks, how much have you been bothered by...">
					description = <"">
				>
				["at0009"] = <
					text = <"4. Problems with your balance?">
					description = <"">
				>
				["at0010"] = <
					text = <"5. Difficulties moving about indoors?">
					description = <"">
				>
				["at0011"] = <
					text = <"6. Being clumsy?">
					description = <"">
				>
				["at0012"] = <
					text = <"7. Stiffness?">
					description = <"">
				>
				["at0013"] = <
					text = <"8. Heavy arms and/or legs?">
					description = <"">
				>
				["at0014"] = <
					text = <"9. Tremor of your arms or legs?">
					description = <"">
				>
				["at0015"] = <
					text = <"10. Spasms in your limbs?">
					description = <"">
				>
				["at0016"] = <
					text = <"11. Your body not doing what you want it to do?">
					description = <"">
				>
				["at0017"] = <
					text = <"12. Having to depend on others to do things for you?">
					description = <"">
				>
				["at0019"] = <
					text = <"13. Limitations in your social and leisure activities at home?">
					description = <"">
				>
				["at0020"] = <
					text = <"14. Being stuck at home more than you would like to be?">
					description = <"">
				>
				["at0021"] = <
					text = <"15. Difficulties using your hands in everyday tasks?">
					description = <"">
				>
				["at0022"] = <
					text = <"16. Having to cut down the amount of time you spent on work or other daily activities?">
					description = <"">
				>
				["at0023"] = <
					text = <"17. Problems using transport (e.g. car, bus, train, taxi, etc.)?">
					description = <"">
				>
				["at0024"] = <
					text = <"18. Taking longer to do things?">
					description = <"">
				>
				["at0025"] = <
					text = <"19. Difficulty doing things spontaneously (e.g. going out on the spur of the moment)?">
					description = <"">
				>
				["at0026"] = <
					text = <"20. Needing to go to the toilet urgently?">
					description = <"">
				>
				["at0027"] = <
					text = <"21. Feeling unwell?">
					description = <"">
				>
				["at0028"] = <
					text = <"22. Problems sleeping?">
					description = <"">
				>
				["at0029"] = <
					text = <"23. Feeling mentally fatigued?">
					description = <"">
				>
				["at0030"] = <
					text = <"24. Worries related to your MS?">
					description = <"">
				>
				["at0031"] = <
					text = <"25. Feeling anxious or tense?">
					description = <"">
				>
				["at0032"] = <
					text = <"26. Feeling irritable, impatient, or short tempered?">
					description = <"">
				>
				["at0033"] = <
					text = <"27. Problems concentrating?">
					description = <"">
				>
				["at0034"] = <
					text = <"28. Lack of confidence?">
					description = <"">
				>
				["at0035"] = <
					text = <"29. Feeling depressed?">
					description = <"">
				>
				["at0036"] = <
					text = <"Item tree">
					description = <"@ internal @">
				>
				["at0037"] = <
					text = <"Not at all">
					description = <"">
				>
				["at0038"] = <
					text = <"A little">
