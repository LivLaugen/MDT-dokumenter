definition
	OBSERVATION[at0000] matches {    -- Timed balance
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0004] occurrences matches {0..1} matches {    -- Task
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0005,    -- Side-by-side stand
													at0006,    -- Semi-tandem stand
													at0007,    -- Tandem stand
													at0008,    -- Single leg stance right foot
													at0009,    -- Sitting
													at0039]    -- Single leg stance left foot
												}
											}
											DV_TEXT matches {*}
										}
									}
									ELEMENT[at0010] occurrences matches {0..1} matches {    -- Time
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::128]>
												list = <
													["1"] = <
														units = <"s">
														magnitude = <|>=0.0|>
														precision = <|2|>
													>
													["2"] = <
														units = <"min">
													>
												>
											>
										}
									}
									ELEMENT[at0029] occurrences matches {0..1} matches {    -- Clinical description
										value matches {
											DV_TEXT matches {*}
										}
									}
									ELEMENT[at0011] occurrences matches {0..1} matches {    -- Comment
										value matches {
											DV_TEXT matches {*}
										}
									}
								}
							}
						}
						state matches {
							ITEM_TREE[at0013] matches {    -- Item tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0024] occurrences matches {0..1} matches {    -- Confounding factors
										value matches {
											DV_TEXT matches {*}
										}
									}
									ELEMENT[at0026] occurrences matches {0..1} matches {    -- Eyes
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0027,    -- Open
													at0028]    -- Closed
												}
											}
										}
									}
									ELEMENT[at0018] occurrences matches {0..2} matches {    -- Assistive device
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0019,    -- Ankle-foot orthosis
													at0020,    -- Cane
													at0021,    -- Crutch
													at0022]    -- Walker/rollator
												}
											}
											DV_TEXT matches {*}
										}
									}
								}
							}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0012] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0031] occurrences matches {0..1} matches {    -- Surface
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0032,    -- Floor inside
									at0033,    -- Treadmill
									at0034,    -- Stairs
									at0035,    -- Running track
									at0036,    -- Road
									at0037,    -- Rough terrain
									at0038]    -- Foam pad
								}
							}
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0023] occurrences matches {0..1} matches {    -- Specific protocol
						value matches {
							DV_TEXT matches {*}
						}
					}
					allow_archetype CLUSTER[at0025] occurrences matches {0..1} matches {    -- Extension
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Timed balance">
					description = <"The time used to execute a defined balance task.">
				>
				["at0001"] = <
					text = <"History">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Any event">
					description = <"">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"Task">
					description = <"The specific task executed during the test.">
					comment = <"Coding of the 'Task' with a terminology is preferred, where possible.
For example: side-by-side stand, semi-tandem stand, tandem stand, single leg stance, sitting, etc.">
				>
				["at0005"] = <
					text = <"Side-by-side stand">
					description = <"">
				>
				["at0006"] = <
					text = <"Semi-tandem stand">
					description = <"">
				>
				["at0007"] = <
					text = <"Tandem stand">
					description = <"">
