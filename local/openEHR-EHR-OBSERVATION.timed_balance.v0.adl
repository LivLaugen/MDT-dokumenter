archetype (adl_version=1.4; uid=a4e62c66-0b5c-44f6-aeb7-501754b8f30c)
	openEHR-EHR-OBSERVATION.timed_balance.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::en]>

description
	original_author = <
		["date"] = <"2022-08-10">
		["name"] = <"Kanika Kuwelker">
		["organisation"] = <"Helse Vest IKT">
		["email"] = <"kanika.kuwelker@helse-vest-ikt.no">
	>
	lifecycle_state = <"in_development">
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the time used to execute a defined balance task.">
			keywords = <"balance, static postural stability", ...>
			copyright = <"© Nasjonal IKT HF">
			use = <"Use to record the time used to execute a defined balance task.">
