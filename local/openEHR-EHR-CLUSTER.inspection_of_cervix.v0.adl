definition
	CLUSTER[at0000] matches {    -- Inspeksjon av cervix
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Beskrivelse
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- Utflod
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0003,    -- Tilstede
							at0004]    -- Fraværende
						}
					}
				}
			}
			ELEMENT[at0005] occurrences matches {0..1} matches {    -- Utseende av utflod
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0006,    -- Klar
							at0007,    -- Mucopurulent
							at0008,    -- Mursteinsfarget
							at0009]    -- Friskt blødende
						}
					}
				}
			}
			ELEMENT[at0010] occurrences matches {0..1} matches {    -- Ektopi
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0011,    -- Tilstede
							at0012]    -- Fraværende
						}
					}
				}
			}
			ELEMENT[at0014] occurrences matches {0..1} matches {    -- Ektopi beskrivelse
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0013] occurrences matches {0..1} matches {    -- Multimedia
				value matches {
					DV_MULTIMEDIA matches {
						media_type matches {
							[openEHR::
							425,
							426,
							427,
							428,
							429,
							401,
							402,
							404,
							405,
							406,
							407,
							414]
						}
					}
				}
			}
			CLUSTER[at0015] occurrences matches {0..*} matches {    -- Andre funn cervix
				items cardinality matches {1..*; unordered} matches {
					ELEMENT[at0016] occurrences matches {0..1} matches {    -- Funn
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0017,    -- Vorter
									at0019,    -- Skjør
									at0020,    -- Tumor
									at0021,    -- Nabothian cyste
									at0023]    -- Annet
								}
							}
						}
					}
					ELEMENT[at0022] occurrences matches {0..1} matches {    -- Detaljert beskrivelse av funn
						value matches {
							DV_TEXT matches {*}
						}
					}
				}
			}
		}
	}

