description
	original_author = <
		["date"] = <"2015-10-20">
		["name"] = <"Arne Løberg Sæter">
		["organisation"] = <"DIPS ASA">
		["email"] = <"asa@dips.no">
	>
	lifecycle_state = <"in_development">
	details = <
		["nb"] = <
			language = <[ISO_639-1::nb]>
			purpose = <"Brukes for å registrere detaljer om naturlige funksjoner hos et individ.">
			keywords = <"Spising, avføring, vannlating, urinering, tissing", ...>
			copyright = <"© Nasjonal IKT HF">
			use = <"Brukes for å registrere detaljer om naturlige funksjoner hos et individ, som matinntak og eliminasjon. Arketypen kan forventes å endres etter hvert som behovet blir klarere.

Arketypen kan brukes til f.eks registrere tidspunkt for siste vannlating, som har betydning for kvaliteten på en urinprøve. Eller når individet sist spiste, som har betydning for f.eks operativ vurdering.">
			misuse = <"Mangler eksempler på feil bruk per nå.">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"Use to register details on natural body functions in an individ.">
			copyright = <"© Nasjonal IKT HF">
			use = <"Use to register details on natural body functions in an individ, as eating and elimination. The archetype may be altered along with better understanding of the needs.

The archetype can be used to record e.g. the time of last voided urine, which can be used to evaluate the quality of an urine sample, or the time the individ last ate.">
			misuse = <"Not yet identified.">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"Nasjonal IKT">
		["original_namespace"] = <"no.nasjonalikt">
		["original_publisher"] = <"Nasjonal IKT">
		["custodian_namespace"] = <"no.nasjonalikt">
		["MD5-CAM-1.0.1"] = <"6A966FE0B9961CFC37760303EC62F25E">
		["build_uid"] = <"6176d4f6-8425-486a-9c9c-9b696aa12d79">
		["revision"] = <"0.0.1-alpha">
	>

definition
	CLUSTER[at0000] matches {    -- Reported body functions
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- Laste ate
				value matches {
					DV_DATE_TIME matches {*}
				}
			}
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- Last drank
				value matches {
					DV_DATE_TIME matches {*}
				}
			}
			ELEMENT[at0004] occurrences matches {0..1} matches {    -- Last opened bowels
				value matches {
					DV_DATE_TIME matches {*}
				}
			}
			ELEMENT[at0005] occurrences matches {0..1} matches {    -- Last voided urine
				value matches {
					DV_DATE_TIME matches {*}
				}
			}
			ELEMENT[at0006] occurrences matches {0..1} matches {    -- Hours since last voided urine
				value matches {
					DV_COUNT matches {*}
				}
			}
		}
	}

ontology
	term_definitions = <
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"Naturlige funksjoner">
					description = <"En oversikt over et individs naturlige funksjoner, som matinntak og eliminasjon.">
				>
				["at0002"] = <
					text = <"Sist spist">
					description = <"Tidspunkt individet sist spiste.">
				>
				["at0003"] = <
					text = <"Sist drukket">
					description = <"Tidspunkt individet sist drakk.">
				>
				["at0004"] = <
					text = <"Siste avføring">
					description = <"Tidspunkt individet sist hadde avføring.">
				>
				["at0005"] = <
					text = <"Siste vannlating">
					description = <"Tidspunkt individet sist hadde vannlating.">
				>
				["at0006"] = <
					text = <"Timer siden siste vannlating">
					description = <"Antall timer siden pasienten sist hadde vannlating.">
					comment = <"Dette elementet vil i de fleste tilfeller kunne beregnes av programvare som mottar tidspunkt individet sist hadde vannlating.">
				>
			>
		>
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Reported body functions">
					description = <"An overview of an individuals body functions, e.g. eating and elimination.">
				>
				["at0002"] = <
					text = <"Laste ate">
					description = <"The time the individ last ate.">
				>
				["at0003"] = <
					text = <"Last drank">
					description = <"The time the individ last drank.">
				>
				["at0004"] = <
					text = <"Last opened bowels">
					description = <"The time the individ last opened bowels.">
				>
				["at0005"] = <
					text = <"Last voided urine">
					description = <"The time the individ last voided urine.">
				>
				["at0006"] = <
					text = <"Hours since last voided urine">
					description = <"Number of hours since the individ last voided urine.">
				>
			>
		>
	>
