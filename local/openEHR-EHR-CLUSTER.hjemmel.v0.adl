					text = <"2-1	Frivillig psykisk helsevern. Psykisk helsevernloven  2-1.">
					description = <"">
				>
				["at0003"] = <
					text = <"2-1	Representert samtykke, jf. psykisk helsevernloven  2-1, jf. pasientrettighetsloven kapittel 4">
					description = <"">
				>
				["at0004"] = <
					text = <"2-2	Samtykke til å være undergitt reglene om tvungent psykisk helsevern i  3 5. Psykisk helsevernloven  2-2.">
