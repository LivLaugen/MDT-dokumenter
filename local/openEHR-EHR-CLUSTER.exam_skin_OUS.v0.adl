definition
	CLUSTER[at0000] matches {    -- Exam skin
		items cardinality matches {1..*; unordered} matches {
			CLUSTER[at0004] occurrences matches {0..*} matches {    -- Hudfunn
				items cardinality matches {1..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..1} matches {    -- Funn
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0005] occurrences matches {0..1} matches {    -- Grad
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0006] occurrences matches {0..1} matches {    -- Beskriv
						value matches {
							DV_TEXT matches {*}
						}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"Exam skin">
					description = <"For å registrere funn ved fysisk undersøkelse av et invidids hud. Foreløpig arketyope som ble tatt i bruk ved Olafaiaklinikken, OUS i november 2015.">
				>
				["at0002"] = <
					text = <"Funn">
					description = <"Type funn.">
					comment = <"F.eks vorter, sår, etc.">
				>
				["at0004"] = <
					text = <"Hudfunn">
					description = <"Funn ved fysisk undersøkelse av hud.">
				>
				["at0005"] = <
					text = <"Grad">
					description = <"Gradering av funn.">
					comment = <"Bruk gjerne terminologi eller et verdisett i templat.">
				>
				["at0006"] = <
					text = <"Beskriv">
					description = <"Beskrivelse av hudfunn.">
				>
			>
		>
	>
