definition
	CLUSTER[at0000] matches {    -- Foreldre
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0004] occurrences matches {0..1} matches {    -- Fødselsdato
				value matches {
					DV_DATE_TIME matches {*}
				}
			}
			ELEMENT[at0005] occurrences matches {0..1} matches {    -- Navn
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0006] occurrences matches {0..1} matches {    -- Død
				value matches {
					DV_BOOLEAN matches {*}
				}
			}
			ELEMENT[at0007] occurrences matches {0..1} matches {    -- Foreldrerett
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0008,    -- Ja
							at0009]    -- Nei
						}
					}
				}
			}
			ELEMENT[at0010] occurrences matches {0..1} matches {    -- Rolle
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0011,    -- Mor
							at0012,    -- Far
							at0013,    -- Stemor
							at0014,    -- Stefar
							at0015,    -- Fostermor
							at0016,    -- Fosterfar
							at0017]    -- Medmor
						}
					}
				}
			}
		}
	}

