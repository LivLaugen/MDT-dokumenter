description
	original_author = <
		["date"] = <"2022-10-24">
		["name"] = <"John Tore Valand">
		["organisation"] = <"Helse Vest IKT AS">
		["email"] = <"john.tore.valand@helse-vest-ikt.no">
	>
	lifecycle_state = <"in_development">
	details = <
		["nb"] = <
			language = <[ISO_639-1::nb]>
			purpose = <"For å registrere rotasjonsvinkel av trunkus.">
			keywords = <"skoliose, assymetri, ribbebue, trunkus, rotasjon, skoliometer, scoliometer, adams forward bend test, gibbus", ...>
			copyright = <"© openEHR Foundation, Nasjonal IKT HF">
			use = <"Brukes for å registrere rotasjonsvinkel av trunkus.

For å vurdere en vinkel på trunkusrotasjon mens pasienten er i en foroverbøyd stilling.

Denne arketypen har vært designet spesifikt for å kunne brukes i SLOT'et \"Undersøkelsesdetaljer\" i arketypen OBSERVATION.exam (Funn ved fysisk undersøkelse), CLUSTER.exam-spine, CLUSTER.exam-cervical_spine, CLUSTER.exam-thoracic_spine, CLUSTER._exam-lumbal_spine eller i SLOT'et \"Prosedyredetaljer\" i arketypen ACTION.procedure (Prosedyre), men kan også bli brukt i andre ENTRY- eller CLUSTER-arketyper der det er klinisk passende.

Detaljer om kroppsstilling eller utstyr som brukes til å måle vinkelen skal registreres i OBSERVATION.exam eller i andre relevante ENTRY-arketyper.">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record an angle of trunk rotation.">
			keywords = <"scoliosis, assymetry, rib arch, trunk, rotation, scoliometer, adams forward bend test, gibbus", ...>
			copyright = <"© openEHR Foundation, Nasjonal IKT HF">
			use = <"Use to record an angle of trunk rotation.

To assess an angle of trunk rotation while the patient is a forward bending position. 

This archetype is designed to be nested within the 'Examination findings' SLOT in the OBSERVATION.exam, CLUSTER.exam-spine, CLUSTER.exam-cervical_spine, CLUSTER.exam-thoracic_spine, CLUSTER._exam-lumbal_spine or within other relevant CLUSTER.exam archetypes, but can also be used within other ENTRY or CLUSTER archetypes, where clinically appropriate.

Details about body postion or devices used to measure the angle is to be recorded in OBSERVATION.exam or in other relevant ENTRY archetypes.">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"Nasjonal IKT">
		["references"] = <"https://www.sciencedirect.com/topics/medicine-and-dentistry/scoliometer

https://www.scoliosisreductioncenter.com/blog/scoliometer

https://surgeryreference.aofoundation.org/spine/deformities/adolescent-idiopathic-scoliosis/further-reading/patient-examination#physical-examination

https://ehandboken.ous-hf.no/document/137393

https://metodebok.no/index.php?action=topic&item=CKiyzqd4">
		["original_namespace"] = <"no.nasjonalikt">
		["original_publisher"] = <"Nasjonal IKT">
		["custodian_namespace"] = <"no.nasjonalikt">
		["MD5-CAM-1.0.1"] = <"BFD39AEC7DF63EDA6DE528174D5F393E">
		["build_uid"] = <"3dea9a6c-33a5-4cd6-8fd5-28194860ee76">
		["revision"] = <"0.0.1-alpha">
	>

definition
	CLUSTER[at0000] matches {    -- Trunk rotation angle
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Location
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- Angle
				value matches {
					C_DV_QUANTITY <
						property = <[openehr::497]>
						list = <
							["1"] = <
								units = <"deg">
								precision = <|0|>
							>
						>
					>
				}
			}
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- Comment
				value matches {
					DV_TEXT matches {*}
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Trunk rotation angle">
					description = <"A measurement to assess an angle of trunk rotation.">
				>
				["at0001"] = <
					text = <"Location">
					description = <"The anatomical location of maximum deformity.">
					comment = <"Coding of the 'Location' with a terminology is preferred, where possible.">
				>
				["at0002"] = <
					text = <"Angle">
					description = <"Measured angle of the rotation of the trunk.">
				>
				["at0003"] = <
					text = <"Comment">
					description = <"Additional narrative about the trunk rotation angle measurement, not captured in other fields.">
				>
			>
		>
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"Rotasjonsvinkel av trunkus">
					description = <"Måling for å vurdere rotasjonsvinkel av trunkus.">
				>
				["at0001"] = <
					text = <"Lokalisering">
					description = <"Den anatomiske plasseringen av maksimal deformitet.">
					comment = <"Koding av \"Lokalisering\" med en terminologi er foretrukket, der det er mulig.">
				>
				["at0002"] = <
					text = <"Vinkel">
					description = <"Målt vinkel for rotasjon av trunkus.">
				>
				["at0003"] = <
					text = <"Kommentar">
					description = <"Ytterigere fritekst om måling av rotasjonsvinkel av trunkus som ikke er registrert i andre felt.">
				>
			>
		>
	>
