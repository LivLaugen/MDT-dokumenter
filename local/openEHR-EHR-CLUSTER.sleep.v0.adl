definition
	CLUSTER[at0000] matches {    -- Søvn
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Uten anmerkning?
				value matches {
					DV_BOOLEAN matches {*}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- Beskrivelse
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- Antall timer søvn per natt
				value matches {
					C_DV_QUANTITY <
						property = <[openehr::128]>
						list = <
							["1"] = <
								units = <"h">
								magnitude = <|0.0..24.0|>
							>
						>
					>
				}
			}
			ELEMENT[at0005] occurrences matches {0..1} matches {    -- Unormal søvnkvalitet?
				value matches {
					DV_BOOLEAN matches {*}
				}
			}
			ELEMENT[at0004] occurrences matches {0..1} matches {    -- Søvnkvalitet detaljer
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0006] occurrences matches {0..1} matches {    -- Antall ganger våken per natt
				value matches {
					DV_QUANTITY matches {*}
				}
			}
			ELEMENT[at0007] occurrences matches {0..1} matches {    -- Er ikke uthvilt om morgenen?
				value matches {
					DV_BOOLEAN matches {*}
				}
			}
			ELEMENT[at0008] occurrences matches {0..1} matches {    -- Uthvilthet detaljer
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0010] occurrences matches {0..1} matches {    -- Drømmer detaljer
				value matches {
					DV_TEXT matches {*}
				}
			}
		}
	}

ontology
	term_definitions = <
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"Søvn">
					description = <"Beskrivelse av søvn som en naturlig funksjon. Opptrer normalt som en del av angivelse av naturlige funksjoner.">
				>
				["at0001"] = <
					text = <"Uten anmerkning?">
					description = <"Om søvn er uten anmerkning, dvs. formodet normal.">
				>
				["at0002"] = <
					text = <"Beskrivelse">
					description = <"Fritekst beskrivelse av søvn. Brukes der mer detaljerte stukturering ikke er egnet, og ved registrering av informasjon som ikke passer med detaljeringen.">
				>
				["at0003"] = <
					text = <"Antall timer søvn per natt">
					description = <"Estimert gjennomsnittlig antall timer per natt.">
				>
				["at0004"] = <
					text = <"Søvnkvalitet detaljer">
					description = <"*">
				>
				["at0005"] = <
					text = <"Unormal søvnkvalitet?">
					description = <"*">
				>
				["at0006"] = <
					text = <"Antall ganger våken per natt">
					description = <"*">
				>
				["at0007"] = <
					text = <"Er ikke uthvilt om morgenen?">
					description = <"*">
					comment = <"Bør kanskje erstattes med en skala med uthvilt - delvis uthvilt - ikke utvhilt om morgenen.">
				>
				["at0008"] = <
					text = <"Uthvilthet detaljer">
					description = <"*">
				>
				["at0010"] = <
					text = <"Drømmer detaljer">
					description = <"*">
				>
			>
		>
	>
