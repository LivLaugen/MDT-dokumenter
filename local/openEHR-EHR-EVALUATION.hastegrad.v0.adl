definition
	EVALUATION[at0000] matches {    -- Hastegrad
		data matches {
			ITEM_TREE[at0001] matches {    -- Tree
				items cardinality matches {1..*; unordered} matches {
					ELEMENT[at0002] matches {    -- Hastegrad
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0003,    -- Elektiv
									at0004,    -- Akutt pga obstruksjon
									at0005,    -- Akutt pga perforasjon
									at0006,    -- Akutt pga annet
									at0007]    -- Ukjent
								}
							}
						}
					}
					ELEMENT[at0008] occurrences matches {0..1} matches {    -- Spesifiser hastegrad
						value matches {
							DV_TEXT matches {*}
						}
					}
				}
			}
		}
	}

