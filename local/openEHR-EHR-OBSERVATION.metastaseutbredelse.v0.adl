definition
	OBSERVATION[at0000] matches {    -- Metastaseutbredelse
		data matches {
			HISTORY[at0001] matches {    -- Event Series
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..1} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0023] occurrences matches {0..1} matches {    -- IngenFjernmet
										value matches {
											DV_BOOLEAN matches {*}
										}
									}
									ELEMENT[at0024] occurrences matches {0..1} matches {    -- Skjelettmet
										value matches {
											DV_BOOLEAN matches {*}
										}
									}
									ELEMENT[at0025] occurrences matches {0..1} matches {    -- Levermet
										value matches {
											DV_BOOLEAN matches {*}
										}
									}
									ELEMENT[at0027] occurrences matches {0..1} matches {    -- Lungemet
										value matches {
											DV_BOOLEAN matches {*}
										}
									}
									ELEMENT[at0026] occurrences matches {0..1} matches {    -- Hjernemet
										value matches {
											DV_BOOLEAN matches {*}
										}
									}
									ELEMENT[at0028] occurrences matches {0..1} matches {    -- Bekkenmet
										value matches {
											DV_BOOLEAN matches {*}
										}
									}
									ELEMENT[at0029] occurrences matches {0..1} matches {    -- UtenforBekkenmet
										value matches {
											DV_BOOLEAN matches {*}
										}
									}
									ELEMENT[at0064] occurrences matches {0..1} matches {    -- Peritoneummet
										value matches {
											DV_BOOLEAN matches {*}
										}
									}
									ELEMENT[at0065] occurrences matches {0..1} matches {    -- Hudmet
										value matches {
											DV_BOOLEAN matches {*}
										}
									}
									ELEMENT[at0030] occurrences matches {0..1} matches {    -- AnnetFjernmet
										value matches {
											DV_BOOLEAN matches {*}
										}
									}
									ELEMENT[at0031] occurrences matches {0..1} matches {    -- AnnetFjernmetSpesifiser
										value matches {
											DV_TEXT matches {*}
										}
									}
									ELEMENT[at0034] occurrences matches {0..1} matches {    -- StorrelseFjernmet
										value matches {
											C_DV_QUANTITY <
												property = <[openehr::497]>
												list = <
													["1"] = <
														units = <"'">
														magnitude = <|0.0..999.9|>
														precision = <|1|>
													>
												>
											>
										}
									}
									ELEMENT[at0033] occurrences matches {0..1} matches {    -- FjernmetUkjent
										value matches {
											DV_TEXT matches {*}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

