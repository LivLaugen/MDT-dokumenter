					description = <"">
				>
				["at0005"] = <
					text = <"Nærmeste pårørende informeres om vedtaket og sin klageadgang; Nærmeste pårørende informeres ikke, da denne ikke har kjent adresse og ettersporing vil kreve urimelig mye tid eller arbeid">
					description = <"">
				>
				["at0006"] = <
