	details = <
		["nn"] = <
			language = <[ISO_639-1::nn]>
			purpose = <"*To record details about a simple selection list where a question may be recorded as either \"present\" or \"indeterminate\". (en)">
			copyright = <"© openEHR Foundation, Nasjonal IKT HF">
			use = <"*Use to record details about a simple selection list where a question may be recorded as either \"present\" or \"indeterminate\". (en)">
			misuse = <"*Not to be used to create a framework for recording answers to pre-defined screening questions. (en)">
		>
		["nb"] = <
			language = <[ISO_639-1::nb]>
			purpose = <"For å registrere detaljer om en enkel utvalgsliste der et spørsmål kan registreres som enten \"tilstede\" eller \"ubestemt\".">
			copyright = <"© openEHR Foundation, Nasjonal IKT HF">
			use = <"For å registrere detaljer om en enkel utvalgsliste der et spørsmål kan registreres som enten \"tilstede\" eller \"ubestemt\".">
			misuse = <"Brukes ikke for å lage et rammeverk for registrering av svar på forhåndsdefinerte spørsmål.">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record details about a simple selection list where a question may be recorded as either \"present\" or \"indeterminate\".">
			copyright = <"© openEHR Foundation, Nasjonal IKT HF">
			use = <"Use to record details about a simple selection list where a question may be recorded as either \"present\" or \"indeterminate\".">
			misuse = <"Not to be used to create a framework for recording answers to pre-defined screening questions.">
