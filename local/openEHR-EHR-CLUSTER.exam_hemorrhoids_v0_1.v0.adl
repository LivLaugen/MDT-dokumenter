archetype (adl_version=1.4; uid=e321315e-026d-48c8-824e-616c30254957)
	openEHR-EHR-CLUSTER.exam_hemorrhoids_v0_1.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::en]>

description
	original_author = <
		["date"] = <"2015-06-08">
		["name"] = <"Hallvard Lærum">
		["organisation"] = <"Oslo Universitetssykehus HF">
		["email"] = <"hallaeru@online.no">
	>
	lifecycle_state = <"in_development">
	other_contributors = <"Vebjørn Arntzen, Oslo University Hospital, Norway","Morten Aas, Oslo University Hospital, Norway">
	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"For recording a narrative description and clinical interpretation of the findings observed during the physical examination of hemorrhoids.">
			copyright = <"© openEHR Foundation">
			use = <"This archetype is designed to be used in the \"Examination findings\" SLOT within the OBSERVATION.exam archetype, but can also be used within other OBSERVATION or CLUSTER archetypes, where clinically appropriate - for example, CLUSTER.exam_anus.

The CLUSTER.exclusion_exam archetype can be nested within the 'Examination not done' SLOT to optionally record explicit details about the examination not being performed.

Use to incorporate the narrative descriptions of clinical findings within existing or legacy clinical systems into an archetyped format, using the 'Clinical Description' data element.">
			misuse = <"Not to be used for recording data not related to hemorrhoids.

Not to be used for recording the clinical history - use specific OBSERVATION and CLUSTER archetypes. For example OBSERVATION.story and CLUSTER.symptom.

Not to be used to record stand-alone clinical observations or measurements or test results - use specific OBSERVATION archetypes. For example OBSERVATION.blood_pressure or OBSERVATION.imaging_exam.">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 3.0 License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/3.0/.">
		["custodian_organisation"] = <"openEHR Foundation">
		["original_namespace"] = <"org.openehr">
		["original_publisher"] = <"openEHR Foundation">
		["custodian_namespace"] = <"org.openehr">
		["MD5-CAM-1.0.1"] = <"B3EAA3B0AF0BECFBF56AD33A506ED4E5">
		["build_uid"] = <"4fd3f3e5-ce69-4d48-b2bc-90d083ccd0f4">
		["revision"] = <"0.0.1-alpha">
	>

definition
	CLUSTER[at0000] matches {    -- Examination of hemorrhoids
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Present?
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0011,    -- Present
							at0012,    -- Absent
							at0013]    -- Undetermined
						}
					}
				}
			}
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- Clinical description
				value matches {
					DV_TEXT matches {*}
				}
			}
			allow_archetype CLUSTER[at0005] occurrences matches {0..*} matches {    -- Multimedia representation
				include
					archetype_id/value matches {/openEHR-EHR-CLUSTER\.multimedia(-[a-zA-Z0-9_]+)*\.v1/}
			}
			ELEMENT[at0016] occurrences matches {0..1} matches {    -- Quantity
				value matches {
					DV_COUNT matches {
						magnitude matches {|0..100|}
					}
				}
			}
			CLUSTER[at0014] occurrences matches {0..*} matches {    -- Appearance
				items cardinality matches {1..*; unordered} matches {
					ELEMENT[at0015] occurrences matches {0..1} matches {    -- Alias
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0018] occurrences matches {0..1} matches {    -- Location
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0019,    -- External
									at0020,    -- Internal
									at0021]    -- Mixed
								}
							}
						}
					}
					allow_archetype CLUSTER[at0017] occurrences matches {0..*} matches {    -- Detailed location
						include
							archetype_id/value matches {/openEHR-EHR-CLUSTER\.anatomical_location_relative(-[a-zA-Z0-9_]+)*\.v1|openEHR-EHR-CLUSTER\.anatomical_location_clock(-[a-zA-Z0-9_]+)*\.v0/}
					}
					ELEMENT[at0022] occurrences matches {0..1} matches {    -- Shape
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0023] occurrences matches {0..1} matches {    -- Grade
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0024] occurrences matches {0..1} matches {    -- Sharp classification
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0025,    -- I pale
									at0026,    -- II moderate
									at0027,    -- III Severe
									at0028]    -- IV Necrotic
								}
							}
						}
					}
					ELEMENT[at0029] occurrences matches {0..1} matches {    -- Bleeding
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0030] occurrences matches {0..1} matches {    -- Tenderness
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0032] occurrences matches {0..1} matches {    -- Degree of prolapse
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0033,    -- Grade I
									at0034,    -- Grade II
									at0035,    -- Grade III
									at0036]    -- Grade IV
								}
							}
						}
					}
				}
			}
			allow_archetype CLUSTER[at0004] occurrences matches {0..*} matches {    -- Examination findings
				include
					archetype_id/value matches {/.*/}
			}
			ELEMENT[at0006] occurrences matches {0..*} matches {    -- Clinical interpretation
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0007] occurrences matches {0..1} matches {    -- Comment
				value matches {
					DV_TEXT matches {*}
				}
			}
			allow_archetype CLUSTER[at0008] occurrences matches {0..*} matches {    -- Examination not done
				include
					archetype_id/value matches {/openEHR-EHR-CLUSTER\.exclusion_exam(-[a-zA-Z0-9_]+)*\.v1/}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Examination of hemorrhoids">
					description = <"Findings observed during the physical examination of hemorrhoids.">
				>
				["at0001"] = <
					text = <"Present?">
					description = <"Whether there are found hemorrhoids during examination">
				>
				["at0003"] = <
					text = <"Clinical description">
					description = <"Narrative description of the overall findings observed during the physical examination.">
				>
				["at0004"] = <
					text = <"Examination findings">
					description = <"Structured details about the  physical examination findings.">
				>
				["at0005"] = <
					text = <"Multimedia representation">
					description = <"Digital image, video or diagram representing the physical examination findings.">
				>
				["at0006"] = <
					text = <"Clinical interpretation">
					description = <"Single word, phrase or brief description that represents the clinical meaning and significance of the physical examination findings.">
				>
				["at0007"] = <
					text = <"Comment">
					description = <"Additional narrative about the physical examination findings, not captured in other fields.">
				>
				["at0008"] = <
					text = <"Examination not done">
					description = <"Details to explicitly record that this examination was not performed.">
				>
				["at0011"] = <
					text = <"Present">
					description = <"There were found hemorrhoids">
				>
				["at0012"] = <
					text = <"Absent">
					description = <"No hemorrhoids found">
				>
				["at0013"] = <
					text = <"Undetermined">
					description = <"It is not possible to decide whether or not there are hemorrhoids">
				>
				["at0014"] = <
					text = <"Appearance">
					description = <"A set of properties of each hemorrhoid found">
				>
				["at0015"] = <
					text = <"Alias">
					description = <"Optional specific label for the hemorrhoid ">
				>
				["at0016"] = <
					text = <"Quantity">
					description = <"The number of hemorrhoids found">
				>
				["at0017"] = <
					text = <"Detailed location">
					description = <"Detailed anatomical description of a hemorrhoid. Use clock notation for external hemorrhoids, and relative to anus for internal hemorrhoids.">
				>
				["at0018"] = <
					text = <"Location">
					description = <"Type of hemorrhoid based on location relative to anus.">
				>
				["at0019"] = <
					text = <"External">
					description = <"*">
				>
				["at0020"] = <
					text = <"Internal">
					description = <"*">
				>
				["at0021"] = <
					text = <"Mixed">
					description = <"*">
				>
				["at0022"] = <
					text = <"Shape">
					description = <"The overall shape of the hemorrhoid.">
					comment = <"E.g. with stalk, broad based">
				>
				["at0023"] = <
					text = <"Grade">
					description = <"Description of the severity or stage of the hemorrhoid">
				>
				["at0024"] = <
					text = <"Sharp classification">
					description = <"The severity of the hemorrhoid based on the Sharp classification.">
				>
				["at0025"] = <
					text = <"I pale">
					description = <"*">
				>
				["at0026"] = <
					text = <"II moderate">
					description = <"*">
				>
				["at0027"] = <
					text = <"III Severe">
					description = <"*">
				>
				["at0028"] = <
					text = <"IV Necrotic">
					description = <"*">
				>
				["at0029"] = <
					text = <"Bleeding">
					description = <"Narrative description of the degree of bleeding, and how easily the hemorrhoid bleeds.">
				>
				["at0030"] = <
					text = <"Tenderness">
					description = <"Narrative description of pain and tenderness to touch.">
				>
				["at0032"] = <
					text = <"Degree of prolapse">
					description = <"The degree of prolapse of internal hemorrhoids as described by D. Beck (2011)">
				>
				["at0033"] = <
					text = <"Grade I">
					description = <"No prolapse, just prominent blood vessels">
				>
				["at0034"] = <
					text = <"Grade II">
					description = <"Prolapse upon bearing down, but spontaneous reduction">
				>
				["at0035"] = <
					text = <"Grade III">
					description = <"Prolapse upon bearing down requiring manual reduction">
				>
				["at0036"] = <
					text = <"Grade IV">
					description = <"Prolapse with inability to be manually reduced">
				>
			>
		>
	>
