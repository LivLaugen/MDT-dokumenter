definition
	CLUSTER[at0000] matches {    -- Retinoblastoma diagnostic details
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- IIRC stage
				value matches {
					DV_CODED_TEXT matches {*}
				}
			}
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- ICRB stage
				value matches {
					DV_CODED_TEXT matches {*}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- RE stage
				value matches {
					DV_CODED_TEXT matches {*}
				}
			}
			ELEMENT[at0005] occurrences matches {0..1} matches {    -- RSU stage
				value matches {
					DV_CODED_TEXT matches {*}
				}
			}
			ELEMENT[at0006] occurrences matches {0..1} matches {    -- Optic invasion
				value matches {
					DV_BOOLEAN matches {*}
				}
			}
			ELEMENT[at0008] occurrences matches {0..1} matches {    -- MRI Findings
				value matches {
					DV_TEXT matches {*}
					DV_CODED_TEXT matches {*}
				}
			}
			CLUSTER[at0007] occurrences matches {0..1} matches {*}    -- CLUSTER
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Retinoblastoma diagnostic details">
					description = <"Detailed classification of retinoblastoma one or more of the classification systems.">
					comment = <"Intended use as CLUSTER inside i.e. EVALUATION.problem_diagnosis.">
				>
				["at0001"] = <
					text = <"IIRC stage">
					description = <"A framework for the clinical classification and staging of Retinoblastoma using the The International Classification for Intraocular Retinoblastoma system (IIRC). IIRC is a retinoblastoma staging system suited for staging intraocular retinoblastoma. If a patient has extraocular spread of retinoblastoma the most commonly used staging system is the Reese-Ellsworth staging system.">
				>
				["at0002"] = <
					text = <"RE stage">
					description = <"Reese-Ellsworth staging system is a classification system for retinoblastoma which includes extraocular spread of retinoblastoma. If only intraocular retinoblastoma IIRC might be more suited.">
				>
				["at0003"] = <
					text = <"ICRB stage">
					description = <"The International Classification of Retinoblastoma from 2011 is a more recent relative of the IIRC staging system.">
				>
				["at0005"] = <
					text = <"RSU stage">
					description = <"Retinoblastoma Classification at Relapse. R stands for retina, S for extraretinal seeding and U for uveal involvment. The classification requires both clinical observation as well as imaging devices such as UBM 
(Ultrasound Biomicroscopy) and/or OCT(Optical coherence tomography).">
				>
				["at0006"] = <
					text = <"Optic invasion">
					description = <"To register if there is optic nerve tumor invasion.">
				>
				["at0007"] = <
					text = <"CLUSTER">
					description = <"For extra details i.e. cTNM classification.">
				>
				["at0008"] = <
					text = <"MRI Findings">
					description = <"To describe if there is findings in MRI which is not possible to deduct easily from other classification systems. I.e. trilateral or intracranial spread.">
				>
			>
		>
	>
