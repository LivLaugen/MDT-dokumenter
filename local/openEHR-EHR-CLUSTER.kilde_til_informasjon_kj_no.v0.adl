definition
	CLUSTER[at0000] matches {    -- Kilde til informasjon kjernejournal
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Kilde
				value matches {
					DV_TEXT matches {*}
				}
			}
		}
	}

