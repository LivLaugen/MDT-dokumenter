archetype (adl_version=1.4; uid=679a0a00-fe84-4498-91a6-4b75d2d87918)
	openEHR-EHR-CLUSTER.yes_no_unknown.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::nb]>
	translations = <
		["en"] = <
			language = <[ISO_639-1::en]>
			author = <
				["name"] = <"Bjørn Næss">
				["organisation"] = <"DIPS AS">
				["email"] = <"bna@dips.no">
