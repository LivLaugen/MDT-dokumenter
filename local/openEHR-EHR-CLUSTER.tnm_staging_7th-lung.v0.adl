		["nb"] = <
			items = <
				["at0.52"] = <
					text = <"TX">
					description = <"Primærtumor kan ikke vurderes.">
				>
				["at0.53"] = <
					text = <"T0">
					description = <"Primærtumor ikke påvist.">
				>
				["at0.54"] = <
					text = <"Tis">
					description = <"Carcinoma in situ">
				>
				["at0.55"] = <
					text = <"T1">
					description = <"Tumordiameter <=3 cm, omgitt av lungevev eller viscerale pleura, uten bronkoskopisk bekreftelse for infiltrasjon mer proksimalt enn lobær bronkus (f.eks ikke til hovedbronkus).">
				>
				["at0.56"] = <
					text = <"T1a">
					description = <"Tumordiameter <= 2 cm.">
				>
				["at0.57"] = <
					text = <"T1b">
					description = <"Tumordiameter > 2 cm men <=3.">
				>
				["at0.58"] = <
					text = <"T2">
					description = <"Tumor > 3 cm men <= 7 cm eller tumor med noen av følgende karaktertrekk (T2 tumor med disse karaktertrekk er klassifisert T2a hvis <= 5 cm) 
Involverer hovedbronkus, >= 2 cm distalt for carina.
Infiltrerer viscerale pleura (PL1 eller PL2).
Assosiert med atelektase eller obstruktiv pneumonitt med utbredelse til hilusregionen, men som ikke involverer hele lungen.

">
				>
				["at0.59"] = <
					text = <"T2a">
					description = <"Tumordiameter > 3 cm men <= 5 cm.">
				>
				["at0.60"] = <
					text = <"T2b">
					description = <"Tumordiameter > 5 cm men <= 7 cm.">
				>
				["at0.61"] = <
					text = <"T3">
					description = <"Tumor > 7 cm eller som direkte invaderer parietale pleura (PL3), brystvegg (inkludert superior sulcus tumor), diafragma, nervus frenicus, mediastinale pleura, parietale pericardium; eller tumor i hovedbronkus (< 2 cm distalt for carina, men uten involvering av carina; eller assosiert atelektase eller obstruktiv pneumonitt av hele lungen eller isolerte tumorknuter i samme lapp.">
				>
				["at0.62"] = <
					text = <"T4">
					description = <"Tumor, uavhengig av størrelse, som invaderer mediastinum, hjerte, store kar, trakea, nervus recurrens, øsofagus, columna, carina, isolerte tumorknuter i annen lungelapp, samme side.">
				>
				["at0.63"] = <
					text = <"NX">
					description = <"Regional lymfeknuter kan ikke vurderes.">
				>
				["at0.64"] = <
					text = <"N0">
					description = <"Ingen metastase til regionale lymfeknuter.">
				>
				["at0.65"] = <
					text = <"N1">
					description = <"Metastase, inkludert direkte innvekst, til ipsilaterale peribronkiale lymfeknuter og/eller til ipsilaterale hilær lymfeknuter og intrapulmonale lymfeknuter.">
				>
				["at0.66"] = <
					text = <"N2">
					description = <"Metastase til ipsilaterale mediastinale og/eller subkarinale lymfeknuter.">
				>
				["at0.67"] = <
					text = <"N3">
					description = <"Metastase til kontralaterale mediastinale, kontralaterale hilære, ipsilaterale eller kontralaterale scalene, eller supraklavikulære lymfeknute(r)">
				>
				["at0.68"] = <
					text = <"MX">
					description = <"Fjernmetastase kan ikke vurderes.">
				>
				["at0.69"] = <
					text = <"M0">
					description = <"Ingen fjernmetastase.">
				>
				["at0.70"] = <
					text = <"M1">
					description = <"Fjernmetastase.">
				>
				["at0.71"] = <
					text = <"M1a">
					description = <"Isolerte tumorknuter i kontralateral lungelapp; pleurametastaser eller malign pleuravæske (eller perikardvæske).">
				>
				["at0.72"] = <
					text = <"M1b">
					description = <"Fjernmetastase.">
				>
				["at0.73"] = <
					text = <"RX">
					description = <"Resttumor kan ikke vurderes.
">
				>
				["at0.74"] = <
					text = <"R0">
					description = <"Ingen resttumor.">
				>
				["at0.75"] = <
					text = <"R is)">
					description = <"Carcinoma in situ
">
				>
				["at0.76"] = <
					text = <"R1">
					description = <"Mikroskopisk resttumor. Invasiv mucosal carcinoma eller peribronkial infiltrasjon.
">
				>
				["at0.77"] = <
