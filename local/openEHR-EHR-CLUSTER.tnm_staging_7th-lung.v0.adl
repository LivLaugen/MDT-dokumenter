				>
				["at0046"] = <
					text = <"Histopatologisk differensieringsgrad (G)">
					description = <"TNM klassifikasjon av histopatologisk differensieringsgrad.">
				>
				["at0047"] = <
					text = <"GX">
					description = <"Differensieringsgrad kan ikke vurderes.
">
				>
				["at0048"] = <
					text = <"G1">
					description = <"Høyt differensiert.">
				>
				["at0049"] = <
					text = <"G2">
					description = <"Moderat/middels differensiert.">
				>
