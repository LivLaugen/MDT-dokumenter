definition
	ADMIN_ENTRY[at0000] matches {    -- Admindata
		data matches {
			ITEM_TREE[at0001] matches {    -- Tree
				items cardinality matches {0..*; unordered} matches {
					CLUSTER[at0003] occurrences matches {0..1} matches {    -- Pasient/behandlingsinstitusjon
						items cardinality matches {6..*; unordered} matches {
							ELEMENT[at0004] matches {    -- Fødselsnummer
								value matches {
									DV_TEXT matches {*}
								}
							}
							ELEMENT[at0005] matches {    -- Navn
								value matches {
									DV_TEXT matches {*}
								}
							}
							ELEMENT[at0006] matches {    -- Sykehus
								value matches {
									DV_TEXT matches {*}
								}
							}
							ELEMENT[at0007] matches {    -- Avdeling
								value matches {
									DV_TEXT matches {*}
								}
							}
							ELEMENT[at0024] occurrences matches {0..1} matches {    -- Innleggelse/konsultasjon
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0031,    -- Innlagt
											at0032,    -- Poliklinisk
											at0033,    -- Dagkirurgisk
											at0034,    -- Dagkirurgisk med hotell
											at0035]    -- Dagkirurgisk med innleggelse
										}
									}
								}
							}
							ELEMENT[at0013] occurrences matches {0..1} matches {    -- Dato for innleggelse/konsultasjon
								value matches {
									DV_DATE matches {*}
								}
							}
						}
					}
					CLUSTER[at0017] occurrences matches {0..1} matches {    -- Melder
						items cardinality matches {2..*; unordered} matches {
							ELEMENT[at0018] matches {    -- Melders navn
								value matches {
									DV_TEXT matches {*}
								}
							}
							ELEMENT[at0019] matches {    -- Meldedato
								value matches {
									DV_DATE matches {*}
								}
							}
							ELEMENT[at0020] occurrences matches {0..1} matches {    -- Melders ID
								value matches {
									DV_TEXT matches {*}
								}
							}
							ELEMENT[at0021] occurrences matches {0..1} matches {    -- Ansvarlig lege
								value matches {
									DV_TEXT matches {*}
								}
							}
							ELEMENT[at0022] occurrences matches {0..1} matches {    -- Ansvarlig lege ID
								value matches {
									DV_TEXT matches {*}
								}
							}
						}
					}
					ELEMENT[at0023] occurrences matches {0..1} matches {    -- Kommentar
						value matches {
							DV_TEXT matches {*}
						}
					}
				}
			}
		}
	}

