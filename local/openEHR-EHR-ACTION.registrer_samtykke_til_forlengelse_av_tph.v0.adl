definition
	ACTION[at0000] matches {    -- Samtykke til forlengelse av tph
		ism_transition matches {
			ISM_TRANSITION[at0001] matches {    -- Samtykke registrert
				current_state matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[openehr::532]
						}
					}
				}
				careflow_step matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::at0001]    -- Samtykke registrert
						}
					}
				}
			}
		}
		description matches {
			allow_archetype ITEM_TREE matches {
				include
					archetype_id/value matches {/openEHR-EHR-ITEM_TREE\.om_samtykke_til_forlengelse_av_tph(-[a-zA-Z0-9_]+)*\.v1/}
			}
		}
	}

