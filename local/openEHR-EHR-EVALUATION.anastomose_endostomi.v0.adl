definition
	EVALUATION[at0000] matches {    -- Anastomose/endostomi
		data matches {
			ITEM_TREE[at0001] matches {    -- Tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..1} matches {    -- Anastomose
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0003,    -- Ja
									at0004,    -- Nei
									at0005]    -- Ukjent
								}
							}
						}
					}
					ELEMENT[at0006] occurrences matches {0..1} matches {    -- Avlastende stomi
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0007,    -- Ja
									at0008,    -- Nei
									at0009]    -- Ukjent
								}
							}
						}
					}
				}
			}
		}
	}

