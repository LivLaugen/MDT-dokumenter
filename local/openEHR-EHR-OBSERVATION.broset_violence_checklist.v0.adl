description
	original_author = <
		["date"] = <"2016-02-17">
		["name"] = <"Dag Trygve Hanoa">
		["organisation"] = <"Oslo Universitetssykehus HF">
		["email"] = <"daha@ous-hf.no">
	>
	lifecycle_state = <"in_development">
	other_contributors = <"Hallvard Lærum", ...>
	details = <
		["nb"] = <
			language = <[ISO_639-1::nb]>
			purpose = <"Kvantifisere risiko for vold utført av pasienter mot helsepersonell eller andre, fortrinnsvis i psykiatrien.">
			keywords = <"vold","psykiatri">
			copyright = <"© *(nb), Nasjonal IKT HF">
			use = <"BVC er et observasjonsskjema hvor dine vurderinger av pasienten er viktig og du fyller ut etter de vurderinger du gjør av pasienten på det gitte tidspunkt. Pasienter du kjenner godt fra flere tidligere innleggelser gir du skåre 1 kun hvis atferden du fra før er kjent med forsterker seg fra det vanlige. Altså; hvis en pasient du kjenner godt og som til vanlig kommer med verbale trusler som egentlig ingen av dere tar alvorlgi fordi det er en del av pasientens normalatferd, så gir du verdien 0 i rubrikken for nevnte type atferd. Hvis denne vanlige atferd forsterker seg eller blir verre enn kjent fra før skårer du med verdien 1. Pasienter du ikke kjenner fra før vurderes og observeres som vanlig og skåres på skjema etter ditt skjønn og din vurdering.">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"*(nb)">
			copyright = <"© *(nb), Nasjonal IKT HF">
			use = <"*(nb)">
			misuse = <"*(nb)">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"Nasjonal IKT">
		["references"] = <"Hvidhjelm J et al. Sensitivity and specificity of the Brøset Violence Checklist as predictor of violence in forensic psychiatry. Nordic Journal of Psychiatry 2014 Volume 68, Issue 8

Almvik, R and Woods,P. Predicting inpatient violence using the Bröset Violence Checklist. International Journal of Psychiatric Nursing Research 1999 4 (3)  489-497

Woods P and Almvik R. The Brøset Violence Chekclist (BVC). Acta Psychiatrica Scandinavica 2002 106 (Suppl. 412) 103-105">
		["current_contact"] = <"Dag Trygve Hanoa, Oslo Universitetssykehus HF, daha@ous-hf.no">
		["original_namespace"] = <"no.nasjonalikt">
		["original_publisher"] = <"Nasjonal IKT">
		["custodian_namespace"] = <"no.nasjonalikt">
		["MD5-CAM-1.0.1"] = <"64776BE91785A5D4D7F836B121CB004A">
		["build_uid"] = <"8227d694-cf94-443d-b84f-8c6b5439b07f">
		["revision"] = <"0.0.1-alpha">
	>

definition
	OBSERVATION[at0000] matches {    -- Brøset Violence Checklist (BVC)
		data matches {
			HISTORY[at0001] matches {    -- *Event Series(nb)
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..1} matches {    -- *Any event(nb)
						data matches {
							ITEM_TREE[at0003] matches {    -- *Tree(en)
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0004] occurrences matches {0..1} matches {    -- *New element(en)
										value matches {
											0|[local::at0005],
											1|[local::at0006]
										}
									}
									ELEMENT[at0007] occurrences matches {0..1} matches {    -- *New element(en)
										value matches {
											0|[local::at0008],
											1|[local::at0009]
										}
									}
									ELEMENT[at0010] occurrences matches {0..1} matches {    -- *New element(en)
										value matches {
											0|[local::at0011],
											1|[local::at0012]
										}
									}
									ELEMENT[at0013] occurrences matches {0..1} matches {    -- *New element(en)
										value matches {
											0|[local::at0014],
											1|[local::at0015]
										}
									}
									ELEMENT[at0016] occurrences matches {0..1} matches {    -- *New element(en)
										value matches {
											0|[local::at0017],
											1|[local::at0018]
										}
									}
									ELEMENT[at0019] occurrences matches {0..1} matches {    -- *New element(en)
										value matches {
											0|[local::at0020],
											1|[local::at0021]
										}
									}
									ELEMENT[at0022] occurrences matches {0..1} matches {    -- *New element(en)
										value matches {
											DV_COUNT matches {
												magnitude matches {|0..6|}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"Brøset Violence Checklist (BVC)">
					description = <"Et scoringssystem til bruk for å vurdere risiko for vold utført av pasienter. Brukes i akutt-, sikkerhets- og alderspsykiatri. Sum score er 0-6, hvor 6 er høyest risiko for voldelig atferd.">
				>
				["at0001"] = <
					text = <"Event Series">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Uspesifisert hendelse">
					description = <"Standard, uspesifisert tidspunkt eller tidsintervall som kan defineres mer eksplisitt i en template eller i en applikasjon.">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"Forvirring">
					description = <"Oppfører seg åpenbart forvirret og desorientert. Kan hende er pasienten ikke orientert for tid og sted samt person.">
				>
				["at0005"] = <
					text = <"Ingen forekomst">
					description = <"">
				>
				["at0006"] = <
					text = <"Atferden er observert">
					description = <"">
				>
				["at0007"] = <
					text = <"Irritabilitet">
					description = <"Pasienten blir lett irritert; tårlig dårlig andres tilstedeværelse.">
				>
				["at0008"] = <
					text = <"Ingen forekomst">
					description = <"*">
				>
				["at0009"] = <
					text = <"Atferden er observert">
					description = <"*">
				>
				["at0010"] = <
					text = <"Støyende atferd">
					description = <"En åpenbart støyende og brautende væremåte; f.eks. slamrer med dører, roper i stedet for å snakke.">
				>
				["at0011"] = <
					text = <"Ingen forekomst">
					description = <"*">
				>
				["at0012"] = <
					text = <"Atferden er observert">
					description = <"*">
				>
				["at0013"] = <
					text = <"Fysisk truende">
					description = <"Viser med tydelig kroppspråk at hensikten er å true en annen person, f.eks. en aggressiv kroppsholdning, tar i en annen persons klær, løfter og hytter med knyttet neve, simulerer skalling retning en annen, osv.">
				>
				["at0014"] = <
					text = <"Ingen forekomst">
					description = <"*">
				>
				["at0015"] = <
					text = <"Atferden er observert">
					description = <"*">
				>
				["at0016"] = <
					text = <"Verbalt truende">
					description = <"Et verbalt utbrudd som er mer enn å bare heve stemmen og har til hensikt å ydmyke eller skremme en annen ">
				>
				["at0017"] = <
					text = <"Ingen forekomst">
					description = <"*">
				>
				["at0018"] = <
					text = <"Atferden er observert">
					description = <"*">
				>
				["at0019"] = <
					text = <"Angrep på ting og gjenstander">
					description = <"Et direkte angrep på ting eller gjenstander og ikke en person; slår på eller knuser et vindu, slår eller skaller en gjenstand eller slår i stykker et møbel.">
				>
				["at0020"] = <
					text = <"Ingen forekomst">
					description = <"*">
				>
				["at0021"] = <
					text = <"Atferden er observert">
					description = <"*">
				>
				["at0022"] = <
					text = <"Sum">
					description = <"Sum av ovenstående adferd. 0 = Liten risiko for vold. 1-2 = Moderat risiko for vold, preventive forholdsregler bør tas. >2 = Høy risiko for vold, preventive forholdsregler skal tas og planer for hvordan møte et eventuelt angrep legges.">
				>
			>
		>
