archetype (adl_version=1.4; uid=35097132-d487-42f3-a4e0-bf13ef7b3ec6)
	openEHR-EHR-OBSERVATION.broset_violence_checklist.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::en]>
	translations = <
		["nb"] = <
			language = <[ISO_639-1::nb]>
			author = <
				["name"] = <"?">
