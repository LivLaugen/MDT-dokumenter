	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record contextual information about the identification of a problem or a diagnosis.">
			copyright = <"© Nasjonal IKT HF">
			use = <"Use to record the context of a problem or a diagnosis where this information does not excist as specific archetypes in the same system, or when transmitting data between systems.

The archetype is intended to be grown in time as new requirements surface.">
		>
	>
