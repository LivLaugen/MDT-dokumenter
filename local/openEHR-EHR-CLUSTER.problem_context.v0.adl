definition
	CLUSTER[at0000] matches {    -- Problem/Diagnosis Context
		items cardinality matches {1..*; unordered} matches {
			CLUSTER[at0002] occurrences matches {0..*} matches {    -- Investigation
				items cardinality matches {1..*; unordered} matches {
					ELEMENT[at0001] occurrences matches {0..1} matches {    -- Investigation name
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0003] occurrences matches {0..1} matches {    -- Description
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0004] occurrences matches {0..1} matches {    -- Investigation date
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Problem/Diagnosis Context">
					description = <"Contextual information about the identification of a problem or a diagnosis.">
				>
				["at0001"] = <
					text = <"Investigation name">
					description = <"Name of the investigation performed.">
					comment = <"The investigation performed should be coded with a terminology where possible.">
				>
				["at0002"] = <
					text = <"Investigation">
					description = <"Investigation performed to reach the problem or diagnosis.">
				>
				["at0003"] = <
					text = <"Description">
					description = <"Narrative description of the investigation performed.">
				>
				["at0004"] = <
					text = <"Investigation date">
					description = <"Date the investigation was perfomed.">
				>
			>
		>
	>
