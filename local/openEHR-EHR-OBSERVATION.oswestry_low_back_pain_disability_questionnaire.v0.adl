			>
		>
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"Funksjonsskår (Oswestry)">
					description = <"Oswestry Low Back Pain Disability Questionnaire (ODI)">
				>
				["at0001"] = <
					text = <"Event Series">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Point in time">
					description = <"*A specific date and/or time which may be explicitly defined in a template or at run-time. (en)">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"1. Smerte">
					description = <"*Patient-reported lower back pain intensity. (en)">
					comment = <"*Questionnaire wording: 
Section 1 - Pain intensity (en)">
				>
				["at0009"] = <
					text = <"Jeg har ingen smerter for øyeblikket">
					description = <"*The patient has no pain at the moment. (en)">
				>
				["at0044"] = <
					text = <"Total skåring">
					description = <"*Total score from questions 1 to 10. (en)">
				>
				["at0045"] = <
					text = <"Total skåring som prosent">
					description = <"*Total score from questions 1 to 10 as a percentage. (en)">
					comment = <"*0% to 20%: minimal disability: The patient can cope with most living activities. Usually no treatment is
indicated apart from advice on lifting sitting and exercise.
21%-40%: moderate disability: The patient experiences more pain and difficulty with sitting, lifting and
standing. Travel and social life are more difficult and they may be
disabled from work. Personal care, sexual activity and sleeping are not
grossly affected and the patient can usually be managed by
conservative means.
41%-60%: severe disability: Pain remains the main problem in this group but activities of daily
living are affected. These patients require a detailed investigation.
61%-80%: crippled: Back pain impinges on all aspects of the patient's life. Positive
intervention is required.
81%-100%: These patients are either bed-bound or exaggerating their symptoms. (en)">
				>
				["at0046"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0047"] = <
					text = <"Påvirkende faktorer">
					description = <"Registrer eventuelle problemer eller faktorer som kan påvirke poengsummen eller tolkningen.">
				>
				["at0048"] = <
					text = <"ItemTree">
					description = <"@ internal @">
				>
				["at0049"] = <
					text = <"Utvidelse">
					description = <"*Additional information required to capture local context or to align with other reference models/formalisms. (en)">
					comment = <"*e.g. Local hospital departmental information or additional metadata to align with HL7 or CDISC equivalents. (en)">
				>
				["at0050"] = <
					text = <"Smertene er veldig svake for øyblikket">
					description = <"*The patient has very mild pain at the moment. (en)">
				>
				["at0051"] = <
					text = <"Smertene er moderate for øyeblikket">
					description = <"*The patient has moderate pain at the moment. (en)">
				>
				["at0052"] = <
					text = <"Smertene er temmelig sterke for øyeblikket">
					description = <"*The patient has fairly severe pain at the moment. (en)">
				>
				["at0053"] = <
					text = <"2. Personlig stell">
					description = <"*Patient-reported ability of personal care (washing, dressing etc) due to lower back pain. (en)">
					comment = <"*Questionnaire wording: 
Section 2 – Personal care (washing, dressing etc) (en)">
				>
				["at0054"] = <
					text = <"Jeg kan stelle meg selv på vanlig måte uten at det forårsaker ekstra smerter">
					description = <"*The patient can look after their self without causing extra pain. (en)">
				>
				["at0055"] = <
					text = <"Jeg kan stelle meg selv på vanlig måte, men det er veldig smertefullt">
					description = <"*The patient can look after their self normally but it causes extra pain. (en)">
				>
				["at0056"] = <
					text = <"Det er smertefullt å stelle seg selv, og jeg gjør det langsomt og forsiktig">
					description = <"*The patient finds it painful to look after their self and are slow and careful doing so. (en)">
				>
				["at0057"] = <
					text = <"Jeg trenger noe hjelp, men klarer det meste av mitt personlige stell">
					description = <"*The patient needs some help but manages most of their personal care. (en)">
				>
				["at0058"] = <
					text = <"3. Å løfte">
					description = <"*Patient-reported ability to lift heavy weights due to lower back pain. (en)">
					comment = <"*Questionnaire wording: 
Section 3 – Lifting (en)">
				>
				["at0059"] = <
					text = <"Jeg kan løfte tunge ting uten å få mer smerter">
					description = <"*The patient can lift heavy weights without extra pain. (en)">
				>
				["at0060"] = <
					text = <"Jeg kan løfte tunge ting, men får smerter">
					description = <"*The patient can lift heavy weights but it gives extra pain. (en)">
				>
				["at0061"] = <
					text = <"Smerter hindrer meg i å løfte tunge ting opp fra gulvet, men jeg greier det hvis det som skal løftes er gunstig plassert, for eksempel på et bord">
					description = <"*Pain prevents the patient from lifting heavy weights off the floor, but they can manage if they are conveniently placed eg. on a table. (en)">
				>
				["at0062"] = <
					text = <"Smerter hindrer meg i å løfte tunge ting, men jeg klarer lette og middels tunge ting, hvis det er gunstig plassert">
					description = <"*Pain prevents the patient from lifting heavy weights, but they can manage light to medium weights if they are conveniently positioned. (en)">
				>
				["at0063"] = <
					text = <"4. Å gå">
					description = <"*Patient-reported ability to walk due to lower back pain. (en)">
					comment = <"*Questionnaire wording: 
Section 4 – Walking* (en)">
				>
				["at0064"] = <
					text = <"Smerter hindrer meg ikke i å gå i det hele tatt">
					description = <"*Pain does not prevent the patient walking any distance. (en)">
				>
				["at0065"] = <
					text = <"Smerter hindrer meg i å gå mer enn 1 1/2 km">
					description = <"*Pain prevents the patient from walking more than 1 mile. (en)">
				>
				["at0066"] = <
					text = <"Smerter hindrer meg i å gå mer enn 3/4 km">
					description = <"*Pain prevents the patient from walking more than 1/2 mile. (en)">
				>
				["at0067"] = <
					text = <"Smerter hindrer meg i å gå mer enn 100 m">
					description = <"*Pain prevents the patient from walking more than 100 yards. (en)">
				>
				["at0068"] = <
					text = <"5. Å sitte">
					description = <"*Patient-reported ability to sit due to lower back pain. (en)">
					comment = <"*Questionnaire wording: 
Section 5 – Sitting (en)">
				>
				["at0069"] = <
					text = <"Jeg kan sitte så lenge jeg vil i en hvilken som helst stol">
					description = <"*The patient can sit in any chair as long as they like. (en)">
				>
				["at0070"] = <
					text = <"Jeg kan sitte så lenge jeg vil i min favorittstol">
					description = <"*The patient can only sit in their favourite chair as long as they like. (en)">
				>
				["at0071"] = <
					text = <"Smerter hindrer meg i å sitte mer enn en time">
					description = <"*Pain prevents the patient from sitting more than one hour. (en)">
				>
				["at0072"] = <
					text = <"Smerte hindrer meg i å  sitte mer enn en halv time">
					description = <"*Pain prevents the patient from sitting more than 30 minutes. (en)">
				>
				["at0073"] = <
					text = <"7. Å sove">
					description = <"*Patient-reported ability to sleep due to lower back pain. (en)">
					comment = <"*Questionnaire wording: 
Section 7 – Sleeping (en)">
				>
				["at0074"] = <
					text = <"Søvnen min forstyrres aldri av smerter">
					description = <"*The patient's sleep is never disturbed by pain. (en)">
				>
				["at0075"] = <
					text = <"Søvnen min forstyrres av og til av smerter">
					description = <"*The patient's is occasionally disturbed by pain. (en)">
				>
				["at0076"] = <
					text = <"På grunn av smerter får jeg mindre enn seks timers søvn">
					description = <"*Because of pain the patient has less than 6 hours sleep. (en)">
				>
				["at0077"] = <
					text = <"På grunn av smerter får jeg mindre enn fire timers søvn">
					description = <"*Because of pain the patient has less than 4 hours sleep. (en)">
				>
				["at0078"] = <
					text = <"6. Å stå">
					description = <"*Patient-reported ability to stand due to lower back pain. (en)">
					comment = <"*Questionnaire wording: 
Section 6 – Standing
 (en)">
				>
				["at0079"] = <
					text = <"Jeg kan stå så lenge jeg vil uten å få mer smerter">
					description = <"*The patient can stand as long as they want without extra pain. (en)">
				>
				["at0080"] = <
					text = <"Jeg kan stå så lenge jeg vil, men får smerter">
					description = <"*The patient can stand as long as they want but it gives me extra pain. (en)">
				>
				["at0081"] = <
					text = <"Smerter hindrer meg i å stå mer enn en time">
					description = <"*Pain prevents the patient from standing for more than 1 hour. (en)">
				>
				["at0082"] = <
					text = <"Smerter hindrer meg i å stå mer enn en halv time">
					description = <"*Pain prevents the patient from standing for more than 30 minutes. (en)">
				>
				["at0083"] = <
					text = <"8. Seksualliv">
					description = <"*Patient-reported impact on sex life due to back pain. (en)">
					comment = <"*Questionnaire wording: 
Section 8 – Sex life (if applicable) (en)">
				>
				["at0084"] = <
					text = <"Seksuallivet mitt er normalt og forårsaker ikke mer smerter">
					description = <"*The patient's sex life is normal and causes no extra pain. (en)">
				>
				["at0085"] = <
					text = <"Seksuallivet mitt er normalt, men forårsaker noe mer smerter">
					description = <"*The patient's sex life is normal but causes some extra pain. (en)">
				>
				["at0086"] = <
					text = <"Seksuallivet mitt er (nesten) normalt, men svært smertefult">
					description = <"*The patient's sex life is nearly normal but is very painful. (en)">
				>
				["at0087"] = <
					text = <"Seksuallivet mitt er svært begrenset på grunn av smerter">
					description = <"*The patient's sex life is severely restricted by pain. (en)">
				>
				["at0088"] = <
					text = <"9. Sosialt liv (omgang med venner og kjente)">
					description = <"*Patient-reported impact on social life due to lower back pain. (en)">
					comment = <"*Questionnaire wording: 
Section 9 – Social life (en)">
				>
				["at0089"] = <
					text = <"Det sosiale livet mitt er normalt og forårsaker ikke mer smerter">
					description = <"*The patient's social life is normal and gives me no extra pain. (en)">
				>
				["at0090"] = <
					text = <"Det sosiale livet mitt er normalt, men øker graden av smerter">
					description = <"*The patient's social life is normal but increases the degree of pain. (en)">
				>
				["at0091"] = <
					text = <"Smerter har ingen betydelig innvirkning på mitt sosiale liv, bortsett fra at det begrenser mine fysisk aktive sider, som sport osv.">
					description = <"*Pain has no significant effect on the patient's social life apart from limiting their more energetic interests eg. sport. (en)">
				>
				["at0092"] = <
					text = <"Smerter har begrenset mitt sosiale liv, og jeg går ikke ut så ofte">
					description = <"*Pain has restricted the patient's social life and they do not go out as often. (en)">
				>
				["at0093"] = <
					text = <"10. Å reise">
					description = <"*Patient-reported ability to travel due to lower back pain. (en)">
					comment = <"*Questionnaire wording: 
Section 10 – Travelling (en)">
				>
				["at0094"] = <
					text = <"Jeg kan reise hvor som helst uten smerter">
					description = <"*The patient can travel anywhere without pain. (en)">
				>
				["at0095"] = <
					text = <"Jeg kan reise hvor som helst, men det gir mer smerter">
					description = <"*The patient can travel anywhere but it gives me extra pain. (en)">
				>
				["at0096"] = <
					text = <"Smertene er ille, men jeg klarer reiser på to timer">
					description = <"*Pain is bad but the patient can manage journeys over two hours. (en)">
				>
				["at0097"] = <
					text = <"Smerter begrenser meg til korte reiser på under en time">
					description = <"*Pain restricts the patient to journeys of less than one hour. (en)">
				>
				["at0098"] = <
					text = <"Smertene er veldig sterke for øyeblikket">
					description = <"*The patient has very severe pain at the moment. (en)">
				>
				["at0099"] = <
					text = <"Smertene er det verst tenkelige for øyeblikket">
					description = <"*The patient has the worst imaginable pain at the moment. (en)">
				>
				["at0100"] = <
					text = <"Jeg trenger hjelp hver dag i de fleste aspekter av egenomsorg">
					description = <"*The patient needs help every day in most aspects of self care. (en)">
				>
				["at0101"] = <
					text = <"Jeg kler meg ikke, jeg vasker meg med vanskeligheter og blir i sengen">
					description = <"*The patient does not get dressed, they wash with difficulty and stay in bed. (en)">
				>
				["at0102"] = <
					text = <"Jeg kan bare løfte veldig lette vekter">
					description = <"*The patient can only lift very light weights. (en)">
				>
				["at0103"] = <
					text = <"Jeg kan ikke løfte eller bære noe">
					description = <"*The patient cannot lift or carry anything. (en)">
				>
				["at0104"] = <
					text = <"Jeg kan bare gå med en stokk eller krykker">
					description = <"*Patient can only walk using a stick or crutches. (en)">
				>
				["at0105"] = <
					text = <"Jeg er i sengen mesteparten av tiden">
					description = <"*Patient is in bed most of the time. (en)">
				>
				["at0106"] = <
					text = <"Smerte hindrer meg i å sitte mer enn ti minutter">
					description = <"*Pain prevents the patient from sitting more than 10 minutes. (en)">
				>
				["at0107"] = <
					text = <"Smerter hindrer meg i å sitte i det hele tatt">
					description = <"*Pain prevents the patient from sitting at all. (en)">
				>
				["at0108"] = <
					text = <"Smerte hindrer meg i å stå i mer enn ti minutter">
					description = <"*Pain prevents the patient from standing for more than 10 minutes. (en)">
				>
				["at0109"] = <
					text = <"Smerter hindrer meg i å stå i det hele tatt">
					description = <"*Pain prevents the patient from standing at all. (en)">
				>
				["at0110"] = <
					text = <"På grunn av smerter får jeg mindre enn to timers søvn">
					description = <"*Because of pain the patient has less than 2 hours sleep. (en)">
				>
				["at0111"] = <
					text = <"Smerter hindrer all søvn">
					description = <"*Pain prevents the patient from sleeping at all. (en)">
				>
				["at0112"] = <
					text = <"Seksuallivet mitt er nesten borte på grunn av smerter">
					description = <"*The patient's sex life is nearly absent because of pain. (en)">
				>
				["at0113"] = <
					text = <"Smerter forhindrer alt seksualliv">
					description = <"*Pain prevents any sex life at all for the patient. (en)">
				>
				["at0114"] = <
					text = <"Smerter har begrenst mitt sosiale liv til hjemmet">
					description = <"*Pain has restricted the patient's social life to their home. (en)">
				>
				["at0115"] = <
					text = <"På grunn av smerter har jeg ikke noe sosialt liv">
					description = <"*The patient has no social life because of pain. (en)">
				>
				["at0116"] = <
					text = <"Smerter begrenser meg til korte, nødvendige reiser på under 30 minutter">
					description = <"*Pain restricts the patient to short necessary journeys under 30 minutes. (en)">
				>
				["at0117"] = <
					text = <"Smerter forhindrer meg fra å reise, unntatt for å få behandling">
					description = <"*Pain prevents the patient from travelling except to receive treatment. (en)">
				>
				["at0118"] = <
					text = <"Tolkning">
					description = <"*">
				>
				["at0119"] = <
					text = <"Minimal funksjonshemming">
					description = <"Pasienten kan takle de fleste levende aktiviteter. Vanligvis er ingen behandling indisert bortsett fra råd om sitteløft og trening.">
				>
				["at0120"] = <
					text = <"Moderat funksjonshemming">
					description = <"Pasienten opplever mer smerte og problemer med å sitte, løfte og stå. Reise og sosialt liv er vanskeligere, og det kan de være
funksjonshemmet fra jobb. Personlig pleie, seksuell aktivitet og søvn påvirkes ikke grovt og pasienten kan vanligvis håndteres av
">
				>
				["at0121"] = <
					text = <"Alvorlig funksjonshemming">
					description = <"Smerte er fortsatt hovedproblemet i denne gruppen, men dagliglivets aktiviteter påvirkes. Disse pasientene krever en detaljert utredning">
				>
				["at0122"] = <
					text = <"Forkrøpet">
					description = <"Ryggsmerter påvirker alle aspekter av pasientens liv. Positiv intervensjon er nødvendig.">
				>
				["at0123"] = <
					text = <"Sengeliggede">
					description = <"Disse pasientene er enten sengeliggende eller overdriver symptomene sine">
				>
			>
		>
	>
