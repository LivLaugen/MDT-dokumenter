				value matches {
					DV_TEXT matches {*}
				}
			}
			allow_archetype CLUSTER[at0006] occurrences matches {0..*} matches {    -- Detaljer fluoresceinangiografi
				include
					archetype_id/value matches {/.*/}
			}
		}
	}

ontology
	term_definitions = <
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"Fluoresceinangiografi">
					description = <"Beskrivelse og resultater fra øyeundersøkelse med fluoresceinangiografi.Undersøkelsen kan enten gjøres med foto eller video.">
				>
				["at0001"] = <
					text = <"Beskrivelse">
					description = <"Kvalitativ beskrivelse av hva fluorescein bilder eller video viser.">
