definition
	EVALUATION[at0000] matches {    -- Sammendrag av tobakksrøyking
		data matches {
			ITEM_TREE[at0001] matches {    -- Tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..1} matches {    -- Røykestatus
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0003] occurrences matches {0..1} matches {    -- Beskrivelse
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0004] occurrences matches {0..1} matches {    -- Dato for røykedebut
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					ELEMENT[at0005] occurrences matches {0..1} matches {    -- Dato for røykeslutt
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					CLUSTER[at0006] occurrences matches {0..1} matches {    -- Per form
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0013] occurrences matches {0..1} matches {    -- Form
								value matches {
									DV_TEXT matches {*}
								}
							}
							ELEMENT[at0014] occurrences matches {0..1} matches {    -- Beskrivelse
								value matches {
									DV_TEXT matches {*}
								}
							}
							ELEMENT[at0015] occurrences matches {0..1} matches {    -- Typisk forbruk
								value matches {
									DV_QUANTITY matches {*}
								}
							}
							ELEMENT[at0016] occurrences matches {0..1} matches {    -- Typisk bruksmønster
								value matches {
									DV_TEXT matches {*}
								}
							}
							ELEMENT[at0017] occurrences matches {0..1} matches {    -- Utløsende faktorer
								value matches {
									DV_TEXT matches {*}
								}
							}
							ELEMENT[at0018] occurrences matches {0..1} matches {    -- Brukskontekst
								value matches {
									DV_TEXT matches {*}
								}
							}
							ELEMENT[at0019] occurrences matches {0..1} matches {    -- Dato for røykedebut
								value matches {
									DV_DATE_TIME matches {*}
								}
							}
							ELEMENT[at0020] occurrences matches {0..1} matches {    -- Dato for røykeslutt
								value matches {
									DV_DATE_TIME matches {*}
								}
							}
							allow_archetype CLUSTER[at0021] occurrences matches {0..*} matches {    -- Spesifikke detaljer
								include
									archetype_id/value matches {/.*/}
							}
							ELEMENT[at0022] occurrences matches {0..1} matches {    -- Antall forsøk på å slutte
								value matches {
									DV_COUNT matches {*}
								}
							}
							allow_archetype CLUSTER[at0023] occurrences matches {0..*} matches {    -- Detaljer om forsøk på å slutte
								include
									archetype_id/value matches {/.*/}
							}
							allow_archetype CLUSTER[at0024] occurrences matches {0..*} matches {    -- Motivasjon for å slutte
								include
									archetype_id/value matches {/.*/}
							}
							ELEMENT[at0025] occurrences matches {0..1} matches {    -- Kommentar
								value matches {
									DV_TEXT matches {*}
								}
							}
						}
					}
					ELEMENT[at0007] occurrences matches {0..1} matches {    -- Kommentar
						value matches {
							DV_TEXT matches {*}
						}
					}
				}
			}
		}
		protocol matches {
			ITEM_TREE[at0008] matches {    -- Tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0009] occurrences matches {0..1} matches {    -- Dato sist oppdatert
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					ELEMENT[at0010] occurrences matches {0..1} matches {    -- Definisjon av periode sluttet
						value matches {
							DV_DURATION matches {*}
						}
					}
					ELEMENT[at0011] occurrences matches {0..1} matches {    -- Definisjon av pakkestørrelse
						value matches {
							DV_COUNT matches {*}
						}
					}
					allow_archetype CLUSTER[at0012] occurrences matches {0..*} matches {    -- Tilleggsinformasjon
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
	}

