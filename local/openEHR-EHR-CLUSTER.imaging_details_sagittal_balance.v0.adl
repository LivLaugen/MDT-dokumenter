definition
	CLUSTER[at0000] matches {    -- Imaging examination details - saggital balance
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- Sagittal vertical axis
				value matches {
					C_DV_QUANTITY <
						property = <[openehr::122]>
						list = <
							["1"] = <
								units = <"cm">
								magnitude = <|>-100.0..<100.0|>
							>
						>
					>
				}
			}
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- Pelvic incidence
				value matches {
					C_DV_QUANTITY <
						property = <[openehr::497]>
						list = <
							["1"] = <
								units = <"deg">
								magnitude = <|0.0..360.0|>
							>
						>
					>
				}
			}
			ELEMENT[at0004] occurrences matches {0..1} matches {    -- Pelvic tilt
				value matches {
					C_DV_QUANTITY <
						property = <[openehr::497]>
						list = <
							["1"] = <
								units = <"deg">
								magnitude = <|0.0..360.0|>
							>
						>
					>
				}
			}
			ELEMENT[at0005] occurrences matches {0..1} matches {    -- Sacral slope
				value matches {
					C_DV_QUANTITY <
						property = <[openehr::497]>
						list = <
							["1"] = <
								units = <"deg">
								magnitude = <|0.0..360.0|>
							>
						>
					>
				}
			}
		}
	}

ontology
	term_definitions = <
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"Bildediagnostiske detaljer - sagittal balanse">
					description = <"Sagittal balanse er en del av en røntgenundersøkelse av spinale deformiteter inkludert kyfotiske eller lordotiske deformiteter og skoliose.">
				>
				["at0002"] = <
					text = <"Sagittal vertikal akse">
					description = <"Den målte lengden av en horisontal linje som forbinder den bakre øvre sakrale endeplaten med en vertikal loddlinje fra C7.">
					comment = <"Omtales også som SVA.
Positive verdier uttrykker at den vertikale loddlinjen ligger anteriort for det posteosuperiore hjørnet av S1. Negative verdier uttrykker at loddlinjen ligger posteriort.">
				>
				["at0003"] = <
					text = <"Pelvic incidence">
					description = <"Den målte vinkelen mellom en vinkelrett linje på midtpunktet av den sakrale endeplaten, og en linje som forbinder dette punktet med aksen til lårbeinshodet.">
					comment = <"Omtales også som PI.">
				>
				["at0004"] = <
					text = <"Pelvic tilt">
					description = <"Den målte vinkelen mellom en linje som går fra den sakrale endeplatens midtpunkt til midten av bifemoralhodene, og den vertikale aksen i sagittalplanet.">
					comment = <"Omtales også som PT.">
				>
				["at0005"] = <
					text = <"Sacral slope">
					description = <"Den målte vinkelen mellom en linje parallelt med den sakrale endeplaten og en horisontal referanselinje.">
					comment = <"Omtales også som SS.">
				>
			>
		>
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Imaging examination details - saggital balance">
					description = <"Sagittal balance is a part of the radiographic assessment of spinal deformity including kyphotic or lordotic deformities and scoliosis.">
				>
				["at0002"] = <
					text = <"Sagittal vertical axis">
					description = <"The measured length of a horizontal line connecting the posterior superior sacral endplate with a vertical plumb line from C7.">
				>
				["at0003"] = <
					text = <"Pelvic incidence">
					description = <"The measured angle between a perpendicular line at the midpoint of the sacral endplate, and a line joining this point to the axis of the femoral head.">
				>
				["at0004"] = <
					text = <"Pelvic tilt">
					description = <"The measured angle between a line running from the midpoint of the sacral endplate to the midpoint of the bifemoral heads, and the vertical axis in the sagittal plane.">
				>
				["at0005"] = <
					text = <"Sacral slope">
					description = <"The measured angle between a line parallel to the sacral endplate and a horizontal reference line.">
				>
			>
		>
	>
