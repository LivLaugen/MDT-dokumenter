archetype (adl_version=1.4; uid=cf91bdcd-2d73-4c5b-a540-a56e01b1cf59)
	openEHR-EHR-EVALUATION.intubation_problem_summary.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::en]>
	translations = <
		["nb"] = <
			language = <[ISO_639-1::nb]>
			author = <
				["name"] = <"Silje Ljosland Bakke / John Tore Valand">
