definition
	ITEM_TREE[at0000] occurrences matches {0..*} matches {    -- Om us av rom og eiendeler
		items cardinality matches {0..*; unordered} matches {
			CLUSTER[at0012] occurrences matches {0..1} matches {    -- Vedtakstype
				items cardinality matches {1..*; unordered} matches {
					allow_archetype CLUSTER[at0013] occurrences matches {0..*} matches {    -- Vedtakstype
						include
							archetype_id/value matches {/openEHR-EHR-CLUSTER\.vedtakstype(-[a-zA-Z0-9_]+)*\.v1/}
					}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- Undersøkelse av pasientens rom og eiendeler.
				value matches {
					DV_BOOLEAN matches {*}
				}
			}
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- Kroppsvisitasjon av pasienten.
				value matches {
					DV_BOOLEAN matches {*}
				}
			}
			ELEMENT[at0004] occurrences matches {0..1} matches {    -- Begrunnelse for vedtaket er gitt i journalnotat av dato
				value matches {
					DV_DATE_TIME matches {
						value matches {yyyy-mm-ddTHH:MM:SS}
					}
				}
			}
			ELEMENT[at0005] occurrences matches {0..1} matches {    -- Begrunnet mistanke om at medikamenter vil bli forsøkt innført.
				value matches {
					DV_BOOLEAN matches {*}
				}
			}
			ELEMENT[at0006] occurrences matches {0..1} matches {    -- Begrunnet mistanke om at rusmidler vil bli forsøkt innført.
				value matches {
					DV_BOOLEAN matches {*}
				}
			}
			ELEMENT[at0007] occurrences matches {0..1} matches {    -- Begrunnet mistanke om at rømningshjelpemiddel vil bli forsøkt innført.
				value matches {
					DV_BOOLEAN matches {*}
				}
			}
			ELEMENT[at0008] occurrences matches {0..1} matches {    -- Begrunnet mistanke om at farlig gjenstand vil bli forsøkt innført.
				value matches {
					DV_BOOLEAN matches {*}
				}
			}
			CLUSTER[at0014] occurrences matches {0..1} matches {    -- Varighet
				items cardinality matches {1..*; unordered} matches {
					ELEMENT[at0015] occurrences matches {0..1} matches {    -- Vedtaksstart
						value matches {
							DV_DATE_TIME matches {*}
						}
					}
					ELEMENT[at0011] occurrences matches {0..1} matches {    -- Utløpstidspunkt
						value matches {
							DV_DATE_TIME matches {
								value matches {yyyy-mm-ddTHH:MM:SS}
							}
						}
					}
				}
			}
			allow_archetype CLUSTER[at0009] occurrences matches {0..1} matches {    -- Faglig ansvarlig
				include
					archetype_id/value matches {/openEHR-EHR-CLUSTER\.faglig_ansvarlig(-[a-zA-Z0-9_]+)*\.v1/}
			}
			allow_archetype CLUSTER[at0010] occurrences matches {0..1} matches {    -- Informasjon om vedtaket
				include
					archetype_id/value matches {/openEHR-EHR-CLUSTER\.uttalerett_og_klageadgang(-[a-zA-Z0-9_]+)*\.v1/}
			}
		}
	}

