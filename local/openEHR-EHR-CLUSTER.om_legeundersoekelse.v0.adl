definition
	CLUSTER[at0000] matches {    -- Om legeundersøkelse
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Navn på Lege
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[ac0001]
						}
					}
				}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- Stilling
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- Lokalisasjon
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0004] occurrences matches {0..1} matches {    -- Tid og sted
				value matches {
					DV_DATE_TIME matches {*}
				}
			}
		}
	}

