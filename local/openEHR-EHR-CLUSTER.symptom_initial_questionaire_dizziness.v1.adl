definition
	CLUSTER[at0000] matches {    -- Symptom questionaire dizziness
		items cardinality matches {1..*; unordered} matches {
			CLUSTER[at0152] occurrences matches {0..1} matches {    -- Deflecting symptoms
				items cardinality matches {1..*; unordered} matches {
					ELEMENT[at0153] occurrences matches {0..*} matches {    -- Loss of consciousness?
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0172,    -- Yes (If so: Loss of consciousness should be investigated as primary symptom)
									at0175]    -- No
								}
							}
						}
					}
					ELEMENT[at0156] occurrences matches {0..1} matches {    -- Paralysis or speech problems?
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0173,    -- Yes (If so; paralysis or speec problems should be considered as primary symptom)
									at0176]    -- No
								}
							}
						}
					}
					ELEMENT[at0157] occurrences matches {0..1} matches {    -- Recent head trauma?
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0174,    -- Yes (If so: Recent head trauma should be investigated as primary symptom)
									at0177]    -- No
								}
							}
						}
					}
				}
			}
			ELEMENT[at0021] occurrences matches {0..1} matches {    -- Impact
				value matches {
					1|[local::at0044],
					2|[local::at0023],
					5|[local::at0024],
					8|[local::at0025],
					9|[local::at0045]
				}
			}
			ELEMENT[at0037] occurrences matches {0..1} matches {    -- Progression
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0039,    -- Decreasing
							at0040,    -- Stable
							at0041]    -- Increasing
						}
					}
				}
			}
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- Variation
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0004,    -- Constant
							at0005,    -- Intermittent
							at0006]    -- Fluctuating
						}
					}
				}
			}
			CLUSTER[at0154] occurrences matches {0..1} matches {    -- Characteristics
				items cardinality matches {1..*; unordered} matches {
					ELEMENT[at0032] occurrences matches {0..1} matches {    -- Seizures/fits/attacks?
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0162,    -- Yes
									at0163]    -- No
								}
							}
						}
					}
					ELEMENT[at0158] occurrences matches {0..1} matches {    -- Rotational feeling?
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0164,    -- Yes
									at0165]    -- No
								}
							}
						}
					}
					ELEMENT[at0159] occurrences matches {0..1} matches {    -- Unstability, boatdeck sensation?
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0166,    -- Yes
									at0167]    -- No
								}
							}
						}
					}
					ELEMENT[at0160] occurrences matches {0..1} matches {    -- Tendency to faint?
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0168,    -- Yes
									at0169]    -- No
								}
							}
						}
					}
					ELEMENT[at0161] occurrences matches {0..1} matches {    -- Falling?
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0170,    -- Yes
									at0171]    -- No
								}
							}
						}
					}
				}
			}
		}
	}

ontology
	terminologies_available = <"SNOMED-CT", ...>
	term_definitions = <
		["ar-sy"] = <
			items = <
				["at0000"] = <
					text = <"*Symptom(en)">
					description = <"*A subjective observation by an individual about departure from normal function and which may indicate the presence of disease or abnormality. Either self-recorded or recorded on the behalf of a patient by a clinician.(en)">
				>
				["at0003"] = <
					text = <"التنوع">
					description = <"تنوع العرض">
				>
				["at0004"] = <
					text = <"ثابت">
					description = <"العرض موجود بشكل ثابت/مستمر">
				>
				["at0005"] = <
