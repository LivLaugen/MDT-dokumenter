					text = <"*Impact(en)">
					description = <"*The severity of the symptom in its impact on daily living.(en)">
				>
				["at0023"] = <
					text = <"متوسط">
					description = <"العرض لا يتداخل بشكل كبير مع الأنشطة اليومية">
				>
				["at0024"] = <
