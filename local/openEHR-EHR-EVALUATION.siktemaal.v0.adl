definition
	EVALUATION[at0000] matches {    -- Siktemål
		data matches {
			ITEM_TREE[at0001] matches {    -- Tree
				items cardinality matches {1..*; unordered} matches {
					ELEMENT[at0002] matches {    -- Siktemål for behandlingen
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0003,    -- Kurativ
									at0004,    -- Paliativ
									at0005]    -- Ukjent
								}
							}
						}
					}
				}
			}
		}
	}

