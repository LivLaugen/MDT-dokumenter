definition
	EVALUATION[at0000] matches {    -- Anamnese olafia
		data matches {
			ITEM_TREE[at0001] matches {    -- Tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..1} matches {    -- Kjønn
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0004] occurrences matches {0..1} matches {    -- Språk
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0003] occurrences matches {0..*} matches {    -- Plager
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0012] occurrences matches {0..1} matches {    -- Beskrivelse til plager
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0005] occurrences matches {0..1} matches {    -- Seksuell preferanse
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0006,    -- MSK
									at0008,    -- KSM
									at0009,    -- KSK
									at0007,    -- MSM
									at0011,    -- MSMK
									at0010]    -- KSKM
								}
							}
						}
					}
					ELEMENT[at0013] occurrences matches {0..*} matches {    -- Nasjonalitet
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0014] occurrences matches {0..1} matches {    -- Mors fødeland
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0015] occurrences matches {0..1} matches {    -- Fars fødeland
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0016] occurrences matches {0..*} matches {    -- Prevensjonsmiddel
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0017] occurrences matches {0..1} matches {    -- Utfyllende opplysninger
						value matches {
							DV_TEXT matches {*}
						}
					}
				}
			}
		}
	}

