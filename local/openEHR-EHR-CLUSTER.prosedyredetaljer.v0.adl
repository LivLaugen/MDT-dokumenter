	>
	lifecycle_state = <"in_development">
	details = <
		["nb"] = <
			language = <[ISO_639-1::nb]>
			purpose = <"Benyttes til å beskrive detaljert innhold i en gjennomført prosedyre. Ved for eksempel en ERCP-prosedyre (endoskopisk tilgang til galle og bukspyttkjertel gjennom spiserøret) kan det bli gjennomført flere del-prosedyrer som må detaljeres og i mange tilfeller rapporteres. 

Arketypen gir rom for å koble flere prosedyrer (og prosedyrekoder) til en action-prosedyre der det er hensiktsmessig at prosedyren kun fremstår som én activity.

">
			keywords = <"Procedure", ...>
			copyright = <"© Nasjonal IKT HF">
			use = <"Brukes sammen med ACTION.procedure">
			misuse = <"All annen bruk">
		>
	>
