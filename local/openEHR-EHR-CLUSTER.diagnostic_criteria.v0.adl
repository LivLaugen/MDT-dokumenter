archetype (adl_version=1.4; uid=cc7b15fb-b705-4a8e-b063-d6cb55b94f61)
	openEHR-EHR-CLUSTER.diagnostic_criteria.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::nb]>
	translations = <
		["en-gb"] = <
			language = <[ISO_639-1::en-gb]>
			author = <
				["name"] = <"Sabine Leh">
