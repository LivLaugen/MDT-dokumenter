definition
	ITEM_TREE[at0000] occurrences matches {0..*} matches {    -- Om mottaker av informasjon
		items cardinality matches {0..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Typen vedtak klagen gjelder
				value matches {
					0|[local::at0002],
					1|[local::at0003],
					2|[local::at0004],
					3|[local::at0005],
					4|[local::at0006],
					5|[local::at0007],
					6|[local::at0008],
					7|[local::at0009],
					8|[local::at0010],
					9|[local::at0011],
					10|[local::at0012],
					11|[local::at0013],
					12|[local::at0014],
					13|[local::at0015],
					14|[local::at0016],
					15|[local::at0017],
					16|[local::at0018],
					17|[local::at0019],
					18|[local::at0020],
					19|[local::at0021],
					20|[local::at0022],
					21|[local::at0023],
					22|[local::at0024],
					23|[local::at0025],
					24|[local::at0026],
					25|[local::at0027]
				}
			}
			ELEMENT[at0044] occurrences matches {0..1} matches {    -- Form på informasjon som ble gitt
				value matches {
					0|[local::at0045],
					1|[local::at0046],
					2|[local::at0047],
					3|[local::at0048],
					4|[local::at0049]
				}
			}
			ELEMENT[at0050] occurrences matches {0..1} matches {    -- Mottaker av informasjonen
				value matches {
					0|[local::at0051],
					1|[local::at0052],
					2|[local::at0053],
					3|[local::at0054]
				}
			}
			ELEMENT[at0055] occurrences matches {0..1} matches {    -- Navn og/eller rolle ved bruk av andre informasjonsmottakere
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0028] occurrences matches {0..1} matches {    -- Tidspunkt informasjonen ble gitt eller sendt
				value matches {
					DV_DATE_TIME matches {
						value matches {yyyy-mm-ddTHH:MM:SS}
					}
				}
			}
			ELEMENT[at0057] occurrences matches {0..1} matches {    -- Merknad
				value matches {
					DV_TEXT matches {*}
				}
			}
		}
	}

