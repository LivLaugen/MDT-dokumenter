definition
	OBSERVATION[at0000] matches {    -- Livets siste dager
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									CLUSTER[at0004] occurrences matches {0..1} matches {    -- Kriterier for å bruke denne planen for lindring til døende:
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at0005] occurrences matches {0..1} matches {    -- 1. Alle mulige reversible årsaker til pasientens tilstand er vurdert.
												value matches {
													DV_BOOLEAN matches {*}
												}
											}
											ELEMENT[at0006] occurrences matches {0..1} matches {    -- 2. Behandlingsteamet, minimum lege og sykepleier, er enige om at pasienten er døende.
												value matches {
													DV_BOOLEAN matches {*}
												}
											}
											CLUSTER[at0007] occurrences matches {0..1} matches {    -- I tillegg vil minst to av følgende punkter vanligvis være oppfylt
												items cardinality matches {1..*; unordered} matches {
													ELEMENT[at0008] occurrences matches {0..1} matches {    -- Pasienten er sengeliggende
														value matches {
															DV_BOOLEAN matches {*}
														}
													}
													ELEMENT[at0009] occurrences matches {0..1} matches {    -- Pasienten er i lengre perioder ikke kontaktbar
														value matches {
															DV_BOOLEAN matches {*}
														}
													}
													ELEMENT[at0010] occurrences matches {0..1} matches {    -- Pasienten klarer bare å drikke små slurker
														value matches {
															DV_BOOLEAN matches {*}
														}
													}
													ELEMENT[at0011] occurrences matches {0..1} matches {    -- Pasienten kan ikke lenger svelge tabletter
														value matches {
															DV_BOOLEAN matches {*}
														}
													}
												}
											}
										}
									}
									CLUSTER[at0012] occurrences matches {0..1} matches {    -- DEL 1 Første vurdering (vurdering ved inklusjon)
										items cardinality matches {1..*; unordered} matches {
