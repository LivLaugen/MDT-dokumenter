ontology
	term_definitions = <
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"Livets siste dager">
					description = <"Plan for lindring i livets sluttfase, til bruk i sykehus">
				>
				["at0001"] = <
					text = <"History">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Any event">
					description = <"">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"Kriterier for å bruke denne planen for lindring til døende:">
					description = <"">
				>
				["at0005"] = <
					text = <"1. Alle mulige reversible årsaker til pasientens tilstand er vurdert.">
					description = <"">
				>
				["at0006"] = <
					text = <"2. Behandlingsteamet, minimum lege og sykepleier, er enige om at pasienten er døende.">
					description = <"">
				>
				["at0007"] = <
					text = <"I tillegg vil minst to av følgende punkter vanligvis være oppfylt">
					description = <"">
