definition
	COMPOSITION[at0000] matches {    -- Micro lab composition
		category matches {
			DV_CODED_TEXT matches {
				defining_code matches {
					[openehr::433]
				}
			}
		}
		content cardinality matches {1..*; unordered} matches {
			allow_archetype OBSERVATION[at0001] occurrences matches {0..*} matches {    -- micro_lab_test
				include
					archetype_id/value matches {/openEHR-EHR-OBSERVATION\.micro_lab_test.v1/}
			}
		}
	}

