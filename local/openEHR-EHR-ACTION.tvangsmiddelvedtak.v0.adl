definition
	ACTION[at0000] matches {    -- Tvangsmiddelvedtak
		ism_transition matches {
			ISM_TRANSITION[at0002] matches {    -- Aktivt
				current_state matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[openehr::245]
						}
					}
				}
				careflow_step matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::at0002]    -- Aktivt
						}
					}
				}
			}
			ISM_TRANSITION[at0004] matches {    -- Hastevedtak aktivt
				current_state matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[openehr::245]
						}
					}
				}
				careflow_step matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::at0004]    -- Hastevedtak aktivt
						}
					}
				}
			}
			ISM_TRANSITION[at0003] matches {    -- Opphørt
				current_state matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[openehr::532]
						}
					}
				}
				careflow_step matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::at0003]    -- Opphørt
						}
					}
				}
			}
		}
		description matches {
			allow_archetype ITEM_TREE matches {
				include
					archetype_id/value matches {/openEHR-EHR-ITEM_TREE\.om_tvangsmiddelvedtak(-[a-zA-Z0-9_]+)*\.v1/}
				exclude
					archetype_id/value matches {/.*/}
			}
		}
	}

