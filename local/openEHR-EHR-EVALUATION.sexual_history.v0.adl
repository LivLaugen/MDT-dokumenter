definition
	EVALUATION[at0000] matches {    -- Sexual history
		data matches {
			ITEM_TREE[at0001] matches {    -- Tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..1} matches {    -- Ever had sex?
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0009,    -- Yes
									at0010,    -- No
									at0011]    -- Not sure
								}
							}
						}
					}
					ELEMENT[at0003] occurrences matches {0..1} matches {    -- Age of sexual debut
						value matches {
							C_DV_QUANTITY <
								property = <[openehr::128]>
								list = <
									["1"] = <
										units = <"a">
										precision = <|0|>
									>
								>
							>
						}
					}
					ELEMENT[at0004] occurrences matches {0..*} matches {    -- Genders had sex with
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0012] occurrences matches {0..1} matches {    -- Description to partner gender
						value matches {
							DV_TEXT matches {*}
						}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"Seksuell historie">
					description = <"Persistente opplysninger om et individs seksualhistorie.">
				>
				["at0001"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Noen gang hatt sex?">
					description = <"Markering om pasienten har debutert seksuelt.">
				>
				["at0003"] = <
					text = <"Alder ved seksuell debut">
					description = <"Alder ved seksuell debut.">
				>
				["at0004"] = <
					text = <"Kjønn pasienten har hatt sex med">
					description = <"Benevnelse av hvilke kjønn pasienten har hatt sex med historisk.">
				>
				["at0009"] = <
					text = <"Ja">
					description = <"Ja">
				>
				["at0010"] = <
					text = <"Nei">
					description = <"Nei">
				>
				["at0011"] = <
					text = <"Usikker">
					description = <"Usikker">
				>
				["at0012"] = <
					text = <"Beskrivelse til kjønn pas har hatt sex med">
					description = <"Fritekstlig beskrivelse av partners kjønn, dersom nødvendig.">
				>
			>
		>
		["en"] = <
			items = <
				["at0000"] = <
					text = <"Sexual history">
					description = <"Persistent information of the sexual history of an individual.">
				>
