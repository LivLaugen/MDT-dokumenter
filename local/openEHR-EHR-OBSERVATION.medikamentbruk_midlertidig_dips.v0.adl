		["revision"] = <"0.0.1-alpha">
	>

definition
	OBSERVATION[at0000] matches {    -- Medikamentbruk midlertidig
		data matches {
			HISTORY[at0001] matches {    -- Event Series
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..1} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									allow_archetype CLUSTER[at0004] occurrences matches {0..*} matches {    -- Medikamentbruk
										include
											archetype_id/value matches {/openEHR-EHR-CLUSTER\.health_factor_generic\.v1/}
									}
									ELEMENT[at0005] occurrences matches {0..1} matches {    -- Generell medikasjon
										value matches {
											DV_TEXT matches {*}
										}
									}
									ELEMENT[at0006] occurrences matches {0..1} matches {    -- Topikal medikasjon OD
										value matches {
											DV_TEXT matches {*}
										}
									}
									ELEMENT[at0007] occurrences matches {0..1} matches {    -- Topikal medikasjon OS
										value matches {
											DV_TEXT matches {*}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

ontology
	term_definitions = <
		["nb"] = <
			items = <
				["at0000"] = <
					text = <"Medikamentbruk midlertidig">
					description = <"Dokumenterte medikamentbruk i påvente av en arketypebasert løsning på LIB.">
				>
				["at0001"] = <
					text = <"Event Series">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Any event">
					description = <"*">
				>
				["at0003"] = <
					text = <"Tree">
					description = <"@ internal @">
				>
				["at0004"] = <
					text = <"Medikamentbruk">
					description = <"Detaljer vedrørende medikamentbruk.">
				>
				["at0005"] = <
					text = <"Generell medikasjon">
					description = <"Fritekst-versjon av faste medikamenter. Benyttes frem til strukturert løsning foreligger.">
				>
				["at0006"] = <
					text = <"Topikal medikasjon OD">
					description = <"Fritekst-versjon av øyedråper hø. øye. Benyttes frem til strukturert løsning foreligger.">
				>
				["at0007"] = <
					text = <"Topikal medikasjon OS">
					description = <"Fritekst-versjon av øyedråper ve. øye. Benyttes frem til strukturert løsning foreligger.">
				>
			>
		>
	>
