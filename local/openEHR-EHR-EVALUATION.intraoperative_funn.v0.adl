definition
	EVALUATION[at0000] matches {    -- Intraoperative funn
		data matches {
			ITEM_TREE[at0001] matches {    -- Tree
				items cardinality matches {1..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..1} matches {    -- Levermetaser
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0003,    -- Ja
									at0004,    -- Nei
									at0005]    -- Mistenkt
								}
							}
						}
					}
					ELEMENT[at0007] occurrences matches {0..1} matches {    -- Peritoneal metastase/carcinomatose
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0036,    -- Ja
									at0009,    -- Nei
									at0010]    -- Mistenkt
								}
							}
						}
					}
					ELEMENT[at0012] occurrences matches {0..1} matches {    -- Lymfeknutemetastaser utenfor reseksjonsområde
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0013,    -- Ja
									at0014,    -- Nei
									at0015]    -- Mistenkt
								}
							}
						}
					}
					ELEMENT[at0017] occurrences matches {0..1} matches {    -- Innvekst i naboorgan
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0018,    -- Ja
									at0019,    -- Nei
									at0020]    -- Mistenkt
								}
							}
						}
					}
					ELEMENT[at0022] occurrences matches {0..1} matches {    -- Spesifiser innvekst
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0023] occurrences matches {0..1} matches {    -- Perforasjon under operasjon
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0024,    -- Ja
									at0025]    -- Nei
								}
							}
						}
					}
					ELEMENT[at0026] occurrences matches {0..1} matches {    -- Perforasjon tarm
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0027,    -- Ja
									at0028]    -- Nei
								}
							}
						}
					}
					ELEMENT[at0029] occurrences matches {0..1} matches {    -- Perforasjon tumor
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0030,    -- Ja
									at0031]    -- Nei
								}
							}
						}
					}
					ELEMENT[at0032] occurrences matches {0..1} matches {    -- Resttumor
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0033,    -- Ja
									at0034,    -- Nei
									at0035]    -- Usikker
								}
							}
						}
					}
				}
			}
		}
	}

