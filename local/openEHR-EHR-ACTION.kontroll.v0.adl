definition
	ACTION[at0000] matches {    -- Kontroll
		description matches {
			ITEM_TREE[at0001] matches {    -- Tree
				items cardinality matches {0..*; unordered} matches {
					allow_archetype CLUSTER[at0002] occurrences matches {0..*} matches {    -- Samtale
						include
							archetype_id/value matches {/.*/}
					}
				}
			}
		}
	}

