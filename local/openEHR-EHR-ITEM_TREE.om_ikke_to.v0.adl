definition
	ITEM_TREE[at0000] occurrences matches {0..*} matches {    -- Vedtak ikke tph
		items cardinality matches {0..*; unordered} matches {
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- Pasientens ankomst til institusjonen
				value matches {
					DV_DATE matches {*}
				}
			}
			allow_archetype CLUSTER[at0005] occurrences matches {0..*} matches {    -- Faglig ansvalig
				include
					archetype_id/value matches {/openEHR-EHR-CLUSTER\.faglig_ansvarlig(-[a-zA-Z0-9_]+)*\.v1/}
			}
			ELEMENT[at0006] occurrences matches {0..1} matches {    -- Pasienten er gitt anledning til å uttale seg.
				value matches {
					DV_BOOLEAN matches {*}
				}
			}
			ELEMENT[at0007] occurrences matches {0..1} matches {    -- Nærmeste pårørende er gitt anledning til å uttale seg, jf. psykisk helsevernloven paragraf 3-9
				value matches {
					DV_BOOLEAN matches {*}
				}
			}
			ELEMENT[at0008] occurrences matches {0..1} matches {    -- Den som har fremsatt begjæring om tvungent psykisk helsevern er gitt anledning til å uttale seg
				value matches {
					DV_BOOLEAN matches {*}
				}
			}
			ELEMENT[at0009] occurrences matches {0..1} matches {    -- Den som har fremsatt begjæring om tvungent psykisk helsevern er informert om vedtaket og om sin klageadgang.
				value matches {
					DV_BOOLEAN matches {*}
				}
			}
		}
	}

