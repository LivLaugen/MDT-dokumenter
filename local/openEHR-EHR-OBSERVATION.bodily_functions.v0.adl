archetype (adl_version=1.4; uid=3407e01f-b663-4038-8605-55916e75316f)
	openEHR-EHR-OBSERVATION.bodily_functions.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::en]>
	translations = <
		["nb"] = <
			language = <[ISO_639-1::nb]>
			author = <
