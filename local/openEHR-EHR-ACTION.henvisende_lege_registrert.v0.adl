definition
	ACTION[at0000] matches {    -- Henvisende lege registrert
		ism_transition matches {
			ISM_TRANSITION[at0002] matches {    -- Henvisende lege regisrert
				current_state matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[openehr::532]
						}
					}
				}
				careflow_step matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::at0002]    -- Henvisende lege regisrert
						}
					}
				}
			}
		}
		description matches {
			ITEM_TREE[at0003] matches {    -- Tree
				items cardinality matches {1..1; unordered} matches {
					ELEMENT[at0005] occurrences matches {0..1} matches {    -- Navn
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[ac0001]
								}
							}
						}
					}
				}
			}
		}
	}

