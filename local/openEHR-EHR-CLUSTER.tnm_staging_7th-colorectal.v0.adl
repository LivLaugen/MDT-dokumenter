	details = <
		["nb"] = <
			language = <[ISO_639-1::nb]>
			purpose = <"For å registrere klassifikasjon og gradering av tykk- og endetarmskreft ved å benytte TNM-klassifikasjon 7. utgave.">
			keywords = <"tumor","TNM","malignitet","kreft","klassifisering","klassifikasjon","grad","gradering","stadium","lymfeknute","metastase","spredning","tykktarm","endetarm","colorektal","colon","kolon","rektum","rectum","colorectal","kolorectal","kolorektal">
			misuse = <"Brukes kun for TNM 7.utgave for klassifisering av tykk- og endetarmskreft.">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record the classification and grading of colorectal cancer using the TNM classification 7th Edition.">
			keywords = <"tumour","TNM","malignancy","cancer","staging","classification","grade","grading","stage","lymph node","metastasis","colorectal">
