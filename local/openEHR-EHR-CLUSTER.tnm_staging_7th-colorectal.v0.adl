				>
				["at0.53"] = <
					text = <"T0">
					description = <"Primærtumor ikke påvist.">
				>
				["at0.54"] = <
					text = <"Tis">
					description = <"Carcinoma in situ: Intraepitelial eller infiltrerer lamina propria.">
				>
				["at0.55"] = <
					text = <"T1">
					description = <"Tumor infiltrerer submucosa.">
				>
				["at0.56"] = <
					text = <"T2">
					description = <"Tumor infiltrerer muscularis propria.">
				>
				["at0.57"] = <
					text = <"T3">
					description = <"Tumor infiltrerer gjennom muscularis propria og inn i perikolisk vev.">
				>
				["at0.58"] = <
					text = <"T4a">
					description = <"Tumor perforerer til overflaten av viscerale peritoneum.">
				>
				["at0.59"] = <
					text = <"T4b">
					description = <"Tumor infiltrerer direkte eller nærliggende til andre organer eller strukturer.">
				>
				["at0.60"] = <
