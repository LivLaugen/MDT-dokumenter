definition
	OBSERVATION[at0000] matches {    -- Lok primaertumor
		data matches {
			HISTORY[at0001] matches {    -- Event Series
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..1} matches {    -- Any event
						data matches {
							ITEM_TREE[at0003] matches {    -- Tree
								items cardinality matches {0..*; unordered} matches {
									CLUSTER[at0004] occurrences matches {0..1} matches {    -- Lokalisasjon primærtumor
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at0006] matches {    -- ICD-10 kode
												value matches {
													DV_TEXT matches {*}
												}
											}
										}
									}
									CLUSTER[at0005] occurrences matches {0..1} matches {    -- Sideangivelse
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at0007] occurrences matches {0..1} matches {    -- Side
												value matches {
													DV_CODED_TEXT matches {
														defining_code matches {
															[local::
															at0013,    -- Høyre
															at0014,    -- Venstre
															at0015,    -- Begge
															at0016,    -- Senter
															at0017]    -- Ikke relevant
														}
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

