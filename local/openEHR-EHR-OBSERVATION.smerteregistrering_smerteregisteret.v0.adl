definition
	OBSERVATION[at0000] matches {    -- Smerteregistrering smerteregisteret
		data matches {
			HISTORY[at0001] matches {    -- History
				events cardinality matches {0..*; unordered} matches {
					INTERVAL_EVENT[at0002] matches {    -- Uspesifisert intervallhendelse
						data matches {
							ITEM_TREE[at0003] matches {    -- 0
								items cardinality matches {0..*; unordered} matches {
									ELEMENT[at0008] occurrences matches {0..1} matches {    -- Kan angi smerteintensitet?
										value matches {
											0|[local::at0013],
											1|[local::at0014],
											2|[local::at0015]
										}
									}
									ELEMENT[at0007] occurrences matches {0..1} matches {    -- Antall smerteregistreringer
										value matches {
											DV_COUNT matches {
												magnitude matches {|>=0|}
											}
										}
									}
									allow_archetype CLUSTER[at0009] occurrences matches {0..*} matches {    -- Smerteregistrering
										include
											archetype_id/value matches {/openEHR-EHR-CLUSTER\.symptom_sign\.v1/}
									}
								}
							}
						}
					}
				}
			}
		}
	}

