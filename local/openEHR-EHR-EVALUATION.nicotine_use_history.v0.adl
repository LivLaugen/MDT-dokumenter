archetype (adl_version=1.4; uid=c662518c-beb0-4dd8-95e8-9347448f9b63)
	openEHR-EHR-EVALUATION.nicotine_use_history.v0

concept
	[at0000]

language
	original_language = <[ISO_639-1::nb]>

description
	original_author = <
		["date"] = <"2015-05-20">
		["name"] = <"Lars Morgan Karlsen">
		["organisation"] = <"DIPS ASA">
		["email"] = <"lmk@dips.no">
	>
	lifecycle_state = <"in_development">
	other_contributors = <"Pål Thorberg","Siv Marie Lien">
	details = <
		["nb"] = <
			language = <[ISO_639-1::nb]>
			purpose = <"To register the use of nicotine">
			keywords = <"nicotine","tobacco">
			copyright = <"© Nasjonal IKT HF">
			use = <"To enter the history and current use of nicotine">
			misuse = <"to enter smoking of other substances not for the sole or added effect of nicotine.">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
		["custodian_organisation"] = <"Nasjonal IKT">
		["original_namespace"] = <"no.nasjonalikt">
		["original_publisher"] = <"Nasjonal IKT">
		["custodian_namespace"] = <"no.nasjonalikt">
		["MD5-CAM-1.0.1"] = <"467C0C42FCC7CA4B5F7585096F88D688">
		["build_uid"] = <"c44e801c-5ad5-4459-9cd1-4bec8bc44b0b">
		["revision"] = <"0.0.1-alpha">
	>

definition
	EVALUATION[at0000] matches {    -- Nicotine use history
		data matches {
			ITEM_TREE[at0001] matches {    -- Tree
				items cardinality matches {0..*; unordered} matches {
					ELEMENT[at0002] occurrences matches {0..1} matches {    -- Status
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0003,    -- Active user
									at0004,    -- Former user
									at0005]    -- Never used
								}
							}
						}
					}
					ELEMENT[at0026] occurrences matches {0..1} matches {    -- Duration of current status
						value matches {
							DV_DURATION matches {
								value matches {PYM/|>=P0Y|}
							}
						}
					}
					ELEMENT[at0007] occurrences matches {0..1} matches {    -- Pack year
						value matches {
							DV_COUNT matches {
								magnitude matches {|>=0|}
							}
						}
					}
					CLUSTER[at0008] occurrences matches {0..*} matches {    -- Usage interval
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0009] matches {    -- Started using (approximate)
								value matches {
									DV_DATE matches {
										value matches {yyyy-??-XX}
									}
								}
							}
							ELEMENT[at0010] occurrences matches {0..1} matches {    -- Ceased using (approximate)
								value matches {
									DV_DATE matches {
										value matches {yyyy-??-XX}
									}
								}
							}
							allow_archetype CLUSTER[at0043] occurrences matches {0..*} matches {    -- Details of substance
								include
									archetype_id/value matches {/openEHR-EHR-CLUSTER\.nicotine_details(-[a-zA-Z0-9_]+)*\.v1/}
							}
							ELEMENT[at0019] occurrences matches {0..1} matches {    -- Pattern
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0020,    -- Frequent - every day
											at0024,    -- Frequent - less than once every day but at least every week
											at0021,    -- Frequent - every weekend (party smoking)
											at0022,    -- Not frequent - less than once a week
											at0023]    -- Not frequent - less than once a month
										}
									}
								}
							}
							ELEMENT[at0012] occurrences matches {0..1} matches {    -- Form
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0027,    -- Cigar
											at0028,    -- Cigarillo
											at0029,    -- Cigarett
											at0030,    -- Vaporizer
											at0031,    -- Chewing gum
											at0032,    -- Portion bag snuff
											at0033,    -- Snuff
											at0034,    -- Pipe
											at0035]    -- Patch
										}
									}
								}
							}
							ELEMENT[at0025] occurrences matches {0..1} matches {    -- Unit
								value matches {
									DV_CODED_TEXT matches {
										defining_code matches {
											[local::
											at0036,    -- Single item
											at0037,    -- 10 pack
											at0038,    -- 20 pack
											at0039,    -- Pouch
											at0040,    -- ml vapour fluid
											at0041,    -- box of portion
											at0042]    -- Hamster diaper
										}
									}
								}
							}
							ELEMENT[at0014] occurrences matches {0..1} matches {    -- Frequency units pr time
								value matches {
									C_DV_QUANTITY <
										property = <[openehr::128]>
										list = <
											["1"] = <
												units = <"a">
											>
											["2"] = <
												units = <"wk">
											>
											["3"] = <
												units = <"d">
												magnitude = <|>=0.0|>
												precision = <|0|>
											>
										>
									>
								}
							}
						}
					}
				}
			}
		}
	}

