definition
	ELEMENT[at0000] matches {    -- Kroppsdel
		value matches {
			DV_CODED_TEXT matches {
				defining_code matches {
					[local::
					at0001,    -- Øyne
					at0002,    -- Nese
					at0003,    -- Munn
					at0004,    -- Hals
					at0005,    -- Ører
					at0006,    -- Nakke
					at0007,    -- Thorax
					at0008,    -- Cor
					at0009,    -- Pulm
					at0010,    -- Abdomen
					at0011,    -- Genitalia externa
					at0012,    -- Genitalia interna
					at0013,    -- Høyre hånd
					at0014,    -- Høyre underarm
					at0015,    -- Høyre overarm
					at0016,    -- Høyre skulder
					at0017,    -- Venstre hånd
					at0018,    -- Venstre underarm
					at0019,    -- Venstre overarm
					at0020,    -- Venstre skulder
					at0021,    -- Høyre fot
					at0022,    -- Høyre legg
					at0024,    -- Høyre kne
					at0023,    -- Høyre lår
					at0025,    -- Underekstremiteter
					at0026,    -- Overekstremiteter
					at0027,    -- Rektal eksplorasjon
					at0028,    -- Columna
					at0029]    -- Nervesystemet
				}
			}
		}
	}

