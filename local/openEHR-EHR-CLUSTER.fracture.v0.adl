definition
	CLUSTER[at0000] matches {    -- Fracture
		items cardinality matches {1..*; unordered} matches {
			allow_archetype ELEMENT[at0001] occurrences matches {0..*} matches {    -- *Bruddklassifisering(nb)
				include
					archetype_id/value matches {/.*/}
			}
			ELEMENT[at0002] occurrences matches {0..1} matches {    -- *Åpent brudd(nb)
				value matches {
					DV_BOOLEAN matches {*}
				}
			}
			allow_archetype ELEMENT[at0003] occurrences matches {0..*} matches {    -- *Klassifisering av åpent brudd(nb)
				include
					archetype_id/value matches {/.*/}
			}
			ELEMENT[at0004] occurrences matches {0..1} matches {    -- *Morfologisk inndeling(nb)
				value matches {
					DV_TEXT matches {*}
				}
			}
		}
	}

