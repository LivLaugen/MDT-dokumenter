	details = <
		["nb"] = <
			language = <[ISO_639-1::nb]>
			purpose = <"Å beskrive en skade på en knokkel med eller uten avbrudd av knokkelen.">
			keywords = <"Brudd","Fraktur","Bøyningsfraktur","Fracture","Bucklefracture","Buckle fraktur","Greenstick brudd","Green stick fracture","Tilstand">
			copyright = <"© *© Nasjonal IKT HF(nb), Nasjonal IKT HF">
			use = <"Tillater registrering av en tilstand med skade på kontinuitet av knokkel.

Hos voksne er brudd definert til å være gjennomgående bruddlinje gjennom knokkelen. 

Hos barn er brudd definert til å ikke nødvendigvis være gjennomgående. Det kan være bøyningsbrudd, greenstick brudd, torus/buckle brudd.

">
			misuse = <"Hos voksne er ikke gjennomgående brudd i en knokkel ikke brudd, ofte kalt fissur.">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"For describing an injury to a bone, with or without disjoining of the bone.">
			keywords = <"*Brudd(nb)","*Fraktur(nb)","*Bøyningsfraktur(nb)","*Fracture(nb)","*Bucklefracture(nb)","*Buckle fraktur(nb)","*Greenstick brudd(nb)","*Green stick fracture(nb)","*Tilstand(nb)">
			copyright = <"© *© Nasjonal IKT HF(nb), Nasjonal IKT HF">
			use = <"*Tillater registrering av en tilstand med skade på kontinuitet av knokkel.

Hos voksne er brudd definert til å være gjennomgående bruddlinje gjennom knokkelen. 

Hos barn er brudd definert til å ikke nødvendigvis være gjennomgående. Det kan være bøyningsbrudd, greenstick brudd, torus/buckle brudd.

(nb)">
			misuse = <"*Hos voksne er ikke gjennomgående brudd i en knokkel ikke brudd, ofte kalt fissur.(nb)">
		>
	>
